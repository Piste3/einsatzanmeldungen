# Kopieren nach .env und anpassen. Wird von «npm start» automatisch geladen.
NODE_ENV=production
PORT=3000
BASE_URL=https://einsatz.kkb.ch
DATA_DIR=./data
TRUST_PROXY=1

# Anmeldung: local, microsoft oder beide (local,microsoft)
AUTH_PROVIDERS=local
# Microsoft-Anmeldung (siehe README): Tenant-ID oder «organizations» (App für beliebige Organisationen)
# MS_TENANT_ID=organizations
# MS_CLIENT_ID=
# MS_CLIENT_SECRET=
# Optional: nur Konten aus diesen Tenants (kommagetrennt)
# MS_ALLOWED_TENANTS=
# Ablaufdatum des geheimen Schlüssels (JJJJ-MM-TT), Admins werden 30 Tage vorher erinnert
# MS_SECRET_EXPIRES=

# Wer das Anmeldeformular einbetten darf (Adressen der Webseiten mit dem iFrame,
# mit Leerzeichen getrennt). Hat die ClubDesk-Seite eine eigene Domain, diese ergänzen.
FORM_FRAME_ANCESTORS=https://*.clubdesk.com https://web.kkb.ch https://*.web.kkb.ch http://web.kkb.ch http://*.web.kkb.ch

# E-Mail-Versand (Anmeldebestätigungen). Ohne SMTP_HOST bleiben Mails im Postausgang.
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=
# SMTP_PASS=
# SMTP_FROM=KKB Aufgebot <aufgebot@kkb.ch>

# Tägliche Sicherung (Standard: DATA_DIR/backups, 30 Tage)
# BACKUP_DIR=
# BACKUP_KEEP_DAYS=30
