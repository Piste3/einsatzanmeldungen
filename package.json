{
  "name": "kkb-einsatzplaner",
  "version": "0.1.0",
  "private": true,
  "description": "KKB-Einsatzplaner: Einsätze, Anmeldungen, Nachfassen, Schichten und Aufgebot für das Kadetten-Korps Basel",
  "main": "src/server.js",
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "start": "node --disable-warning=ExperimentalWarning --env-file-if-exists=.env src/server.js",
    "dev": "node --disable-warning=ExperimentalWarning --env-file-if-exists=.env --watch src/server.js",
    "seed": "node --disable-warning=ExperimentalWarning --env-file-if-exists=.env scripts/seed.js",
    "user:create": "node --disable-warning=ExperimentalWarning --env-file-if-exists=.env scripts/create-user.js",
    "test": "node --disable-warning=ExperimentalWarning --test test/*.test.js",
    "backup": "node --disable-warning=ExperimentalWarning --env-file-if-exists=.env scripts/backup.js"
  },
  "license": "UNLICENSED",
  "dependencies": {
    "ejs": "^7.0.2",
    "express": "^4.22.3",
    "nodemailer": "^10.3.1",
    "ws": "^8.22.0"
  }
}
