<%- include('../partials/head') %>
<%- include('../partials/topbar', { crumbs: [['Einstellungen'], ['Bestätigungsmail']], heading: 'Anmeldebestätigung per E-Mail', showSearch: false,
  actions: '<button class="btn" type="submit" form="conf-form" name="action" value="preview">Vorschau</button><button class="btn btn-primary" type="submit" form="conf-form" name="action" value="save">Speichern</button>' }) %>
<%- include('_tabs') %>
<% if (typeof unsaved !== 'undefined' && unsaved) { %><div class="flash flash-info">Vorschau mit ungespeicherten Änderungen – zum Übernehmen «Speichern» klicken.</div><% } %>
<% if (typeof testResult !== 'undefined' && testResult) { %><div class="flash <%= testResult.ok ? 'flash-success' : 'flash-error' %>"><%= testResult.msg %></div><% } %>
<form id="conf-form" method="post" action="/verwaltung/bestaetigungsmail" class="grid grid-main">
  <input type="hidden" name="_csrf" value="<%= csrfToken %>">
  <div class="stack">
    <div class="card">
      <div class="card-head"><h2>Vorlage</h2>
        <label class="check"><input type="checkbox" name="enabled" value="1" <%= conf.enabled ? 'checked' : '' %>> beim Bestätigen automatisch senden</label></div>
      <div class="card-body">
        <% if (!smtp) { %><div class="callout warn mb">Es ist kein Mailserver (SMTP) eingerichtet. Bestätigungen werden im Postausgang unter «Formulare» abgelegt, aber nicht versendet. Eintragen unter <a href="/verwaltung/server">Einstellungen › Server</a>.</div><% } %>
        <p class="small muted mb">Die Mail geht an die E-Mail-Adresse der Person, sobald ihre Anmeldung auf «Bestätigt» gesetzt wird. Personen ohne E-Mail-Adresse bekommen keine.</p>
        <div class="field"><label for="subject">Betreff</label><input id="subject" type="text" name="subject" value="<%= conf.subject %>" data-token-target></div>
        <div class="field"><label for="body">Text</label>
          <%- include('../partials/rich-editor', { id: 'body', name: 'body', formatName: 'body_format', value: h.editorHtml(conf.body, conf.format), rows: 20 }) %>
          <div class="field-hint">Zeilen (und Tabellenzeilen), in denen ein Baustein leer ist, werden weggelassen. Die Mail geht formatiert raus, zusätzlich mit einer Klartext-Fassung für Mailprogramme ohne HTML.</div></div>
      </div>
    </div>
    <div class="card">
      <div class="card-head"><h2>Vorschau mit einem echten Einsatz</h2>
        <select name="einsatz" style="width:auto" data-preview-event data-search><% for (const e of eventOptions) { %><option value="<%= e.id %>" <%= previewEvent && previewEvent.id === e.id ? 'selected' : '' %>><%= e.name %> (<%= h.fmtEventDate(e) %>)</option><% } %></select></div>
      <div class="card-body ics-preview">
        <% if (!preview) { %><p class="muted">Noch kein Einsatz vorhanden.</p><% } else { %>
          <div class="meta">An: <%= preview.to ? `${preview.person.first_name} ${preview.person.last_name} <${preview.to}>` : `${preview.person.first_name} ${preview.person.last_name}` %></div>
          <div class="title"><%= preview.subject %></div>
          <div class="desc rich"><% if (preview.html) { %><%- preview.html %><% } else { %><div style="white-space:pre-wrap"><%= preview.body %></div><% } %></div>
        <% } %>
      </div>
    </div>
    <div class="card">
      <div class="card-head"><h2>Testmail</h2></div>
      <div class="card-body">
        <p class="small muted mb">Schickt die Vorlage (auch ungespeichert) mit dem oben gewählten Einsatz an eine Adresse deiner Wahl. So prüfst du gleich auch, ob der Mailversand funktioniert.</p>
        <div class="row"><input type="email" name="test_to" value="<%= testTo %>" placeholder="deine@adresse.ch" style="max-width:320px"><button class="btn" type="submit" name="action" value="test">Testmail senden</button></div>
      </div>
    </div>
  </div>
  <div class="card blocks">
    <div class="card-head"><h2>Bausteine <span class="hint">Klick fügt ein</span></h2></div>
    <div class="card-body">
      <% for (const g of groups) { %>
        <h4><%= g.name %></h4>
        <% for (const [key, label] of g.items) { %><button type="button" class="block-btn" data-token="{{<%= key %>}}" title="{{<%= key %>}}"><%= label %></button><% } %>
      <% } %>
      <p class="small muted mt">Bei mehreren zugeteilten Schichten stehen bei «Schichtname» alle Schichten.</p>
    </div>
  </div>
</form>
<%- include('../partials/foot') %>
