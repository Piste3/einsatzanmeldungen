<%- include('../partials/head') %>
<%- include('../partials/topbar', { crumbs: [['Einstellungen'], ['Vorlagen']], heading: 'Einstellungen', showSearch: false }) %>
<%- include('_tabs') %>
<% const del = (id) => id ? `<label class="check small"><input type="checkbox" name="delete__${id}" value="1" data-delete-row> entfernen</label>` : ''; %>
<div class="stack">
  <form class="card" method="post" action="/verwaltung/vorlagen/fragen" data-section>
    <input type="hidden" name="_csrf" value="<%= csrfToken %>">
    <div class="card-head"><h2>Anmeldefragen <span class="hint">zur Auswahl beim Einsatz</span></h2></div>
    <div class="table-wrap"><table class="form-table">
      <thead><tr><th>Name</th><th>Fragetext</th><th>Hilfetext</th><th>Reihenfolge</th><th>Entfernen</th></tr></thead>
      <tbody>
      <% for (const q of questions.concat([{ id: '' }])) { const k = q.id || 'neu'; %>
        <tr class="<%= q.id ? '' : 'new-row' %>">
          <td><% if (q.id) { %><input type="hidden" name="row__<%= k %>" value="1"><% } %><input type="text" name="name__<%= k %>" value="<%= q.name || '' %>" placeholder="<%= q.id ? '' : '+ Neue Vorlage …' %>" <%= q.id ? 'required' : '' %>></td>
          <td><input type="text" name="question_text__<%= k %>" value="<%= q.question_text || '' %>"></td>
          <td><input type="text" name="help_text__<%= k %>" value="<%= q.help_text || '' %>"></td>
          <td><input type="number" name="sort__<%= k %>" value="<%= q.sort ?? '' %>" style="width:70px"></td>
          <td><%- del(q.id) %></td>
        </tr>
      <% } %>
      </tbody>
    </table></div>
    <%- include('_section-foot') %>
  </form>
  <form class="card" method="post" action="/verwaltung/vorlagen/tenue" data-section>
    <input type="hidden" name="_csrf" value="<%= csrfToken %>">
    <div class="card-head"><h2>Tenue-Vorlagen</h2></div>
    <div class="table-wrap"><table class="form-table">
      <thead><tr><th>Name</th><th>Text</th><th>Reihenfolge</th><th>Entfernen</th></tr></thead>
      <tbody>
      <% for (const t of tenues.concat([{ id: '' }])) { const k = t.id || 'neu'; %>
        <tr class="<%= t.id ? '' : 'new-row' %>">
          <td><% if (t.id) { %><input type="hidden" name="row__<%= k %>" value="1"><% } %><input type="text" name="name__<%= k %>" value="<%= t.name || '' %>" placeholder="<%= t.id ? '' : '+ Neue Vorlage …' %>" <%= t.id ? 'required' : '' %>></td>
          <td><textarea name="text__<%= k %>" rows="2"><%= t.text || '' %></textarea></td>
          <td><input type="number" name="sort__<%= k %>" value="<%= t.sort ?? '' %>" style="width:70px"></td>
          <td><%- del(t.id) %></td>
        </tr>
      <% } %>
      </tbody>
    </table></div>
    <%- include('_section-foot') %>
  </form>
  <form class="card" method="post" action="/verwaltung/vorlagen/zusatzfelder" data-section>
    <input type="hidden" name="_csrf" value="<%= csrfToken %>">
    <div class="card-head"><h2>Zusatzfelder für Einsätze <span class="hint">z. B. «Transport» oder «Verpflegung vor Ort» – stehen automatisch als Baustein zur Verfügung</span></h2></div>
    <div class="table-wrap"><table class="form-table">
      <thead><tr><th>Feldname</th><th>Typ</th><th>Pflicht</th><th>Reihenfolge</th><th>Entfernen</th></tr></thead>
      <tbody>
      <% for (const f of extras.concat([{ id: '' }])) { const k = f.id || 'neu'; %>
        <tr class="<%= f.id ? '' : 'new-row' %>">
          <td><% if (f.id) { %><input type="hidden" name="row__<%= k %>" value="1"><% } %><input type="text" name="name__<%= k %>" value="<%= f.name || '' %>" placeholder="<%= f.id ? '' : '+ Neues Feld …' %>" <%= f.id ? 'required' : '' %>></td>
          <td><select name="field_type__<%= k %>"><% for (const [t, v] of [['text', 'Text'], ['textarea', 'Mehrzeilig'], ['number', 'Zahl'], ['date', 'Datum'], ['checkbox', 'Ja/Nein']]) { %><option value="<%= t %>" <%= f.field_type === t ? 'selected' : '' %>><%= v %></option><% } %></select></td>
          <td><input type="checkbox" name="required__<%= k %>" value="1" <%= f.required ? 'checked' : '' %>></td>
          <td><input type="number" name="sort__<%= k %>" value="<%= f.sort ?? '' %>" style="width:70px"></td>
          <td><%- del(f.id) %></td>
        </tr>
      <% } %>
      </tbody>
    </table></div>
    <div class="card-body small muted">Beim Entfernen eines Zusatzfelds bleiben bereits erfasste Werte im Einsatz gespeichert.</div>
    <%- include('_section-foot') %>
  </form>
</div>
<%- include('../partials/foot') %>
