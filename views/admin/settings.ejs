<%- include('../partials/head') %>
<%- include('../partials/topbar', { crumbs: [['Einstellungen'], ['Allgemein']], heading: 'Einstellungen', showSearch: false }) %>
<%- include('_tabs') %>
<form method="post" action="/verwaltung/einstellungen" class="grid grid-main">
  <input type="hidden" name="_csrf" value="<%= csrfToken %>">
  <div class="stack">
    <div class="card">
      <div class="card-head"><h2>Verein</h2></div>
      <div class="card-body">
        <div class="fields fields-2">
          <div class="field"><label for="verein_name">Vereinsname</label><input id="verein_name" type="text" name="verein_name" value="<%= s.verein_name %>"></div>
          <div class="field"><label for="aufgebot_email">Aufgebots-E-Mail</label><input id="aufgebot_email" type="email" name="aufgebot_email" value="<%= s.aufgebot_email %>"><div class="field-hint">steht im Aufgebot, z. B. aufgebot@kkb.ch</div></div>
        </div>
      </div>
    </div>
    <div class="card">
      <div class="card-head"><h2>Anmeldeformular</h2></div>
      <div class="card-body">
        <div class="fields fields-2">
          <div class="field"><label for="form_title">Titel</label><input id="form_title" type="text" name="form_title" value="<%= s.form.title %>"></div>
          <div class="field"><label for="form_min_seconds">Spam-Schutz: Mindestzeit (Sekunden)</label><input id="form_min_seconds" type="number" min="0" name="form_min_seconds" value="<%= s.form.min_seconds %>"><div class="field-hint">Schneller abgeschickte Formulare gelten als Spamverdacht.</div></div>
        </div>
        <div class="field"><label for="form_intro">Einleitungstext (optional)</label><textarea id="form_intro" name="form_intro" rows="2"><%= s.form.intro %></textarea></div>
      </div>
    </div>
    <div class="card">
      <div class="card-head"><h2>Automatische Anmeldebestätigung</h2>
        <label class="check"><input type="checkbox" name="confirmation_enabled" value="1" <%= s.confirmation.enabled ? 'checked' : '' %>> nach dem Bestätigen per E-Mail senden</label></div>
      <div class="card-body">
        <% if (!smtp) { %><div class="callout warn mb">Es ist kein Mailserver (SMTP) konfiguriert. Bestätigungen werden im Postausgang unter «Formulare» abgelegt, aber nicht versendet. Siehe README (SMTP_HOST usw.).</div><% } %>
        <div class="field"><label for="confirmation_subject">Betreff</label><input id="confirmation_subject" type="text" name="confirmation_subject" value="<%= s.confirmation.subject %>"></div>
        <div class="field"><label for="confirmation_body">Text</label><textarea id="confirmation_body" name="confirmation_body" rows="14"><%= s.confirmation.body %></textarea>
          <div class="field-hint">Bausteine wie beim Kalendertermin, zusätzlich {{person.vorname}} und {{person.nachname}}.</div></div>
      </div>
    </div>
    <div><button class="btn btn-primary" type="submit">Einstellungen speichern</button></div>
  </div>
  <div class="stack">
    <div class="card">
      <div class="card-head"><h2>Datensicherung</h2></div>
      <div class="card-body small">
        <p>Die Datenbank wird täglich automatisch gesichert (Ordner <code><%= backupDir %></code>).</p>
        <% for (const b of backups.slice(0, 7)) { %><div class="row-between"><span><%= b.name %></span><span class="muted"><%= Math.round(b.size / 1024) %> KB</span></div><% } %>
        <% if (!backups.length) { %><p class="muted">Noch keine Sicherung.</p><% } %>
        <button class="btn btn-sm mt-s" type="submit" form="backup-now">Jetzt sichern</button>
      </div>
    </div>
  </div>
</form>
<form id="backup-now" method="post" action="/verwaltung/sicherung"><input type="hidden" name="_csrf" value="<%= csrfToken %>"></form>
<%- include('../partials/foot') %>
