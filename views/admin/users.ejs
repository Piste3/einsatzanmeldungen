<%- include('../partials/head') %>
<%- include('../partials/topbar', { crumbs: [['Einstellungen'], ['Benutzer']], heading: 'Einstellungen', showSearch: false, actions: '<a class="btn btn-primary" href="/verwaltung/benutzer/neu">+ Benutzerkonto</a>' }) %>
<%- include('_tabs') %>
<div class="card">
  <div class="card-head"><h2>Benutzerkonten <span class="hint">Jede Person hat ein eigenes Konto – Konten werden nicht geteilt.</span></h2>
    <span class="small muted">Anmeldung: <%= providers.map((p) => p === 'local' ? 'eigenes Login' : 'Microsoft').join(' + ') %></span></div>
  <div class="table-wrap">
    <table>
      <thead><tr><th>Name</th><th>Benutzername</th><th>Rolle</th><th>Stammdaten</th><th>Anmeldung</th><th>Letztes Login</th><th>Status</th><th></th></tr></thead>
      <tbody>
      <% for (const u of list) { const locked = u.locked_until && new Date(u.locked_until) > new Date(); %>
        <tr>
          <td><strong><%= u.display_name %></strong><% if (u.email) { %><span class="sub"><%= u.email %></span><% } %></td>
          <td><%= u.username %></td>
          <td><%- h.badge(h.labels.ROLES[u.role], u.role === 'admin' ? 'orange' : 'blue') %></td>
          <td><% if (u.person_id) { %><a class="link" href="/personen/<%= u.person_id %>"><%= u.first_name %> <%= u.last_name %></a><% } else { %><span class="muted">nicht verknüpft</span><% } %></td>
          <td>Passwort<%= u.external_id ? ' + Microsoft' : (u.ms_login ? ' · Microsoft freigegeben' : '') %><%= u.must_change_password ? ' · Startpasswort' : '' %><% if (u.auth_provider === 'local') { %><span class="sub"><%= u.totp_enabled_at ? '2FA aktiv' : (u.twofa_required ? '2FA Pflicht – noch offen' : 'ohne 2FA') %></span><% } %></td>
          <td class="nowrap"><%= u.last_login_at ? h.fmtDateTime(u.last_login_at) : '–' %></td>
          <td><%- u.active ? (locked ? h.badge('gesperrt', 'red') : h.badge('aktiv', 'green')) : h.badge('deaktiviert', 'gray') %></td>
          <td class="right nowrap">
            <% if (locked) { %><form method="post" action="/verwaltung/benutzer/<%= u.id %>/entsperren" class="inline"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><button class="btn btn-xs" type="submit">Entsperren</button></form><% } %>
            <a class="btn btn-xs" href="/verwaltung/benutzer/<%= u.id %>">Bearbeiten</a>
          </td>
        </tr>
      <% } %>
      </tbody>
    </table>
  </div>
</div>
<div class="callout mt"><strong class="cap">Microsoft-Anmeldung</strong>Ist sie auf dem Server eingerichtet, erscheint auf der Login-Seite «Mit Microsoft anmelden». Wer sie nutzen darf, legst du pro Benutzerkonto fest: E-Mail-Adresse des Microsoft-Kontos eintragen und «Microsoft-Anmeldung erlaubt» ankreuzen. Das Login mit Passwort bleibt daneben bestehen.</div>
<%- include('../partials/foot') %>
