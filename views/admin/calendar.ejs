<%- include('../partials/head') %>
<%- include('../partials/topbar', { crumbs: [['Einstellungen'], ['Kalendertermin']], heading: 'Vorlage für das Aufgebot', showSearch: false,
  actions: '<button class="btn" type="submit" form="cal-form" name="preview" value="1">Vorschau</button><button class="btn btn-primary" type="submit" form="cal-form">Speichern</button>' }) %>
<%- include('_tabs') %>
<% if (typeof unsaved !== 'undefined' && unsaved) { %><div class="flash flash-info">Vorschau mit ungespeicherten Änderungen – zum Übernehmen «Speichern» klicken.</div><% } %>
<form id="cal-form" method="post" action="/verwaltung/kalendertermin" class="grid grid-main">
  <input type="hidden" name="_csrf" value="<%= csrfToken %>">
  <div class="stack">
    <div class="card">
      <div class="card-body">
        <div class="field"><label for="title">Titel des Termins</label><input id="title" type="text" name="title" value="<%= tpl.title %>" data-token-target></div>
        <div class="fields fields-2">
          <div class="field"><label for="location">Ort</label><input id="location" type="text" name="location" value="<%= tpl.location %>" data-token-target></div>
          <div class="field"><label>Termin von – bis</label><input type="text" value="Antreten (Beginn) bis Abtreten (Ende)" disabled></div>
        </div>
        <div class="field"><label for="description">Beschreibung</label>
          <%- include('../partials/rich-editor', { id: 'description', name: 'description', formatName: 'description_format', value: h.editorHtml(tpl.description, tpl.format), rows: 22 }) %></div>
        <div class="row">
          <label class="check"><input type="checkbox" name="omit_empty_lines" value="1" <%= tpl.omit_empty_lines ? 'checked' : '' %>> Zeilen mit leerem Baustein weglassen</label>
          <label class="check"><input type="checkbox" name="attendees" value="1" <%= tpl.attendees ? 'checked' : '' %>> Angemeldete als Kalender-Teilnehmende eintragen</label>
          <label class="row small">Erinnerung
            <select name="reminder_minutes" style="width:auto">
              <% for (const [v, l] of [[0, 'keine'], [60, '1 Stunde vorher'], [180, '3 Stunden vorher'], [1440, '1 Tag vorher'], [2880, '2 Tage vorher'], [10080, '1 Woche vorher']]) { %><option value="<%= v %>" <%= Number(tpl.reminder_minutes) === v ? 'selected' : '' %>><%= l %></option><% } %>
            </select></label>
        </div>
        <div class="field mt">
          <label for="html_mode">Formatierung im Kalender</label>
          <select id="html_mode" name="html_mode" style="width:auto;max-width:100%">
            <option value="alt" <%= tpl.html_mode !== 'description' ? 'selected' : '' %>>Normal: Klartext + formatierte Fassung (Outlook zeigt die Formatierung)</option>
            <option value="description" <%= tpl.html_mode === 'description' ? 'selected' : '' %>>HTML direkt in der Beschreibung (z. B. Google Kalender, ClubDesk)</option>
          </select>
          <div class="field-hint">Nicht jeder Kalender zeigt Formatierungen an. Apple Kalender zeigt immer den Klartext. Falls nach dem Import HTML-Zeichen wie &lt;div&gt; erscheinen, «Normal» wählen.</div>
        </div>
      </div>
    </div>
    <div class="card">
      <div class="card-head"><h2>Vorschau mit einem echten Einsatz</h2>
        <select name="einsatz" style="width:auto" data-preview-event data-search><% for (const e of eventOptions) { %><option value="<%= e.id %>" <%= previewEvent && previewEvent.id === e.id ? 'selected' : '' %>><%= e.name %> (<%= h.fmtEventDate(e) %>)</option><% } %></select></div>
      <div class="card-body ics-preview">
        <% if (!preview) { %><p class="muted">Noch kein Einsatz vorhanden.</p><% } else { %>
          <div class="title"><%= preview.summary %></div>
          <div class="meta"><%= preview.start ? h.fmtDateLong(preview.start.slice(0, 10)) + ' · ' + preview.start.slice(11, 16) + '–' + (preview.end || '').slice(11, 16) : '' %><br><%= preview.location %><br><%= tpl.reminder_minutes ? 'Erinnerung aktiv' : '' %></div>
          <div class="grid grid-main">
            <div class="desc rich"><% if (preview.descriptionHtml) { %><%- preview.descriptionHtml %><% } else { %><div style="white-space:pre-wrap"><%= preview.description %></div><% } %></div>
            <div class="small"><strong class="muted">TEILNEHMENDE · <%= preview.people.length %></strong>
              <% for (const p of preview.people) { %><div class="row mt-s"><span class="avatar"><%= h.initials(`${p.first_name} ${p.last_name}`) %></span><%= p.rank_short || '' %> <%= p.first_name %> <%= p.last_name %><%= p.email ? '' : ' (keine E-Mail)' %></div><% } %>
              <% if (!preview.people.length) { %><p class="muted">Noch keine bestätigten Anmeldungen.</p><% } %>
            </div>
          </div>
        <% } %>
      </div>
    </div>
  </div>
  <div class="card blocks">
    <div class="card-head"><h2>Bausteine <span class="hint">Klick fügt ein</span></h2></div>
    <div class="card-body">
      <% for (const g of groups) { %>
        <h4><%= g.name %></h4>
        <% for (const [key, label] of g.items) { %><button type="button" class="block-btn" data-token="{{<%= key %>}}" title="{{<%= key %>}}"><%= label %></button><% } %>
      <% } %>
      <p class="small muted mt">Leere Bausteine: Ist ein Baustein für einen Einsatz leer, wird die ganze Zeile weggelassen (abschaltbar).</p>
    </div>
  </div>
</form>
<%- include('../partials/foot') %>
