<%- include('../partials/head') %>
<%- include('../partials/topbar', { crumbs: [['Einstellungen'], ['System']], heading: 'System', showSearch: false }) %>
<%- include('_tabs') %>
<div class="grid grid-main">
  <div class="stack">
    <div class="card">
      <div class="card-head"><h2>Update</h2></div>
      <div class="card-body">
        <% if (!st.canRestart) { %>
          <div class="callout warn mb">Der Server läuft noch mit dem alten Startskript. Damit Update und Neustart hier funktionieren, bitte <strong>einmalig auf dem Server</strong> <code>betrieb\windows\update.cmd</code> ausführen (Linux/macOS: <code>betrieb/linux/update.sh</code>). Ist der Autostart eingerichtet, danach zusätzlich <code>autostart-ein.cmd</code> als Administrator.</div>
        <% } %>
        <p class="small">Holt die neueste Version von GitHub. Vorher wird die Datenbank gesichert, danach startet der Server neu. Während des Neustarts ist die Seite für einige Sekunden nicht erreichbar.</p>
        <% if (check) { %>
          <% if (check.error) { %><div class="callout warn mt-s"><%= check.error %></div>
          <% } else if (!check.commits.length) { %><div class="callout mt-s">Du bist auf dem neuesten Stand.</div>
          <% } else { %>
            <div class="callout mt-s"><strong><%= check.commits.length %> Neuerung<%= check.commits.length === 1 ? '' : 'en' %> verfügbar:</strong>
              <ul class="small mt-s"><% for (const c of check.commits) { %><li><%= c.subject %> <span class="muted">(<%= h.fmtDateTime(c.date) %>)</span></li><% } %></ul></div>
          <% } %>
        <% } %>
        <div class="row mt">
          <form method="post" action="/verwaltung/system/pruefen" class="inline"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><button class="btn" type="submit">Nach Updates suchen</button></form>
          <form method="post" action="/verwaltung/system/update" class="inline" data-confirm="Update jetzt installieren?&#10;&#10;Die Datenbank wird vorher gesichert. Der Server startet danach neu und ist kurz nicht erreichbar."><input type="hidden" name="_csrf" value="<%= csrfToken %>"><button class="btn btn-primary" type="submit" <%= st.running || !st.canRestart ? 'disabled' : '' %>>Update installieren</button></form>
        </div>
      </div>
    </div>
    <div class="card">
      <div class="card-head"><h2>Protokoll <span class="hint" id="update-state"><%= st.running ? `läuft: ${st.step || ''}` : st.restarting ? 'Neustart …' : st.ok === false ? 'fehlgeschlagen' : '' %></span></h2></div>
      <div class="card-body">
        <pre class="update-log" data-update-log data-running="<%= st.running || st.restarting || query.neustart ? '1' : '0' %>"><%= st.lines.length ? st.lines.join('\n') : 'Noch kein Update ausgeführt.' %></pre>
      </div>
    </div>
  </div>
  <div class="stack">
    <div class="card">
      <div class="card-head"><h2>Version</h2></div>
      <div class="card-body small">
        <% if (version) { %>
          <div class="row-between"><span class="muted">Stand</span><span><code><%= version.hash %></code></span></div>
          <div class="row-between"><span class="muted">vom</span><span><%= h.fmtDateTime(version.date) %></span></div>
          <p class="mt-s"><%= version.subject %></p>
        <% } else { %><p class="muted">Keine Versionsangabe (kein git-Projekt).</p><% } %>
        <div class="row-between mt-s"><span class="muted">Node.js</span><span><%= node %> (<%= platform %>)</span></div>
      </div>
    </div>
    <div class="card">
      <div class="card-head"><h2>Neustart</h2></div>
      <div class="card-body small">
        <p>Startet den Server neu, z. B. nach Änderungen an der <code>.env</code>. Dauert wenige Sekunden.</p>
        <form method="post" action="/verwaltung/system/neustart" data-confirm="Server jetzt neu starten?&#10;&#10;Die Seite ist für einige Sekunden nicht erreichbar." class="mt-s"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><button class="btn" type="submit" <%= st.running || !st.canRestart ? 'disabled' : '' %>>Server neu starten</button></form>
      </div>
    </div>
  </div>
</div>
<%- include('../partials/foot') %>
