<%- include('../partials/head') %>
<%- include('../partials/topbar', { crumbs: [['Einstellungen'], ['Auswahllisten']], heading: 'Einstellungen', showSearch: false }) %>
<%- include('_tabs') %>
<div class="grid grid-2">
  <% for (const [kind, label, rows] of [['raenge', 'Ränge', ranks], ['mannschaften', 'Mannschaften / Kader', teams]]) { %>
  <form class="card" method="post" action="/verwaltung/listen/<%= kind %>" data-section>
    <input type="hidden" name="_csrf" value="<%= csrfToken %>">
    <div class="card-head"><h2><%= label %></h2></div>
    <div class="table-wrap">
      <table class="form-table">
        <thead><tr><th>Name</th><% if (kind === 'raenge') { %><th>Kürzel</th><% } %><th>Reihenfolge</th><th>Aktiv</th><th>Personen</th><th>Entfernen</th></tr></thead>
        <tbody>
        <% for (const r of rows) { %>
          <tr>
            <td><input type="hidden" name="row__<%= r.id %>" value="1"><input type="text" name="name__<%= r.id %>" value="<%= r.name %>" required></td>
            <% if (kind === 'raenge') { %><td><input type="text" name="short__<%= r.id %>" value="<%= r.short %>" style="width:70px"></td><% } %>
            <td><input type="number" name="sort__<%= r.id %>" value="<%= r.sort %>" style="width:70px"></td>
            <td><input type="checkbox" name="active__<%= r.id %>" value="1" <%= r.active ? 'checked' : '' %>></td>
            <td><%= r.used %></td>
            <td><% if (!r.used) { %><label class="check small"><input type="checkbox" name="delete__<%= r.id %>" value="1" data-delete-row> entfernen</label><% } else { %><span class="muted small" title="Wird verwendet – stattdessen deaktivieren">–</span><% } %></td>
          </tr>
        <% } %>
          <tr class="new-row">
            <td><input type="text" name="name__neu" placeholder="+ Neu …"></td>
            <% if (kind === 'raenge') { %><td><input type="text" name="short__neu" placeholder="Kürzel" style="width:70px"></td><% } %>
            <td><input type="number" name="sort__neu" style="width:70px"></td><td></td><td></td><td></td>
          </tr>
        </tbody>
      </table>
    </div>
    <% if (kind === 'raenge') { %><div class="card-body small muted">Die Reihenfolge bestimmt die Sortierung: kleine Zahl = tiefer Rang. Listen zeigen die Personen standardmässig vom höchsten zum tiefsten Rang.</div><% } %>
    <%- include('_section-foot') %>
  </form>
  <% } %>
</div>
<%- include('../partials/foot') %>
