<%- include('_head', { barTitle: 'Personen', barSub: `${h.plural(eventCount, 'Einsatz', 'Einsätze')} · ${f.label}`, navTab: 'personen' }) %>
<div class="h-tools">
  <div class="h-filter">
    <input type="search" placeholder="Name suchen …" aria-label="Name suchen" data-h-search autocomplete="off">
  </div>
</div>
<ul class="h-people" data-h-list>
  <% for (const p of list) { const name = `${p.first_name} ${p.last_name}`; %>
    <li class="hc" data-name="<%= `${name} ${p.rank_short || ''}`.toLowerCase() %>">
      <a class="h-person" href="/handy/personen/<%= p.id %>">
        <span class="h-person-name"><%- h.rank(p.rank_short) %><strong><%= name %></strong><% if (p.teams) { %><span class="hc-sub"><%= p.teams %></span><% } %></span>
        <span class="h-person-count <%= p.angemeldet ? 'has' : '' %>"><%= p.angemeldet %><small>angemeldet</small></span>
      </a>
    </li>
  <% } %>
  <li class="h-empty" data-h-nohit hidden><p>Kein Name passt zur Suche.</p></li>
</ul>
<%- include('_foot', { navTab: 'personen' }) %>
