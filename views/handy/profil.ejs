<%
  const themes = [['system', 'Wie System'], ['light', 'Hell'], ['dark', 'Dunkel']];
  const theme = ['light', 'dark'].includes(user.theme) ? user.theme : 'system';
  const local = user.auth_provider === 'local';
  const pwLocked = !Number(user.password_login ?? 1);
%>
<%- include('_head', { barTitle: 'Profil', barSub: h.labels.ROLES[user.role], navTab: 'profil' }) %>
<section class="h-profile">
  <span class="avatar h-avatar"><%= h.initials(user.display_name) %></span>
  <div>
    <strong><%= user.display_name %></strong>
    <span class="hc-sub"><%= h.labels.ROLES[user.role] %><%= user.username ? ` · ${user.username}` : '' %></span>
  </div>
</section>

<h2 class="h-section">Konto</h2>
<ul class="h-menu">
  <li><a href="/konto/passwort"><%- h.icon('key') %><span>Passwort ändern<% if (!local || pwLocked) { %><small><%= pwLocked ? 'gesperrt: nur Anmeldung über Microsoft' : 'Anmeldung über Microsoft' %></small><% } %></span><span class="h-chev">›</span></a></li>
  <li><a href="/konto/2fa"><%- h.icon('shield') %><span>Zwei-Faktor-Anmeldung<small><%= twofaOn ? 'eingerichtet' : 'nicht eingerichtet' %></small></span><span class="h-chev">›</span></a></li>
</ul>

<h2 class="h-section">Darstellung</h2>
<form method="post" action="/konto/darstellung" class="h-theme">
  <input type="hidden" name="_csrf" value="<%= csrfToken %>">
  <div class="segmented" role="group" aria-label="Darstellung">
    <% for (const [key, label] of themes) { %>
      <button type="submit" name="theme" value="<%= key %>" class="<%= theme === key ? 'is-on' : '' %>"<%- theme === key ? ' aria-pressed="true"' : ' aria-pressed="false"' %>><%= label %></button>
    <% } %>
  </div>
</form>

<h2 class="h-section">Weiteres</h2>
<ul class="h-menu">
  <li><a href="/handbuch"><%- h.icon('book') %><span>Handbuch</span><span class="h-chev">›</span></a></li>
  <li><a href="/handy/ganze-ansicht"><%- h.icon('monitor') %><span>Ganze Ansicht<small>eine Stunde lang der normale Einsatzplaner</small></span><span class="h-chev">›</span></a></li>
  <li>
    <form method="post" action="/logout"><input type="hidden" name="_csrf" value="<%= csrfToken %>">
      <button type="submit" class="h-logout"><%- h.icon('logout') %><span>Abmelden</span></button>
    </form>
  </li>
</ul>
<%- include('_foot', { navTab: 'profil' }) %>
