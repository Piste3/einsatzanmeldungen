<!doctype html>
<html lang="de-CH"<% if (user && ["light", "dark"].includes(user.theme)) { %> data-theme="<%= user.theme %>"<% } %>>
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
  <meta name="csrf-token" content="<%= csrfToken %>">
  <title><%= title ? title + ' · ' : '' %>KKB Anfragen</title>
  <%- include('_app-meta') %>
  <link rel="stylesheet" href="/static/css/app.css?v=<%= v %>">
  <link rel="stylesheet" href="/static/css/ruhig.css?v=<%= v %>">
  <link rel="stylesheet" href="/static/css/handy.css?v=<%= v %>">
</head>
<body class="handy" data-h-page="<%= typeof navTab !== 'undefined' ? navTab : '' %>">
<header class="h-bar">
  <% if (typeof backHref !== 'undefined' && backHref) { %>
    <a class="h-bar-btn" href="<%= backHref %>" aria-label="<%= typeof backLabel !== 'undefined' ? backLabel : 'Einsatz wechseln' %>">‹</a>
  <% } else { %>
    <span class="logo">KKB</span>
  <% } %>
  <div class="h-bar-title"><%= barTitle || 'Anfragen' %><% if (typeof barSub !== 'undefined' && barSub) { %><span><%= barSub %></span><% } %></div>
  <% const hs = typeof handySteps !== 'undefined' && handySteps ? handySteps : { undo: null, redo: null }; %>
  <form method="post" action="/handy/rueckgaengig" class="h-undo" data-h-step="undo"<%= hs.undo ? '' : ' hidden' %>
    data-confirm-title="Letzte Aktion rückgängig machen?" data-label="<%= hs.undo || '' %>">
    <input type="hidden" name="_csrf" value="<%= csrfToken %>"><input type="hidden" name="back" value="/handy">
    <button class="h-bar-btn" type="submit" aria-label="Letzte Aktion rückgängig machen" title="Rückgängig"><%- h.icon('undo') %></button>
  </form>
  <form method="post" action="/handy/wiederholen" class="h-undo" data-h-step="redo"<%= hs.redo ? '' : ' hidden' %>
    data-confirm-title="Wiederholen?" data-label="<%= hs.redo || '' %>">
    <input type="hidden" name="_csrf" value="<%= csrfToken %>"><input type="hidden" name="back" value="/handy">
    <button class="h-bar-btn" type="submit" aria-label="Rückgängig gemachte Aktion wiederholen" title="Wiederholen"><%- h.icon('redo') %></button>
  </form>
  <button class="h-bar-btn" type="button" data-reload aria-label="Neu laden" title="Neu laden">↻</button>
</header>
<main class="h-main">
  <% for (const f of flashes || []) { %><div class="flash flash-<%= f.type %>"><%= f.message %></div><% } %>
