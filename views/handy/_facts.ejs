<%
  // Angaben zum Einsatz: Datum, Antreten–Abtreten, Ort, Einsatzleitung (EL)
  const fe = e;
  const time = [fe.start_time, fe.end_time].filter(Boolean).join('–');
  const place = fe.start_place && fe.end_place && fe.end_place !== fe.start_place ? `${fe.start_place} → ${fe.end_place}` : (fe.start_place || fe.end_place || '');
  const el = fe.leader_person_id && fe.leader_first ? `${fe.leader_rank ? `${fe.leader_rank} ` : ''}${fe.leader_first} ${fe.leader_last}` : '';
  const elTel = fe.leader_mobile ? fe.leader_mobile.replace(/[^\d+]/g, '') : '';
  const isCompact = typeof compact !== 'undefined' && compact;
%>
<% if (isCompact) { %>
  <% if (place || el) { %><span class="h-event-facts"><% if (place) { %><span><%- h.icon('pin') %><%= place %></span><% } %><% if (el) { %><span><%- h.icon('user') %>EL <%= el %></span><% } %></span><% } %>
<% } else { %>
<dl class="h-facts" data-live-part="facts">
  <div><dt><%- h.icon('calendar') %><span>Datum</span></dt><dd><%= h.fmtEventDate(fe, 'wd') %></dd></div>
  <div><dt><%- h.icon('clock') %><span>Zeit</span></dt><dd><%= time || 'offen' %></dd></div>
  <div><dt><%- h.icon('pin') %><span>Ort</span></dt><dd><%= place || 'offen' %></dd></div>
  <div><dt><%- h.icon('user') %><span>EL</span></dt><dd><% if (el && elTel) { %><a href="tel:<%= elTel %>"><%= el %></a><% } else { %><%= el || 'offen' %><% } %></dd></div>
</dl>
<% } %>
