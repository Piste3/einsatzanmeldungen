<%- include('_head', { barTitle: 'Einsätze', barSub: f.label, navTab: 'einsaetze' }) %>
<div class="h-install" data-install hidden>
  <p><strong>Als App speichern:</strong> <span data-install-text>Im Browser-Menü «Zum Startbildschirm hinzufügen» wählen.</span></p>
  <button class="btn btn-sm" type="button" data-install-btn hidden>Installieren</button>
  <button class="h-x" type="button" data-install-close aria-label="Hinweis schliessen">×</button>
</div>
<% if (!list.length) { %>
  <div class="h-empty"><p><%= hidden ? 'Im gewählten Zeitraum gibt es keinen Einsatz.' : 'Es gibt keinen laufenden oder kommenden Einsatz.' %></p></div>
<% } %>
<ul class="h-events">
  <% for (const e of list) { const when = e.date_from === todayYmd ? 'Heute' : e.date_from < todayYmd ? 'Läuft' : h.fmtDaysUntil(e.date_from).replace(/^./, (c) => c.toUpperCase()); %>
    <li>
      <a class="h-event<%= e.id === currentEventId ? ' is-current' : '' %>" href="/handy/einsatz/<%= e.id %>">
        <span class="h-event-when"><%= when %> · <%= h.fmtEventDate(e) %><% if (e.start_time) { %> · <%= e.start_time %><% } %></span>
        <span class="h-event-name"><%= e.name %><% if (e.status === 'entwurf') { %> <span class="badge badge-gray">Entwurf</span><% } %></span>
        <span class="h-event-counts"><span class="dot dot-green"></span><%= e.counts.angemeldet %> angemeldet · <strong><%= e.counts.offen %> noch offen</strong></span>
      </a>
    </li>
  <% } %>
</ul>
<%- include('_hidden', { hidden }) %>
<%- include('_foot', { navTab: 'einsaetze' }) %>
