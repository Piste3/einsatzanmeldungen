<%
  const name = `${p.first_name} ${p.last_name}`;
  const tel = p.mobile ? p.mobile.replace(/[^\d+]/g, '') : '';
  const wa = h.waLink(p.mobile);
  const anyOpen = cards.some((c) => !c.locked);
%>
<%- include('_head', { barTitle: `${p.rank_short ? p.rank_short + ' ' : ''}${name}`, barSub: p.teams || 'Alle kommenden Einsätze', backHref: '/handy/personen', backLabel: 'Zurück zu den Personen', navTab: 'personen' }) %>
<div class="h-tools">
  <% if (tel || wa) { %>
  <div class="h-contact-row">
    <% if (tel) { %><a class="btn h-contact-btn" href="tel:<%= tel %>" data-set-channel-all="telefon"><%- h.icon('phone') %> Anrufen</a><% } %>
    <% if (wa) { %><a class="btn h-contact-btn" href="<%= wa %>" target="_blank" rel="noopener" data-set-channel-all="whatsapp"><%- h.icon('chat') %> WhatsApp</a><% } %>
  </div>
  <% } %>
  <% if (anyOpen) { %>
  <div class="h-channel" role="radiogroup" aria-label="Gefragt per">
    <span class="h-label">Gefragt per</span>
    <div class="segmented">
      <input type="radio" name="h-channel" id="hch-md" value="muendlich" checked><label for="hch-md">Mündlich</label>
      <input type="radio" name="h-channel" id="hch-tel" value="telefon"><label for="hch-tel">Telefon</label>
      <input type="radio" name="h-channel" id="hch-wa" value="whatsapp"><label for="hch-wa">WhatsApp</label>
    </div>
  </div>
  <% } %>
</div>
<div class="h-list">
  <% if (!cards.length) { %><div class="h-empty"><p>Es gibt keinen laufenden oder kommenden Einsatz.</p></div><% } %>
  <% for (const c of cards) { %><%- include('_person', { r: c.r, cardEvent: c.e, mode: 'person', shifts: c.shifts, locked: c.locked }) %><% } %>
</div>
<%- include('_foot', { navTab: 'personen' }) %>
