<%
  const base = `/handy/einsatz/${event.id}/anmeldungen`;
  const here = h.withQuery(base, { zeige: show !== 'alle' ? show : undefined });
  const tabs = [['alle', 'Angemeldet', counts.offen + counts.bestaetigt], ['offen', 'Zu bearbeiten', counts.offen], ['bestaetigt', 'Bestätigt', counts.bestaetigt], ['uebrige', 'Übrige', counts.uebrige]];
%>
<%- include('_head', { barTitle: event.name, barSub: h.fmtEventDate(event) + (event.start_time ? ` · ${event.start_time}` : ''), backHref: '/handy', navTab: 'anmeldungen' }) %>
<% if (locked) { %><div class="flash flash-info">Der Einsatz ist <%= h.labels.EVENT_STATUS[event.status].label.toLowerCase() %>. Anmeldungen lassen sich nur noch ansehen.</div><% } %>

<div class="h-tools">
  <% if (shifts.length) { %>
  <div class="h-occ" aria-label="Besetzung">
    <% for (const s of shifts) { %>
      <span class="h-occ-item h-occ-<%= s.tone %>"><span><%= s.name %></span><strong><%= s.ist %><%= s.soll ? ` / ${s.soll}` : '' %></strong></span>
    <% } %>
  </div>
  <% } %>
  <nav class="h-tabs" aria-label="Anzeigen">
    <% for (const [key, label, n] of tabs) { %>
      <a class="<%= show === key ? 'active' : '' %>" href="<%= h.withQuery(base, { zeige: key !== 'alle' ? key : undefined }) %>"<%- show === key ? ' aria-current="page"' : '' %>><%= label %> <span><%= n %></span></a>
    <% } %>
  </nav>
  <div class="h-filter">
    <input type="search" placeholder="Name suchen …" aria-label="Name suchen" data-h-search autocomplete="off">
    <a class="btn h-pdf" href="/einsaetze/<%= event.id %>/teilnehmerliste?format=pdf" target="_blank" rel="noopener">Teilnehmerliste PDF</a>
  </div>
</div>

<div class="h-list" data-h-list>
  <% if (!list.length) { %>
    <div class="h-empty"><p><%= total ? 'Hier steht niemand.' : 'Noch keine Anmeldungen.' %></p></div>
  <% } %>
  <% for (const r of list) { %><%- include('_registration', { r, back: here }) %><% } %>
  <div class="h-empty" data-h-nohit hidden><p>Kein Name passt zur Suche.</p></div>
</div>
<%- include('_foot', { navTab: 'anmeldungen' }) %>
