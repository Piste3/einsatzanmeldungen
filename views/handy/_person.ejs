<%
  const name = `${r.first_name} ${r.last_name}`;
  const tel = r.mobile ? r.mobile.replace(/[^\d+]/g, '') : '';
  const wa = h.waLink(r.mobile);
  const last = r.attempts.at(-1);
  const lastText = last ? `${h.labels.CHANNEL[last.channel].short}${last.contacted_at.slice(0, 10) === h.today() ? '' : ` ${h.fmtDateShort(last.contacted_at.slice(0, 10))}`} ${last.contacted_at.slice(11, 16)} · ${last.sent_by_name}` : '';
  const viaReg = r.state === 'angemeldet' && r.reg_source ? `über ${h.labels.SOURCE[r.reg_source] || r.reg_source}` : '';
  const btn = (key, text, cls = '') => `<button class="h-ans h-ans-${key} ${cls} ${r.answer === key || (r.answer === 'offen' && r.state === { unsicher: 'unsicher', nicht_erreicht: 'nicht_erreicht', gesendet: 'whatsapp' }[key]) ? 'is-on' : ''}" type="submit" name="antwort" value="${key}"${key === 'kann' && shifts.length ? ' data-shift-ask' : ''}>${text}</button>`;
  const RESULT_TEXT = { zugesagt: 'Kann', abgesagt: 'Kann nicht', unsicher: 'Weiss nicht', nicht_erreicht: 'Nicht erreicht', whatsapp: 'WhatsApp gesendet' };
  const prevAttempt = r.attempts.length > 1 ? r.attempts.at(-2) : null;
  const fromForm = r.reg_id && r.reg_source === 'formular';
  const prevText = prevAttempt ? `«${RESULT_TEXT[prevAttempt.result]}»` : fromForm ? '«angemeldet über Formular»' : '«Noch nicht gefragt»';
  const resetText = last ? `Die Antwort «${RESULT_TEXT[last.result]}» für ${name} wird gelöscht. Danach steht wieder ${prevText}.${last.result === 'zugesagt' && r.registration_id && !fromForm && !prevAttempt ? ' Die daraus erstellte Anmeldung wird ebenfalls gelöscht.' : ''}` : '';
  // Ohne Kontaktversuch, aber von Hand eingetragen (z. B. am PC «Person hinzufügen»): Zurücksetzen löscht diese Anmeldung
  const manualReg = !last && r.reg_id && r.reg_source && r.reg_source !== 'formular' ? r.reg_id : null;
  const manualText = manualReg ? `Die Anmeldung «${r.label.text}» für ${name} wurde von Hand eingetragen (${h.labels.SOURCE[r.reg_source] || r.reg_source}). Sie wird gelöscht. Danach steht wieder «Noch nicht gefragt».` : '';
  const ev = typeof cardEvent !== 'undefined' && cardEvent ? cardEvent : event;
  const byPerson = typeof mode !== 'undefined' && mode === 'person';
  const backUrl = typeof back !== 'undefined' ? back : byPerson ? `/handy/personen/${r.person_id}` : `/handy/einsatz/${ev.id}`;
%>
<article class="hc hc-<%= r.answer %>" id="<%= byPerson ? `e${ev.id}` : `p${r.person_id}` %>" data-name="<%= `${name} ${r.rank_short || ''}`.toLowerCase() %>" data-person="<%= r.person_id %>" data-who="<%= name %>">
  <div class="hc-top">
    <% if (byPerson) { %>
    <div class="hc-who">
      <a class="hc-event-link" href="/handy/einsatz/<%= ev.id %>"><strong><%= ev.name %></strong></a>
      <span class="hc-sub"><%= h.fmtEventDate(ev, 'wd') %><%= ev.start_time ? ` · ${[ev.start_time, ev.end_time].filter(Boolean).join('–')}` : '' %><%= ev.start_place ? ` · ${ev.start_place}` : '' %><%= ev.status === 'entwurf' ? ' · Entwurf' : '' %></span>
    </div>
    <% } else { %>
    <div class="hc-who">
      <strong><%- h.rank(r.rank_short) %><%= name %></strong>
      <% if (r.teams) { %><span class="hc-sub"><%= r.teams %></span><% } %>
    </div>
    <div class="hc-contact">
      <% if (tel) { %><a class="h-round" href="tel:<%= tel %>" data-set-channel="telefon" aria-label="<%= name %> anrufen" title="Anrufen"><%- h.icon('phone') %></a><% } %>
      <% if (wa) { %><a class="h-round" href="<%= wa %>" target="_blank" rel="noopener" data-set-channel="whatsapp" aria-label="<%= name %> per WhatsApp schreiben" title="WhatsApp"><%- h.icon('chat') %></a><% } %>
    </div>
    <% } %>
  </div>
  <div class="hc-state">
    <span class="badge badge-<%= r.label.tone %>"><%= r.label.text %></span>
    <% if (lastText) { %><span class="hc-last"><%= lastText %></span><% } else if (viaReg) { %><span class="hc-last"><%= viaReg %></span><% } %>
  </div>
  <% if (!locked) { %>
  <form method="post" action="/handy/einsatz/<%= ev.id %>/antwort" class="hc-form" data-h-form>
    <input type="hidden" name="_csrf" value="<%= csrfToken %>">
    <input type="hidden" name="person_id" value="<%= r.person_id %>">
    <input type="hidden" name="channel" value="muendlich" data-channel-input>
    <% if (byPerson) { %><input type="hidden" name="ansicht" value="person"><% } %>
    <input type="hidden" name="back" value="<%= backUrl %>">
    <div class="hc-answers">
      <%- btn('kann', 'Kann') %>
      <%- btn('kann_nicht', 'Kann nicht') %>
      <%- btn('unsicher', 'Weiss nicht') %>
      <%- btn('nicht_erreicht', 'Nicht erreicht', 'only-tel') %>
      <%- btn('gesendet', 'Gesendet', 'only-wa') %>
    </div>
    <% if (shifts.length) { %>
    <fieldset class="hc-shifts" data-shift-panel hidden>
      <legend>Für welche Schichten?</legend>
      <% for (const s of shifts) { %><label class="check"><input type="checkbox" name="shift_ids" value="<%= s.id %>" data-from="<%= s.from %>" data-to="<%= s.to %>" data-name="<%= s.name %>"> <span><%= s.name %><% if (s.time) { %> <span class="muted"><%= s.time %></span><% } %><span class="hc-clash" data-clash hidden></span></span></label><% } %>
      <p class="hc-hint">Leer lassen, wenn die Schicht noch offen ist.</p>
      <div class="hc-shift-foot"><button class="btn btn-ghost" type="button" data-shift-cancel>Abbrechen</button><button class="btn btn-primary" type="submit" name="antwort" value="kann">Kann – speichern</button></div>
    </fieldset>
    <% } %>
  </form>
  <% } %>
  <% if (last && !locked) { %>
  <details class="hc-note"<%= typeof openNote !== 'undefined' && openNote ? ' open' : '' %>>
    <summary><%- h.icon('chat') %><span><% if (last.note) { %><small>Interne Bemerkung</small><%= last.note %><% } else { %>Interne Bemerkung schreiben<% } %></span></summary>
    <form method="post" action="/handy/einsatz/<%= ev.id %>/notiz" data-h-form data-h-kind="note">
      <input type="hidden" name="_csrf" value="<%= csrfToken %>"><input type="hidden" name="person_id" value="<%= r.person_id %>"><% if (byPerson) { %><input type="hidden" name="ansicht" value="person"><% } %><input type="hidden" name="attempt_id" value="<%= last.id %>"><input type="hidden" name="back" value="<%= backUrl %>">
      <textarea name="note" aria-label="Interne Bemerkung für <%= name %>" rows="2" maxlength="500" placeholder="z. B. kommt erst ab 10 Uhr"><%= last.note || '' %></textarea>
      <button type="submit" class="btn btn-primary">Bemerkung speichern</button>
    </form>
  </details>
  <% } %>
  <% if ((last || manualReg) && !locked) { %>
  <form method="post" action="/handy/einsatz/<%= ev.id %>/zuruecknehmen" class="hc-reset" data-h-form data-h-kind="reset"
    data-confirm-title="<%= last ? 'Antwort zurücksetzen?' : 'Anmeldung zurücksetzen?' %>" data-confirm="<%= last ? resetText : manualText %>" data-confirm-ok="Ja, zurücksetzen">
    <input type="hidden" name="_csrf" value="<%= csrfToken %>"><input type="hidden" name="person_id" value="<%= r.person_id %>"><% if (byPerson) { %><input type="hidden" name="ansicht" value="person"><% } %><% if (last) { %><input type="hidden" name="attempt_id" value="<%= last.id %>"><% } else { %><input type="hidden" name="reg_id" value="<%= manualReg %>"><% } %><input type="hidden" name="back" value="<%= backUrl %>">
    <button type="submit" class="hc-reset-btn" title="Falsch getippt? Die letzte Antwort zurücksetzen"><%- h.icon('undo') %> Zurücksetzen</button>
  </form>
  <% } %>
</article>
