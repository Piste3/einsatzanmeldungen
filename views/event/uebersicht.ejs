<%
  const s = stats;
  const nextStatus = { entwurf: [['veroeffentlicht', 'Veröffentlichen', 'btn-primary'], ['abgesagt', 'Absagen', 'btn-danger']], veroeffentlicht: [['abgeschlossen', 'Abschliessen', ''], ['entwurf', 'Zurück auf Entwurf', ''], ['abgesagt', 'Absagen', 'btn-danger']], abgesagt: [['entwurf', 'Wieder auf Entwurf setzen', '']], abgeschlossen: isAdmin ? [['veroeffentlicht', 'Wieder öffnen (Admin)', '']] : [] }[event.status] || [];
%>
<%
  // Lage: was fehlt noch? Pro Schicht die Funktionen mit Lücken, sonst die Schicht als Ganzes
  const multiDay = h.isMultiDay(event);
  const gaps = [];
  const overs = [];
  for (const sh of fnSummary.shifts) {
    const miss = sh.rows.filter((f) => f.missing > 0).map((f) => `${f.missing} ${f.short}`);
    if (miss.length) gaps.push({ shift: sh.name, text: miss.join(', ') });
    const more = sh.rows.filter((f) => f.over > 0).map((f) => `${f.over} ${f.short}`);
    if (more.length) overs.push({ shift: sh.name, text: more.join(', ') });
  }
  if (!fnSummary.hasTargets) for (const sh of s.shifts) if (sh.missing) gaps.push({ shift: sh.name, text: `${sh.missing} Personen` });
  // Bei vielen Schichten: Summe pro Funktion statt einer langen Zeile, z. B. «9 EL, 36 TN»
  const gapTotal = (shifts, key) => {
    const sum = new Map();
    for (const sh of shifts) for (const f of sh.rows) if (f[key] > 0) sum.set(f.short, { pos: f.pos, n: (sum.get(f.short)?.n || 0) + f[key] });
    if (!sum.size && key === 'missing') return `${s.shifts.reduce((a, sh) => a + (sh.missing || 0), 0)} Personen`;
    return [...sum].sort((a, b) => a[1].pos - b[1].pos).map(([k, v]) => `${v.n} ${k}`).join(', ');
  };
  const noSoll = !s.shifts.some((sh) => sh.soll);
  const lage = noSoll ? { tone: 'gray', text: 'Noch kein Soll festgelegt' } : gaps.length ? { tone: 'yellow', text: 'Es fehlen noch Leute' } : { tone: 'green', text: 'Alle Schichten sind besetzt' };
  // Besetzung als Tabelle: Zeilen = Funktionen, Spalten = Schichten
  const fnRows = [];
  for (const sh of fnSummary.shifts) for (const f of sh.rows) if (!fnRows.some((x) => x.id === f.id)) fnRows.push(f);
  const cell = (sh, f) => sh.rows.find((x) => x.id === f.id);
  const occText = (c) => (!c ? '–' : `${c.ist} / ${c.soll ?? '–'}`);
  const occNote = (c) => (!c || !c.soll ? '' : c.over ? `${c.over} zu viel` : c.missing ? `${c.missing} ${c.missing === 1 ? 'fehlt' : 'fehlen'}` : 'voll');
%>
<div class="card mb lage">
  <div class="lage-main">
    <span class="lage-dot dot-<%= lage.tone %>" aria-hidden="true"></span>
    <div>
      <strong><%= lage.text %></strong>
      <% if (gaps.length) { %><div class="small muted"><% if (gaps.length > 2) { %>In <%= gaps.length %> von <%= fnSummary.shifts.length %> Schichten fehlen noch <%= gapTotal(fnSummary.shifts, 'missing') %>. <a class="link no-print" href="#besetzung">Details in der Besetzung ↓</a><% } else { %><%= gaps.map((g) => (fnSummary.shifts.length > 1 ? `${g.shift}: ${g.text}` : g.text)).join(' · ') %><% } %></div><% } %>
      <% if (overs.length) { %><div class="small muted">Mehr als nötig: <% if (overs.length > 2) { %>in <%= overs.length %> Schichten, total <%= gapTotal(fnSummary.shifts, 'over') %><% } else { %><%= overs.map((g) => (fnSummary.shifts.length > 1 ? `${g.shift} ${g.text}` : g.text)).join(' · ') %><% } %></div><% } %>
      <% if (noSoll) { %><div class="small muted"><a class="link" href="/einsaetze/<%= event.id %>/bearbeiten#funktionen">Soll pro Schicht festlegen</a></div><% } %>
      <% const openItems = checklist.filter((c) => !c.done); %>
      <% if (openItems.length) { %><div class="lage-todo small"><span class="muted">Noch offen:</span> <%= openItems.map((c) => c.label).join(' · ') %> <a class="link no-print" href="/einsaetze/<%= event.id %>/bearbeiten">Angaben ergänzen →</a></div><% } %>
    </div>
  </div>
  <div class="lage-counts">
    <a href="/einsaetze/<%= event.id %>/anmeldungen?status=neu"><strong><%= s.neu %></strong> neu</a>
    <a href="/einsaetze/<%= event.id %>/anmeldungen?status=zu_pruefen" class="<%= s.zuPruefen ? 'warn' : '' %>"><strong><%= s.zuPruefen %></strong> zu prüfen</a>
    <a href="/einsaetze/<%= event.id %>/anmeldungen?status=bestaetigt"><strong><%= s.bestaetigt %></strong> bestätigt</a>
    <a href="/einsaetze/<%= event.id %>/anmeldungen"><strong><%= s.total %></strong> Anmeldungen</a>
    <a href="/einsaetze/<%= event.id %>/anfragen"><strong><%= s.offen %></strong> ohne Rückmeldung</a>
  </div>
</div>
<div class="grid grid-main">
  <div class="stack">
    <div class="card" id="besetzung">
      <div class="card-head"><h2>Besetzung <span class="hint">Ist / Soll</span></h2><a class="small no-print" href="/einsaetze/<%= event.id %>/schichten#funktionen">Einteilen →</a></div>
      <div class="table-wrap">
        <table class="occ-table no-cards">
          <thead>
            <tr><th>Funktion</th><% for (const sh of fnSummary.shifts) { %><th class="right"><%= sh.name %><span class="sub"><%= h.fmtShiftWhen(sh, multiDay) || 'Zeit offen' %></span></th><% } %></tr>
          </thead>
          <tbody>
            <% for (const f of fnRows) { %>
              <tr>
                <td><span class="fn-tag<%= f.is_default ? ' fn-default' : '' %>"><%= f.short %></span> <%= f.name %></td>
                <% for (const sh of fnSummary.shifts) { const c = cell(sh, f); %>
                  <td class="right nowrap"><% if (c) { %><span class="occ-cell"><span class="occ-n"><%= occText(c) %></span><span class="occ-note tone-<%= c.tone %>"><%= occNote(c) %></span></span><% } else { %><span class="muted">–</span><% } %></td>
                <% } %>
              </tr>
            <% } %>
            <% if (!fnRows.length) { %><tr><td colspan="<%= fnSummary.shifts.length + 1 %>" class="empty">Noch kein Soll und noch niemand zugeteilt.</td></tr><% } %>
          </tbody>
          <tfoot>
            <tr><td>Total</td><% for (const sh of s.shifts) { %><td class="right">
              <div class="occ-total"><strong><%= sh.ist %> / <%= sh.soll ?? '–' %></strong><% if (sh.extern) { %><span class="small muted"><%= sh.intern %> eigene + <%= sh.extern %> extern</span><% } %></div>
              <div class="bar <%= sh.tone %>"><span style="width:<%= h.pct(sh.ist, sh.soll) %>%"></span></div>
            </td><% } %></tr>
          </tfoot>
        </table>
      </div>
    </div>
    <div class="card" id="angaben">
      <div class="card-head"><h2>Angaben</h2><a class="small no-print" href="/einsaetze/<%= event.id %>/bearbeiten">Bearbeiten →</a></div>
      <div class="card-body">
        <dl class="kv left">
          <dt>Datum</dt><dd><% if (event.date_from) { %><%= h.fmtEventDate(event, 'long') %><% if (!event.date) { %> <span class="muted small">· aus den Schichten</span><% } %><% } else { %><span class="muted">offen – Datum beim Einsatz oder bei den <a class="link" href="/einsaetze/<%= event.id %>/schichten#schichten-bearbeiten">Schichten</a> eintragen</span><% } %></dd>
          <dt>Antreten</dt><dd><%= event.start_time || '–' %><%= event.start_place ? ` · ${event.start_place}` : '' %></dd>
          <dt>Abtreten</dt><dd><%= event.end_time || '–' %><%= (event.end_place || event.start_place) ? ` · ${event.end_place || event.start_place}` : '' %></dd>
          <dt>Einsatzleitung</dt><dd><%= event.leader_last ? `${event.leader_rank || ''} ${event.leader_first} ${event.leader_last}`.trim() + (event.leader_mobile ? ` (${event.leader_mobile})` : '') : '–' %></dd>
          <dt>Tenue</dt><dd class="pre"><%= event.tenue || '–' %></dd>
          <dt>Beschreibung</dt><dd class="pre"><%= event.description || '–' %></dd>
          <% for (const d of extraDefs) { %><dt><%= d.name %></dt><dd><%= (event.extra || {})[d.name] || '–' %></dd><% } %>
          <dt>Interne Bemerkung</dt><dd class="pre"><%= event.internal_note || '–' %></dd>
          <dt>Aufgebot</dt><dd><%= event.calendar_sent_at ? `Kalendertermin exportiert ${h.fmtDateTime(event.calendar_sent_at)}` : 'noch nicht exportiert' %></dd>
        </dl>
      </div>
    </div>
    <% const extTotal = externals.reduce((a, x) => a + x.person_count, 0); const multiShift = event.shifts.length > 1; %>
    <div class="card" id="externe">
      <div class="card-head"><h2>Externe Abteilungen <span class="hint">nur Anzahl Personen – zählen in der Besetzung mit</span></h2><% if (extTotal) { %><strong class="small"><%= h.plural(extTotal, 'Person', 'Personen') %></strong><% } %></div>
      <% for (const x of externals) { %>
        <details class="ext-row" data-row-id="x<%= x.id %>">
          <summary>
            <span class="name"><span class="tag tag-blue">extern</span> <strong><%= x.unit_name %></strong></span>
            <span class="ext-count"><strong><%= h.plural(x.person_count, 'Person', 'Personen') %></strong></span>
            <span class="ext-meta muted small"><%= [x.func.is_default ? '' : `Funktion ${x.func.short}`, multiShift ? (x.allShifts ? 'alle Schichten' : x.shiftNames.join(' + ')) : '', x.dietLabel ? `Essen: ${x.dietLabel}` : '', x.contact ? `Kontakt: ${x.contact}` : '', x.note || ''].filter(Boolean).join(' · ') %></span>
            <span class="btn btn-sm btn-ghost no-print">Bearbeiten</span>
          </summary>
          <%- include('_external-form', { x }) %>
          <form method="post" action="/einsaetze/<%= event.id %>/externe/<%= x.id %>/loeschen" class="card-body ext-delete" data-confirm="«<%= x.unit_name %>» von diesem Einsatz entfernen?">
            <input type="hidden" name="_csrf" value="<%= csrfToken %>">
            <% if (event.status === 'abgeschlossen') { %><input type="hidden" name="reason" value="" data-reason><% } %>
            <button class="btn btn-sm btn-ghost btn-danger" type="submit">Vom Einsatz entfernen</button>
          </form>
        </details>
      <% } %>
      <details class="ext-add no-print">
        <summary class="card-body"><span class="btn btn-sm">+ Externe Abteilung hinzufügen</span></summary>
        <%- include('_external-form', { x: null }) %>
      </details>
      <datalist id="ext-units"><% for (const u of unitOptions) { %><option value="<%= u.name %>"></option><% } %></datalist>
    </div>
  </div>
  <div class="stack">
    <div class="card">
      <div class="card-head"><h2>Status und Formular</h2><%- h.eventState({ ...event, inForm }) %></div>
      <div class="card-body">
        <p class="small muted">Entwurf → Veröffentlicht → Abgeschlossen (oder jederzeit Abgesagt)</p>
        <div class="row">
        <% for (const [st, label, cls] of nextStatus) { %>
          <form method="post" action="/einsaetze/<%= event.id %>/status" class="inline" <% if (st === 'abgesagt' || st === 'abgeschlossen') { %>data-confirm="<%= st === 'abgesagt' ? 'Einsatz wirklich absagen?' : 'Einsatz abschliessen? Danach sind die Daten schreibgeschützt.' %>"<% } %>>
            <input type="hidden" name="_csrf" value="<%= csrfToken %>"><input type="hidden" name="status" value="<%= st %>">
            <% if (event.status === 'abgeschlossen') { %><input type="text" name="reason" required placeholder="Begründung" class="mb-s"><% } %>
            <button class="btn btn-sm <%= cls %>" type="submit"><%= label %></button>
          </form>
        <% } %>
        </div>
      </div>
      <div class="card-body sep-top">
        <form method="post" action="/einsaetze/<%= event.id %>/formular" class="switch" data-autosubmit>
          <input type="hidden" name="_csrf" value="<%= csrfToken %>">
          <input type="hidden" name="show_in_form" value="<%= event.show_in_form ? '0' : '1' %>">
          <input type="checkbox" <%= event.show_in_form ? 'checked' : '' %> <%= event.status !== 'veroeffentlicht' ? 'disabled' : '' %> data-submit-on-change aria-label="Im Formular anzeigen">
          <div><strong>Im Formular anzeigen</strong>
            <div class="small muted">
              <% if (event.status !== 'veroeffentlicht') { %>Wird beim Veröffentlichen automatisch eingeschaltet.
              <% } else if (inForm) { %>Steht im Anmeldeformular bis <%= h.fmtLocal(lastEnd) %>.
              <% } else if (event.show_in_form) { %>Ende der letzten Schicht ist vorbei – automatisch aus dem Formular.
              <% } else { %>Von Hand aus dem Formular genommen.<% } %>
            </div>
          </div>
        </form>
        <a class="small link no-print" href="/einsaetze/<%= event.id %>/formular">So sieht der Einsatz im Formular aus →</a>
        <% if (inForm && s.full) { %><div class="callout orange mt-s">Alle Schichten sind voll – Einsatz aus dem Formular nehmen?</div><% } %>
      </div>
    </div>
    <div class="card" id="einsatzleiter">
      <div class="card-head"><h2>Einsatzleiter-Zugriff</h2></div>
      <div class="card-body">
        <p class="small muted">Login für Einsatzleiter: Freigegebene Konten sehen diesen Einsatz mit Angaben und Teilnehmerliste – nur lesen. Unabhängig von der Funktion EL.</p>
        <% for (const u of leaderSuggestions) { %>
          <form method="post" action="/einsaetze/<%= event.id %>/einsatzleiter" class="callout mb-s fn-suggest">
            <input type="hidden" name="_csrf" value="<%= csrfToken %>"><input type="hidden" name="user_id" value="<%= u.id %>">
            <span><strong><%= u.display_name %></strong> ist als <%= u.func.name %> (<%= u.func.short %>) eingeteilt und hat ein Einsatzleiter-Konto.</span>
            <button class="btn btn-sm btn-primary" type="submit">Freigeben</button>
          </form>
        <% } %>
        <% if (leaderAccess.length) { %>
          <ul class="plain-list mb-s">
          <% for (const l of leaderAccess) { %>
            <li class="row between">
              <span><strong><%= l.display_name %></strong><% if (!l.active) { %> <%- h.badge('deaktiviert', 'gray') %><% } %><br><span class="small muted">seit <%= h.fmtDateTime(l.granted_at) %><%= l.granted_by_name ? ` · ${l.granted_by_name}` : '' %></span></span>
              <form method="post" action="/einsaetze/<%= event.id %>/einsatzleiter/<%= l.id %>/entfernen" class="inline" data-confirm="Freigabe für <%= l.display_name %> entfernen?">
                <input type="hidden" name="_csrf" value="<%= csrfToken %>"><button class="btn btn-sm btn-ghost" type="submit">Entfernen</button>
              </form>
            </li>
          <% } %>
          </ul>
        <% } %>
        <% if (leaderCandidates.length) { %>
          <% const suggested = leaderCandidates.find((u) => event.leader_person_id && u.person_id === event.leader_person_id); %>
          <form method="post" action="/einsaetze/<%= event.id %>/einsatzleiter" class="row">
            <input type="hidden" name="_csrf" value="<%= csrfToken %>">
            <select name="user_id" aria-label="Einsatzleiter wählen" required>
              <% if (!suggested) { %><option value="">Einsatzleiter wählen …</option><% } %>
              <% for (const u of leaderCandidates) { %><option value="<%= u.id %>" <%= suggested && suggested.id === u.id ? 'selected' : '' %>><%= u.display_name %></option><% } %>
            </select>
            <button class="btn btn-sm" type="submit">Freigeben</button>
          </form>
        <% } else if (!leaderAccess.length) { %>
          <p class="small muted">Es gibt noch kein Konto mit der Rolle «Einsatzleiter». <%= isAdmin ? 'Unter Einstellungen › Benutzer anlegen.' : 'Ein Admin legt es unter Einstellungen › Benutzer an.' %></p>
        <% } %>
      </div>
    </div>
  </div>
</div>
