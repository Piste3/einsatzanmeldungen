<% const base = `/einsaetze/${event.id}/anfragen`; const nowL = h.localNow(); %>
<form class="filters" method="get" action="<%= base %>" data-autosubmit>
  <select name="status"><option value="">Alle Anfragestatus</option><% for (const [k, v] of Object.entries(h.labels.INQUIRY_STATUS)) { %><option value="<%= k %>" <%= filters.status === k ? 'selected' : '' %>><%= v.label %></option><% } %></select>
  <select name="team"><option value="">Alle Mannschaften</option><% for (const t of teams) { %><option value="<%= t.id %>" <%= Number(filters.team) === t.id ? 'selected' : '' %>><%= t.name %></option><% } %></select>
  <input type="search" name="q" value="<%= filters.q %>" placeholder="Name filtern …">
</form>
<div class="card">
  <div class="card-head"><h2>Personen ohne Anmeldung <span class="hint">aktive Mitglieder, die sich noch nicht gemeldet haben, und alle bereits Angefragten</span></h2></div>
  <form method="post" action="<%= base %>/vorsehen" id="plan" class="bulkbar" data-bulk>
    <input type="hidden" name="_csrf" value="<%= csrfToken %>">
    <label class="check"><input type="checkbox" data-select-all="person_ids"> <span class="count" data-selected-count>0 ausgewählt</span></label>
    <button class="btn btn-sm" type="submit">Zur Anfrage vorsehen</button>
  </form>
  <div class="table-wrap">
    <table>
      <thead><tr><th class="check-col"></th><th>Person</th><th>Mobil</th><th>Anfrage</th><th>Kontaktversuche</th><th class="actions-col"></th></tr></thead>
      <tbody>
      <% if (!list.length) { %><tr><td colspan="6" class="empty">Alle aktiven Mitglieder haben sich gemeldet.</td></tr><% } %>
      <% for (const r of list) { %>
        <tr data-row-id="i<%= r.person_id %>-<%= r.attempts.length %>" class="<%= r.inquiry_status === 'whatsapp' ? 'highlight' : '' %>">
          <td class="check-col"><input type="checkbox" name="person_ids" value="<%= r.person_id %>" form="plan" aria-label="Auswählen"></td>
          <td><%- h.rank(r.rank_short) %><a href="/personen/<%= r.person_id %>"><strong><%= r.first_name %> <%= r.last_name %></strong></a><% if (r.teams) { %><span class="sub"><%= r.teams %></span><% } %></td>
          <td class="nowrap"><% if (r.mobile) { %><a class="link" href="tel:<%= r.mobile.replace(/\s/g, '') %>"><%= r.mobile %></a><% } else { %><span class="muted">–</span><% } %></td>
          <td><%- h.inquiryBadge(r.inquiry_status) %></td>
          <td>
            <% if (!r.attempts.length) { %><span class="muted small">noch nicht kontaktiert</span><% } %>
            <div class="attempts">
              <% for (const a of r.attempts) { %>
                <div class="attempt"><span class="ch <%= a.channel === 'whatsapp' ? 'wa' : '' %>"><%= h.labels.CHANNEL[a.channel].short %></span><%= h.fmtDateShort(a.contacted_at.slice(0, 10)) %> <%= a.contacted_at.slice(11, 16) %> · <%= a.sent_by_name %> · <%= { nicht_erreicht: 'nicht erreicht', whatsapp: 'gesendet', zugesagt: 'zugesagt', abgesagt: 'abgesagt' }[a.result] %><%= a.note ? ` · «${a.note}»` : '' %></div>
              <% } %>
              <% if (r.inquiry_status === 'zugesagt' && r.registration_id) { %><span class="cell-sub">→ Anmeldung erstellt</span><% } %>
            </div>
          </td>
          <td class="actions-col right nowrap">
            <% if (r.inquiry_status === 'whatsapp') { %>
              <form method="post" action="<%= base %>/status" class="inline"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><input type="hidden" name="person_id" value="<%= r.person_id %>"><input type="hidden" name="status" value="zugesagt"><button class="btn btn-xs" type="submit">Zugesagt</button></form>
              <form method="post" action="<%= base %>/status" class="inline"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><input type="hidden" name="person_id" value="<%= r.person_id %>"><input type="hidden" name="status" value="abgesagt"><button class="btn btn-xs" type="submit">Abgesagt</button></form>
            <% } %>
            <% if (r.inquiry_status !== 'zugesagt') { %>
              <button class="btn btn-sm" type="button" data-open-dialog="attempt" data-person="<%= r.person_id %>" data-who="<%= `${r.rank_short ? r.rank_short + ' ' : ''}${r.first_name} ${r.last_name}` %>" data-channel="<%= r.inquiry_status === 'nicht_erreicht' ? 'whatsapp' : 'telefon' %>">Erfassen</button>
            <% } %>
          </td>
        </tr>
      <% } %>
      </tbody>
    </table>
  </div>
</div>
<%- include('../partials/attempt-dialog', { action: `${base}/versuch`, back: base }) %>
