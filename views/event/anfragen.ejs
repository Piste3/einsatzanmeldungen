<%
  const base = `/einsaetze/${event.id}/anfragen`;
  const locked = (event.status === 'abgeschlossen' && user.role !== 'admin') || event.status === 'abgesagt';
  const chipOrder = ['offen', 'nicht_erreicht', 'whatsapp', 'unsicher', 'zugesagt', 'angemeldet', 'abgesagt'];
  const label = (st) => h.labels.INQUIRY_ROW[st] || h.labels.INQUIRY_STATUS[st];
  const resultText = { nicht_erreicht: 'nicht erreicht', whatsapp: 'gesendet', zugesagt: 'zugesagt', unsicher: 'unsicher', abgesagt: 'abgesagt' };
%>
<div class="row-between mb">
  <div class="chips">
    <a class="chip badge-gray <%= !filters.status ? 'active' : '' %>" href="<%= h.withQuery(base, { team: filters.team, q: filters.q, sort: filters.sort !== 'rang' ? filters.sort : undefined }) %>">Alle · <%= list.total %></a>
    <% for (const st of chipOrder) { if (!list.counts[st]) continue; const l = label(st); %>
      <a class="chip badge-<%= l.tone %> <%= filters.status === st ? 'active' : '' %>" href="<%= h.withQuery(base, { status: st, team: filters.team, q: filters.q, sort: filters.sort !== 'rang' ? filters.sort : undefined }) %>"><%= l.label %> · <%= list.counts[st] %></a>
    <% } %>
  </div>
  <form class="filters" method="get" action="<%= base %>" data-autosubmit style="margin:0">
    <input type="hidden" name="status" value="<%= filters.status %>">
    <select name="team"><option value="">Alle Mannschaften</option><% for (const t of teams) { %><option value="<%= t.id %>" <%= Number(filters.team) === t.id ? 'selected' : '' %>><%= t.name %></option><% } %></select>
    <select name="sort" aria-label="Sortierung"><option value="rang" <%= filters.sort === 'rang' ? 'selected' : '' %>>Rang: tief → hoch</option><option value="rang_ab" <%= filters.sort === 'rang_ab' ? 'selected' : '' %>>Rang: hoch → tief</option></select>
    <input type="search" name="q" value="<%= filters.q %>" placeholder="Name filtern …">
  </form>
</div>
<% if (locked) { %><div class="flash flash-info">Der Einsatz ist <%= h.labels.EVENT_STATUS[event.status].label.toLowerCase() %>. Anfragen lassen sich nur noch ansehen.</div><% } %>
<div class="card">
  <details class="card-head nachfassen-head help-fold" data-remember="hilfe-nachfassen" open>
    <summary><h2>Nachfassen</h2><span class="hint help-fold-hint">So geht es</span></summary>
    <ol class="nachfassen-steps">
      <li>Person anrufen oder per WhatsApp anschreiben (Nummer bzw. Sprechblase anklicken).</li>
      <li>Mit <strong>Erfassen</strong> festhalten, wie es gelaufen ist.</li>
      <li>Kommt die Antwort später, in der Zeile <strong>Zugesagt</strong> oder <strong>Abgesagt</strong> klicken.</li>
    </ol>
    <p class="hint">Mehreren dieselbe WhatsApp geschickt? Links ankreuzen und für alle auf einmal erfassen.</p>
  </details>
  <% if (!locked) { %>
  <form id="auswahl" class="bulkbar" data-bulk>
    <label class="check"><input type="checkbox" data-select-all="person_ids"> <span class="count" data-selected-count data-empty-text="Alle auswählen">Alle auswählen</span></label>
    <button class="btn btn-sm" type="button" hidden data-needs-selection data-count-text="Kontakt für {n} erfassen" data-open-dialog="attempt" data-bulk-dialog="auswahl" data-channel="whatsapp">Kontakt erfassen</button>
  </form>
  <% } %>
  <div class="table-wrap">
    <table>
      <thead><tr><th class="check-col"></th><th>Person</th><th>Mobil</th><th>Status</th><th>Kontaktversuche</th><th class="actions-col"></th></tr></thead>
      <tbody>
      <% if (!list.length) { %><tr><td colspan="6" class="empty"><%= list.total ? 'Keine Treffer für diesen Filter.' : 'Alle aktiven Mitglieder haben sich gemeldet.' %></td></tr><% } %>
      <%
        const isClosed = (r) => ['zugesagt', 'angemeldet', 'abgesagt'].includes(r.state);
        const openRows = list.filter((r) => !isClosed(r));
        const closedRows = list.filter(isClosed);
        const grouped = !filters.status && openRows.length > 0 && closedRows.length > 0;
        const ordered = grouped ? [...openRows, ...closedRows] : Array.from(list);
      %>
      <% for (const r of ordered) { const done = ['zugesagt', 'angemeldet'].includes(r.state); const wa = h.waLink(r.mobile); %>
        <% if (grouped && r === openRows[0]) { %><tr class="group-row"><td colspan="6"><strong>Noch offen</strong> <span class="muted">· <%= openRows.length %></span></td></tr><% } %>
        <% if (grouped && r === closedRows[0]) { %><tr class="group-row"><td colspan="6"><strong>Erledigt</strong> <span class="muted">· <%= closedRows.length %> (zugesagt, angemeldet oder abgesagt)</span></td></tr><% } %>
        <tr data-row-id="i<%= r.person_id %>-<%= r.attempts.length %>-<%= r.state %>" class="<%= r.state === 'whatsapp' ? 'highlight' : '' %> <%= done || r.state === 'abgesagt' ? 'row-muted' : '' %>">
          <td class="check-col"><% if (!locked && !done) { %><input type="checkbox" name="person_ids" value="<%= r.person_id %>" form="auswahl" aria-label="Auswählen"><% } %></td>
          <td><%- h.rank(r.rank_short) %><a href="/personen/<%= r.person_id %>"><strong><%= r.first_name %> <%= r.last_name %></strong></a><% if (r.teams) { %><span class="sub"><%= r.teams %></span><% } %></td>
          <td class="nowrap">
            <% if (r.mobile) { %>
              <a class="link" href="tel:<%= r.mobile.replace(/\s/g, '') %>" title="Anrufen"><%= r.mobile %></a>
              <% if (wa) { %><a class="icon-link" href="<%= wa %>" target="_blank" rel="noopener" title="WhatsApp-Chat öffnen"><%- h.icon('chat') %></a><% } %>
            <% } else { %><span class="muted">–</span><% } %>
          </td>
          <td>
            <%- h.inquiryBadge(r.state) %>
            <% if (r.state === 'angemeldet') { %><a class="cell-sub link" href="/einsaetze/<%= event.id %>/anmeldungen?q=<%= encodeURIComponent(r.last_name) %>"><%= h.labels.REG_STATUS[r.reg_status].short %> · <%= h.labels.SOURCE[r.reg_source] %></a><% } %>
            <% if (r.state === 'zugesagt' && r.registration_id) { %><a class="cell-sub link" href="/einsaetze/<%= event.id %>/anmeldungen?q=<%= encodeURIComponent(r.last_name) %>">→ Anmeldung erstellt</a><% } %>
          </td>
          <td>
            <% if (!r.attempts.length) { %><span class="muted">–</span><% } %>
            <div class="attempts">
              <% r.attempts.forEach((a, idx) => { const isLast = idx === r.attempts.length - 1; %>
                <div class="attempt"><span class="ch <%= { whatsapp: 'wa', muendlich: 'md' }[a.channel] || '' %>"><%= h.labels.CHANNEL[a.channel].short %></span><%= h.fmtDateShort(a.contacted_at.slice(0, 10)) %> <%= a.contacted_at.slice(11, 16) %> · <%= a.sent_by_name %> · <%= resultText[a.result] %><%= a.note ? ` · «${a.note}»` : '' %>
                  <% if (isLast && !locked) { %><form method="post" action="<%= base %>/versuch/<%= a.id %>/loeschen" class="inline" data-confirm="<%= a.result === 'zugesagt' && r.registration_id ? 'Diesen Kontaktversuch zurücknehmen? Die daraus erstellte Anmeldung wird ebenfalls gelöscht.' : 'Diesen Kontaktversuch zurücknehmen?' %>"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><button class="icon-btn" type="submit" title="Zurücknehmen (falsch erfasst)"><%- h.icon('undo') %></button></form><% } %>
                </div>
              <% }) %>
            </div>
          </td>
          <td class="actions-col right nowrap">
            <% if (!locked && !done) { %>
              <% if (['whatsapp', 'nicht_erreicht', 'unsicher'].includes(r.state)) { %>
                <form method="post" action="<%= base %>/status" class="inline"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><input type="hidden" name="person_id" value="<%= r.person_id %>"><input type="hidden" name="status" value="zugesagt"><button class="btn btn-xs" type="submit" title="Antwort ist gekommen: kommt">Zugesagt</button></form>
                <form method="post" action="<%= base %>/status" class="inline"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><input type="hidden" name="person_id" value="<%= r.person_id %>"><input type="hidden" name="status" value="abgesagt"><button class="btn btn-xs" type="submit" title="Antwort ist gekommen: kommt nicht">Abgesagt</button></form>
              <% } %>
              <button class="btn btn-sm" type="button" data-open-dialog="attempt" data-person="<%= r.person_id %>" data-who="<%= `${r.rank_short ? r.rank_short + ' ' : ''}${r.first_name} ${r.last_name}` %>" data-channel="<%= ['nicht_erreicht', 'whatsapp'].includes(r.state) ? 'whatsapp' : 'telefon' %>">Erfassen</button>
            <% } else if (!locked && done) { %>
              <button class="icon-btn" type="button" data-reset-person data-person="<%= r.person_id %>" data-who="<%= `${r.rank_short ? r.rank_short + ' ' : ''}${r.first_name} ${r.last_name}` %>" title="Alles zurücksetzen: Kontaktversuche, Anmeldung und Schichten für diesen Einsatz löschen"><%- h.icon('undo') %></button>
            <% } %>
          </td>
        </tr>
      <% } %>
      </tbody>
    </table>
  </div>
</div>
<%- include('../partials/attempt-dialog', { action: `${base}/versuch`, back: h.withQuery(base, query, {}) }) %>
