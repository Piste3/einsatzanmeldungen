<%
  const base = `/einsaetze/${event.id}/anmeldungen`;
  const chipOrder = ['neu', 'unsicher', 'rueckfrage', 'bestaetigt', 'warteliste', 'zurueckgezogen', 'abgesagt', 'ungueltig'];
  const back = h.withQuery(base, query, {});
  const shiftName = (id) => (event.shifts.find((s) => s.id === id) || {}).name;
%>
<div class="row-between mb">
  <div class="chips">
    <a class="chip badge-gray <%= !filters.status ? 'active' : '' %>" href="<%= h.withQuery(base, { q: filters.q, sort: filters.sort !== 'rang' ? filters.sort : undefined }) %>">Alle · <%= total %></a>
    <% for (const st of chipOrder) { if (!counts[st] && !['neu','bestaetigt'].includes(st)) continue; const l = h.labels.REG_STATUS[st]; %>
      <a class="chip badge-<%= l.tone %> <%= filters.status === st ? 'active' : '' %>" href="<%= h.withQuery(base, { status: st, q: filters.q, sort: filters.sort !== 'rang' ? filters.sort : undefined }) %>"><%= l.label %> · <%= counts[st] || 0 %></a>
    <% } %>
  </div>
  <div class="row">
    <select name="sort" form="anm-filter" aria-label="Sortierung" style="width:auto"><option value="rang" <%= filters.sort === 'rang' ? 'selected' : '' %>>Rang: tief → hoch</option><option value="rang_ab" <%= filters.sort === 'rang_ab' ? 'selected' : '' %>>Rang: hoch → tief</option><option value="funktion" <%= filters.sort === 'funktion' ? 'selected' : '' %>>Funktion, dann Rang</option><option value="neu" <%= filters.sort === 'neu' ? 'selected' : '' %>>neueste zuerst</option></select>
    <form method="get" action="<%= base %>" class="search" id="anm-filter" data-autosubmit><input type="hidden" name="status" value="<%= filters.status %>"><input type="search" name="q" value="<%= filters.q %>" placeholder="Filtern"></form>
    <button class="btn btn-sm" type="button" data-open-dialog="add-reg">+ Anmeldung erfassen</button>
  </div>
</div>

<div class="card">
  <form method="post" action="/einsaetze/<%= event.id %>/anmeldungen/sammel" id="bulk" class="bulkbar" data-bulk>
    <input type="hidden" name="_csrf" value="<%= csrfToken %>">
    <input type="hidden" name="back" value="<%= back %>">
    <label class="check"><input type="checkbox" data-select-all="ids"> <span class="count" data-selected-count data-empty-text="Alle auswählen">Alle auswählen</span></label>
    <button class="btn btn-sm btn-primary" type="submit" name="status_button" value="bestaetigt" hidden data-needs-selection>Bestätigen</button>
    <select name="status_select" data-submit-on-change aria-label="Status ändern" hidden data-needs-selection>
      <option value="">Status ändern …</option>
      <% for (const st of h.labels.REG_STATUS_MANUAL) { %><option value="<%= st %>"><%= h.labels.REG_STATUS[st].label %></option><% } %>
    </select>
    <select name="function_select" data-submit-on-change aria-label="Funktion zuweisen" hidden data-needs-selection>
      <option value="">Funktion zuweisen …</option>
      <% for (const f of functionOptions) { %><option value="<%= f.id %>"><%= f.short %> · <%= f.name %></option><% } %>
    </select>
    <button class="btn btn-sm" type="submit" name="bulk_action" value="export" hidden data-needs-selection>Exportieren</button>
  </form>
  <% if (fnSummary.usesFunctions) { %>
    <div class="card-body fn-panel">
      <div class="fn-panel-head"><span>Funktionen Ist/Soll</span><a class="link small no-print" href="/einsaetze/<%= event.id %>/schichten#funktionen">Einteilen →</a></div>
      <%- include('../partials/fn-line', { fnSummary }) %>
    </div>
  <% } %>
  <div class="table-wrap">
    <table>
      <thead><tr><th class="check-col"></th><th>Person</th><th>Eingang</th><th>Schicht</th><th>Funktion</th><th>Bemerkung</th><th>Status</th><th class="actions-col"></th></tr></thead>
      <tbody>
      <% if (!list.length) { %><tr><td colspan="8" class="empty">Keine Anmeldungen<%= filters.status || filters.q ? ' mit diesem Filter' : '' %>.</td></tr><% } %>
      <%
        const groupDefs = [
          { key: 'offen', label: 'Zu bearbeiten', st: ['neu', 'unsicher', 'rueckfrage'] },
          { key: 'bestaetigt', label: 'Bestätigt', st: ['bestaetigt'] },
          { key: 'rest', label: 'Warteliste, abgemeldet, ungültig', st: null, collapsed: true },
        ];
        const groupOf = (r) => groupDefs.find((g) => g.st && g.st.includes(r.status)) || groupDefs.at(-1);
        const grouped = !filters.status && list.length > 0;
        const ordered = grouped ? groupDefs.flatMap((g) => list.filter((r) => groupOf(r) === g)) : list;
        let lastGroup = null;
      %>
      <% for (const r of ordered) { const diet = dietOf(r); const g = groupOf(r); %>
        <% if (grouped && g !== lastGroup) { lastGroup = g; const n = list.filter((x) => groupOf(x) === g).length; %>
          <tr class="group-row" data-group-head="<%= g.key %>"><td colspan="8">
            <% if (g.collapsed) { %><button type="button" class="group-toggle" data-toggle-group="<%= g.key %>" aria-expanded="false"><span class="chev" aria-hidden="true">▸</span> <%= g.label %> · <%= n %></button>
            <% } else { %><strong><%= g.label %></strong> <span class="muted">· <%= n %></span><% } %>
          </td></tr>
        <% } %>
        <tr data-row-id="r<%= r.id %>" class="<%= r.status === 'neu' ? 'highlight' : '' %>"<% if (grouped) { %> data-group="<%= g.key %>"<% if (g.collapsed) { %> hidden<% } %><% } %>>
          <td class="check-col"><input type="checkbox" name="ids" value="<%= r.id %>" form="bulk" aria-label="Auswählen"></td>
          <td>
            <% if (r.person_id) { %>
              <%- h.rank(r.rank_short) %><a href="/personen/<%= r.person_id %>"><strong><%= r.first_name %> <%= r.last_name %></strong></a>
              <span class="sub"><%= [r.match_type !== 'auto' ? h.labels.MATCH_TYPE[r.match_type] : '', r.teams].filter(Boolean).join(' · ') %><%= r.entered_name && r.match_type !== 'auto' && r.entered_name !== `${r.first_name} ${r.last_name}` && r.source === 'formular' ? ` · eingegeben «${r.entered_name}»` : '' %></span>
            <% } else { %>
              <strong class="link">«<%= r.entered_name %>»</strong>
              <span class="sub warn"><%= r.match_info || 'keine sichere Zuordnung' %> → <a class="link" href="/klaerungen?id=<%= r.id %>">Klärungen</a></span>
            <% } %>
            <% if (r.duplicate_count) { %><span class="sub"><%- h.badge(`${r.duplicate_count + 1}× abgeschickt`, 'gray') %></span><% } %>
          </td>
          <td class="nowrap"><%= h.labels.SOURCE[r.source] %><span class="sub"><%= h.fmtRelative(r.registered_at) %></span></td>
          <td>
            <% if (r.answer === 'nein') { %><span class="muted">–</span>
            <% } else if (r.assigned.length) { %><%= r.assigned.map((a) => a.name).join(' + ') %>
            <% } else if (r.wishes.length) { %><span class="muted">Wunsch: <%= r.wishes.map(shiftName).filter(Boolean).join(' + ') %></span>
            <% } else { %><span class="muted">–</span><% } %>
          </td>
          <td>
            <% if (r.person_id && !['zurueckgezogen', 'abgesagt', 'ungueltig'].includes(r.status)) { %>
              <form method="post" action="/anmeldungen/<%= r.id %>/funktion" data-autosubmit class="fn-select"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><input type="hidden" name="back" value="<%= back %>">
                <select name="function_id" data-submit-on-change aria-label="Funktion von <%= r.person_name %>" class="<%= r.func.is_default ? 'fn-is-default' : '' %>">
                  <% for (const f of functionOptions) { %><option value="<%= f.id %>" <%= r.func.id === f.id ? 'selected' : '' %> title="<%= f.name %>"><%= f.short %></option><% } %>
                  <% if (!functionOptions.some((f) => f.id === r.func.id)) { %><option value="<%= r.func.id %>" selected><%= r.func.short %></option><% } %>
                </select></form>
            <% } else { %><span class="muted">–</span><% } %>
          </td>
          <td class="small">
            <%= r.remark || '' %><% if (!r.remark && !r.internal_note && !diet) { %><span class="muted">–</span><% } %>
            <% if (r.internal_note) { %><span class="sub">Intern: <%= r.internal_note %></span><% } %>
            <% if (diet) { %><span class="sub">Verpflegung: <%= diet %></span><% } %>
          </td>
          <td><%- h.regBadge(r.status) %></td>
          <td class="actions-col right nowrap">
            <% if (r.status === 'unsicher' && !r.person_id) { %>
              <a class="btn btn-sm" href="/klaerungen?id=<%= r.id %>">Zuordnen</a>
            <% } else if (r.status === 'neu') { %>
              <form method="post" action="/anmeldungen/<%= r.id %>/status" class="inline"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><input type="hidden" name="status" value="bestaetigt"><input type="hidden" name="expected" value="neu"><input type="hidden" name="back" value="<%= back %>"><button class="btn btn-sm" type="submit">Bestätigen</button></form>
            <% } %>
            <details class="menu">
              <summary class="btn btn-sm btn-ghost" aria-label="Weitere Aktionen">⋯</summary>
              <div class="menu-list">
                <% if (r.person_id) { for (const st of h.labels.REG_STATUS_MANUAL.filter((x) => x !== r.status)) { %>
                  <form method="post" action="/anmeldungen/<%= r.id %>/status"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><input type="hidden" name="status" value="<%= st %>"><input type="hidden" name="expected" value="<%= r.status %>"><input type="hidden" name="back" value="<%= back %>"><button type="submit">→ <%= h.labels.REG_STATUS[st].label %></button></form>
                <% } %><div class="sep"></div><% } %>
                <button type="button" data-open-dialog="note" data-action="/anmeldungen/<%= r.id %>/notiz" data-version="<%= r.version %>" data-note="<%= r.internal_note || '' %>" data-who="<%= r.person_name || r.entered_name %>">Interne Bemerkung …</button>
                <button type="button" data-open-dialog="reassign" data-action="/anmeldungen/<%= r.id %>/zuordnen" data-who="<%= r.person_name || r.entered_name %>">Andere Person zuordnen …</button>
                <form method="post" action="/anmeldungen/<%= r.id %>/status" data-confirm="Als ungültig markieren (z. B. doppelt oder Test)?"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><input type="hidden" name="status" value="ungueltig"><input type="hidden" name="back" value="<%= back %>"><button type="submit">Als ungültig markieren</button></form>
                <div class="sep"></div>
                <form method="post" action="/anmeldungen/<%= r.id %>/loeschen" data-confirm="<%= ['zurueckgezogen', 'abgesagt'].includes(r.status) ? 'Abmeldung' : 'Anmeldung' %> von <%= r.person_name || r.entered_name %> endgültig löschen?&#10;&#10;Die Person gilt danach wieder als «ohne Rückmeldung», als wäre nie etwas eingegangen. Das lässt sich nicht rückgängig machen."><input type="hidden" name="_csrf" value="<%= csrfToken %>"><input type="hidden" name="back" value="<%= back %>"><button type="submit" class="btn-danger">Löschen (zurücksetzen)</button></form>
              </div>
            </details>
          </td>
        </tr>
      <% } %>
      </tbody>
    </table>
  </div>
</div>

<dialog id="add-reg">
  <form method="post" action="/einsaetze/<%= event.id %>/anmeldungen">
    <input type="hidden" name="_csrf" value="<%= csrfToken %>">
    <div class="card-head"><h2>Anmeldung erfassen</h2></div>
    <div class="card-body">
      <div class="field"><label>Person</label><select name="person_id" required data-search><option value="">– wählen –</option><% for (const p of available) { %><option value="<%= p.id %>"><%= p.last_name %> <%= p.first_name %><%= p.rank_short ? ` (${p.rank_short})` : '' %></option><% } %></select></div>
      <div class="field"><label>Quelle</label><select name="source"><option value="manuell">Manuell</option><option value="telefon">Telefon</option><option value="whatsapp">WhatsApp</option><option value="muendlich">Mündlich</option></select></div>
      <% if (event.shifts.length > 1) { %><div class="field"><label>Schichten</label><% for (const s of event.shifts) { %><label class="check"><input type="checkbox" name="shift_ids" value="<%= s.id %>"> <%= s.name %> <span class="muted"><%= h.fmtShiftWhen(s, h.isMultiDay(event)) %></span></label><% } %></div><% } %>
      <div class="field"><label>Bemerkung</label><input type="text" name="remark"></div>
    </div>
    <div class="card-foot"><button class="btn btn-ghost" type="button" data-close-dialog>Abbrechen</button><button class="btn btn-primary" type="submit">Speichern</button></div>
  </form>
</dialog>

<dialog id="note">
  <form method="post" action="">
    <input type="hidden" name="_csrf" value="<%= csrfToken %>"><input type="hidden" name="version" value=""><input type="hidden" name="back" value="<%= back %>">
    <div class="card-head"><h2>Interne Bemerkung <span class="hint" data-who></span></h2></div>
    <div class="card-body"><textarea name="internal_note" rows="4"></textarea></div>
    <div class="card-foot"><button class="btn btn-ghost" type="button" data-close-dialog>Abbrechen</button><button class="btn btn-primary" type="submit">Speichern</button></div>
  </form>
</dialog>

<dialog id="reassign">
  <form method="post" action="">
    <input type="hidden" name="_csrf" value="<%= csrfToken %>"><input type="hidden" name="back" value="<%= back %>">
    <div class="card-head"><h2>Andere Person zuordnen <span class="hint" data-who></span></h2></div>
    <div class="card-body">
      <div class="field"><label>Neue Person</label><select name="person_id" required data-search><option value="">– wählen –</option><% for (const p of available) { %><option value="<%= p.id %>"><%= p.last_name %> <%= p.first_name %><%= p.rank_short ? ` (${p.rank_short})` : '' %></option><% } %></select></div>
      <label class="check"><input type="checkbox" name="keep_shifts" value="1" checked> Schichtzuteilungen mitnehmen</label>
      <input type="hidden" name="keep_shifts" value="0">
      <p class="small muted mt-s">Die Umhängung wird im Verlauf festgehalten (vorherige und neue Person, wer, wann).</p>
    </div>
    <div class="card-foot"><button class="btn btn-ghost" type="button" data-close-dialog>Abbrechen</button><button class="btn btn-primary" type="submit">Zuordnen</button></div>
  </form>
</dialog>
