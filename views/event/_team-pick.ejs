<%
  // Auswahl der vorgesehenen Mannschaften einer Schicht (leer = alle). Häkchen im Klappmenü, gespeichert mit der ganzen Tabelle.
  const opts = teamList.filter((t) => t.active || selected.includes(t.id));
  const names = opts.filter((t) => selected.includes(t.id)).map((t) => t.name).join(', ');
%>
<details class="menu team-pick" data-team-pick>
  <summary class="btn btn-sm" aria-label="<%= label %>"><span data-team-label><%= names || 'alle' %></span> ▾</summary>
  <div class="menu-list team-pick-list">
    <input type="hidden" name="teams_shown<%= key %>" value="1">
    <% if (!opts.length) { %><span class="small muted">Noch keine Mannschaften – unter Einstellungen › Auswahllisten anlegen.</span><% } %>
    <% for (const t of opts) { %><label class="check"><input type="checkbox" name="teams<%= key %>" value="<%= t.id %>" data-name="<%= t.name %>" <%= selected.includes(t.id) ? 'checked' : '' %>> <%= t.name %></label><% } %>
    <span class="small muted team-pick-hint">Nichts angekreuzt = alle Mannschaften.</span>
  </div>
</details>
