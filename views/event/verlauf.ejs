<div class="card">
  <div class="card-head"><h2>Verlauf <span class="hint">jede Änderung mit Person und Zeitpunkt</span></h2></div>
  <div class="table-wrap">
    <table>
      <thead><tr><th>Zeitpunkt</th><th>Benutzer</th><th>Ereignis</th></tr></thead>
      <tbody>
      <% if (!log.length) { %><tr><td colspan="3" class="empty">Noch keine Einträge.</td></tr><% } %>
      <% for (const l of log) { let d = null; try { d = l.details ? JSON.parse(l.details) : null; } catch (err) {} %>
        <tr data-row-id="a<%= l.id %>">
          <td class="nowrap"><%= h.fmtDateTime(l.created_at) %></td>
          <td class="nowrap"><%= l.user_name || 'System' %></td>
          <td><%= l.summary %>
            <% if (d && l.action === 'update') { %><span class="sub"><% for (const [k, v] of Object.entries(d)) { if (!v || typeof v !== 'object' || !('alt' in v)) continue; %><%= k %>: «<%= String(v.alt ?? '–').slice(0, 60) %>» → «<%= String(v.neu ?? '–').slice(0, 60) %>»<br><% } %></span><% } %>
          </td>
        </tr>
      <% } %>
      </tbody>
    </table>
  </div>
</div>
