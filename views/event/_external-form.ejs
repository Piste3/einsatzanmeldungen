<%
  // Formular für eine externe Abteilung (neu: x = null). Erwartet: event, unitOptions, csrfToken, back (optional)
  const isNewExt = !x;
  const multiShift = event.shifts.length > 1;
  const fid = isNewExt ? 'ext-new' : `ext-${x.id}`;
%>
<form method="post" action="/einsaetze/<%= event.id %>/externe<%= isNewExt ? '' : `/${x.id}` %>" class="card-body ext-form" id="<%= fid %>">
  <input type="hidden" name="_csrf" value="<%= csrfToken %>">
  <% if (typeof back !== 'undefined' && back) { %><input type="hidden" name="back" value="<%= back %>"><% } %>
  <% if (event.status === 'abgeschlossen') { %><input type="hidden" name="reason" value="" data-reason><% } %>
  <div class="fields fields-2">
    <div class="field"><label for="<%= fid %>-unit">Abteilung <span class="req">*</span></label>
      <input id="<%= fid %>-unit" type="text" name="unit_name" list="ext-units" required maxlength="120" value="<%= isNewExt ? '' : x.unit_name %>" placeholder="z. B. VK NWS" autocomplete="off">
      <div class="field-hint">Aus der Liste wählen oder neuen Namen eintippen – er wird für das nächste Mal gespeichert.</div></div>
    <div class="field"><label for="<%= fid %>-count">Anzahl Personen <span class="req">*</span></label>
      <input id="<%= fid %>-count" type="number" name="person_count" min="1" max="9999" step="1" required value="<%= isNewExt ? '' : x.person_count %>" inputmode="numeric"></div>
  </div>
  <% if (typeof functionOptions !== 'undefined' && functionOptions.length > 1) { const cur = isNewExt ? null : x.func; %>
    <div class="field"><label for="<%= fid %>-fn">Funktion</label>
      <select id="<%= fid %>-fn" name="function_id">
        <% for (const f of functionOptions) { %><option value="<%= f.id %>" <%= (cur ? cur.id === f.id : f.is_default) ? 'selected' : '' %>><%= f.short %> · <%= f.name %></option><% } %>
        <% if (cur && !functionOptions.some((f) => f.id === cur.id)) { %><option value="<%= cur.id %>" selected><%= cur.short %> · <%= cur.name %></option><% } %>
      </select>
      <div class="field-hint">Meist <%= (functionOptions.find((f) => f.is_default) || {}).name || 'Einsatzteilnehmer' %>. Zählt so in «Funktionen» mit.</div></div>
  <% } %>
  <% if (multiShift) { %>
    <div class="field"><label>Schichten</label>
      <div class="row">
        <% for (const s of event.shifts) { %><label class="check"><input type="checkbox" name="shift_ids" value="<%= s.id %>" <%= isNewExt || x.allShifts || x.shiftIds.includes(s.id) ? 'checked' : '' %>> <%= s.name %></label><% } %>
      </div></div>
  <% } %>
  <%
    const dietRows = [...(isNewExt ? [] : x.dietList), { count: '', category: '', text: '' }];
    const dietRow = (d) => `<div class="diet-row" data-diet-row>
      <input type="number" name="diet_count" min="1" max="9999" step="1" inputmode="numeric" value="${h.escapeHtml(d.count)}" placeholder="Anz." aria-label="Anzahl Personen">
      <select name="diet_category" aria-label="Art"><option value="">Art wählen</option>${Object.entries(h.labels.DIET).map(([k, v]) => `<option value="${k}"${d.category === k ? ' selected' : ''}>${h.escapeHtml(v)}</option>`).join('')}</select>
      <input type="text" name="diet_text" maxlength="200" value="${h.escapeHtml(d.text)}" placeholder="Details, z. B. Nüsse" aria-label="Details">
      <button type="button" class="btn btn-sm btn-ghost" data-diet-remove title="Zeile entfernen" aria-label="Zeile entfernen">✕</button>
    </div>`;
  %>
  <div class="field"><label>Essenseinschränkungen <span class="muted small">(optional, nur Anzahl)</span></label>
    <div class="diet-rows" data-diet-rows>
      <% for (const d of dietRows) { %><%- dietRow(d) %><% } %>
    </div>
    <template data-diet-template><%- dietRow({ count: '', category: '', text: '' }) %></template>
    <button type="button" class="btn btn-sm btn-ghost" data-diet-add>+ weitere Einschränkung</button>
    <div class="field-hint">Zum Beispiel 2 × vegetarisch, 1 × Allergie «Nüsse». Wer nicht aufgeführt ist, isst ohne Einschränkung.</div></div>
  <div class="fields fields-2">
    <div class="field"><label for="<%= fid %>-contact">Kontakt <span class="muted small">(optional)</span></label>
      <input id="<%= fid %>-contact" type="text" name="contact" maxlength="500" value="<%= isNewExt ? '' : x.contact || '' %>" placeholder="z. B. Hptm Muster, 079 123 45 67"></div>
    <div class="field"><label for="<%= fid %>-note">Bemerkung <span class="muted small">(optional)</span></label>
      <input id="<%= fid %>-note" type="text" name="note" maxlength="500" value="<%= isNewExt ? '' : x.note || '' %>"></div>
  </div>
  <div class="row">
    <button class="btn btn-sm btn-primary" type="submit"><%= isNewExt ? 'Hinzufügen' : 'Speichern' %></button>
  </div>
</form>
