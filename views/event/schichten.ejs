<% const multi = event.shifts.length > 1; const multiDay = h.isMultiDay(event); const back = `/einsaetze/${event.id}/schichten`; const overlapNames = new Set(overlaps.map((o) => o.person)); %>
<% for (const o of overlaps) { %>
  <div class="hint-bar"><span class="tag tag-yellow">Hinweis</span><span><strong><%= o.person %></strong> ist beiden Schichten zugeteilt (<%= o.shifts.join(', ') %>) – die Schichten überschneiden sich von <%= o.from %> bis <%= o.to %>.</span></div>
<% } %>
<% if (!event.date_from) { %>
  <div class="callout mb">Dieser Einsatz hat noch kein Datum. Trage unten bei jeder Schicht ihren Tag ein. In der untersten Zeile kommt eine weitere Schicht dazu, auch an einem anderen Tag.</div>
<% } else if (!multi) { %>
  <div class="callout mb">Dieser Einsatz hat eine Schicht. Jede Anmeldung gilt automatisch für diese Schicht – es gibt nichts zu verteilen.</div>
<% } %>
<% if (multi && unassigned.length) { %>
  <div class="card mb">
    <div class="card-head"><h2>Noch keiner Schicht zugeteilt <span class="hint"><%= unassigned.length %> Anmeldungen</span></h2></div>
    <% for (const r of unassigned) { %>
      <div class="shift-row">
        <span class="name"><%- h.rank(r.rank_short) %><a href="/personen/<%= r.person_id %>"><%= r.first_name %> <%= r.last_name %></a><% if (!r.func.is_default) { %> <span class="fn-tag" title="<%= r.func.name %>"><%= r.func.short %></span><% } %></span>
        <%- h.regBadge(r.status) %>
        <form method="post" action="/anmeldungen/<%= r.id %>/schichten" data-autosubmit><input type="hidden" name="_csrf" value="<%= csrfToken %>"><input type="hidden" name="back" value="<%= back %>">
          <select name="shift_ids" data-submit-on-change aria-label="Schicht zuteilen"><option value="">zuteilen …</option><% for (const c of combos) { %><option value="<%= c.value %>"><%= c.label %></option><% } %></select></form>
      </div>
    <% } %>
  </div>
<% } %>
<div class="shift-cols" id="funktionen">
  <% for (const col of columns) { const assignedIds = new Set(col.regs.map((r) => r.id)); %>
    <div class="card">
      <div class="card-head">
        <div><h2><%= col.name %></h2><span class="small muted"><%= h.fmtShiftWhen(col, multiDay) || 'Zeit offen' %><%= col.start_place ? ` · ${col.start_place}` : '' %></span><% if (col.rule) { %> <span class="tag tag-blue team-tag" title="Einschränkung der Schicht. Andere Personen können sich trotzdem anmelden.">nur <%= col.rule %></span><% } %></div>
        <div class="occ"><div class="occ-head"><span>Besetzung<%= col.extern ? ` · davon ${col.extern} extern` : '' %></span><strong><%= col.ist %> / <%= col.soll ?? '–' %><%= col.soll ? (col.ist >= col.soll ? ' · voll' : ` · ${col.missing} fehlen`) : '' %></strong></div><div class="bar <%= col.tone %>"><span style="width:<%= h.pct(col.ist, col.soll) %>%"></span></div></div>
        <% const fx = fnSummary.shifts.find((x) => x.id === col.id); if (fx && fx.rows.some((r) => r.soll || (!r.is_default && r.ist))) { %><div class="fn-line small fn-line-shift"><% for (const f of fx.rows.filter((r) => r.soll || r.ist)) { %><span class="fn-chip tone-<%= f.tone %>" title="<%= f.name %>: <%= f.ist %> / <%= f.soll ?? '–' %><%= f.soll ? (f.over ? ` · ${f.over} zu viel` : f.missing ? ` · ${f.missing} ${f.missing === 1 ? 'fehlt' : 'fehlen'}` : ' · voll') : '' %>"><span class="fn-tag<%= f.is_default ? ' fn-default' : '' %>"><%= f.short %></span> <%= f.ist %>/<%= f.soll ?? '–' %></span><% } %></div><% } %>
      </div>
      <% if (!col.regs.length && !col.exts.length) { %><div class="empty">Noch niemand zugeteilt.</div><% } %>
      <% for (const r of col.regs) { const current = r.assigned.map((a) => a.id).join(','); %>
        <div class="shift-row <%= overlapNames.has(`${r.rank_short ? r.rank_short + ' ' : ''}${r.first_name} ${r.last_name}`) ? 'overlap' : '' %>" data-row-id="s<%= col.id %>-<%= r.id %>-<%= r.func.id %>">
          <span class="name"><%- h.rank(r.rank_short) %><a href="/personen/<%= r.person_id %>"><%= r.first_name %> <%= r.last_name %></a><% if (notPlanned(r, col)) { %> <span class="tag tag-gray tag-np" title="<%= r.teams ? `Mannschaft: ${r.teams}` : 'Keine Mannschaft' %> · vorgesehen: <%= col.rule %>">nicht vorgesehen</span><% } %></span>
          <%- h.badge(h.labels.REG_STATUS[r.status].short, h.labels.REG_STATUS[r.status].tone) %>
          <form method="post" action="/anmeldungen/<%= r.id %>/funktion" data-autosubmit class="fn-select"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><input type="hidden" name="back" value="<%= back %>">
            <select name="function_id" data-submit-on-change aria-label="Funktion von <%= r.first_name %> <%= r.last_name %>" title="Funktion (gilt für alle Schichten der Person)" class="<%= r.func.is_default ? 'fn-is-default' : '' %>">
              <% for (const f of functionOptions) { %><option value="<%= f.id %>" <%= r.func.id === f.id ? 'selected' : '' %> title="<%= f.name %>"><%= f.short %></option><% } %>
              <% if (!functionOptions.some((f) => f.id === r.func.id)) { %><option value="<%= r.func.id %>" selected><%= r.func.short %></option><% } %>
            </select></form>
          <% if (multi) { %>
            <form method="post" action="/anmeldungen/<%= r.id %>/schichten" data-autosubmit><input type="hidden" name="_csrf" value="<%= csrfToken %>"><input type="hidden" name="back" value="<%= back %>">
              <select name="shift_ids" data-submit-on-change aria-label="Umteilen">
                <% for (const c of combos) { %><option value="<%= c.value %>" <%= c.value === current ? 'selected' : '' %>><%= c.label %></option><% } %>
                <% if (!combos.some((c) => c.value === current)) { %><option value="<%= current %>" selected><%= r.assigned.map((a) => a.name).join(' + ') %></option><% } %>
                <option value="">aus allen Schichten entfernen</option>
              </select></form>
          <% } %>
        </div>
      <% } %>
      <% for (const x of col.exts) { %>
        <div class="shift-row ext" data-row-id="x<%= col.id %>-<%= x.id %>">
          <span class="name"><a href="/einsaetze/<%= event.id %>#externe"><strong><%= x.unit_name %></strong></a><% if (!x.func.is_default) { %> <span class="fn-tag" title="<%= x.func.name %>"><%= x.func.short %></span><% } %><%= x.contact ? ` · ${x.contact}` : '' %></span>
          <span class="tag tag-blue tag-ext">extern · <%= h.plural(x.person_count, 'Person', 'Personen') %></span>
        </div>
      <% } %>
      <% const addable = regs.filter((r) => !assignedIds.has(r.id)); if (multi && addable.length) { %>
        <form method="post" action="" class="card-body row" data-add-to-shift>
          <input type="hidden" name="_csrf" value="<%= csrfToken %>"><input type="hidden" name="back" value="<%= back %>"><input type="hidden" name="add_shift" value="<%= col.id %>">
          <select data-add-select data-search aria-label="Person aus Anmeldungen hinzufügen"><option value="">+ Person aus Anmeldungen hinzufügen</option><% for (const r of addable) { %><option value="<%= r.id %>"><%= r.last_name %> <%= r.first_name %> (<%= h.labels.REG_STATUS[r.status].short %><%= notPlanned(r, col) ? ', nicht vorgesehen' : '' %>)</option><% } %></select>
        </form>
      <% } %>
    </div>
  <% } %>
</div>

<p class="small muted mt-s">Die Funktion (<%= functionOptions.map((f) => f.short).join(', ') %>) wählst du direkt in der Zeile. Sie gilt für alle Schichten der Person. Es zählen Anmeldungen mit Status Neu, Rückfrage oder Bestätigt sowie <a class="link" href="/einsaetze/<%= event.id %>#externe">externe Abteilungen</a>. Wer keine Funktion hat, zählt als <%= fnSummary.def.name %>.</p>

<% const closed = event.status === 'abgeschlossen'; %>
<details class="card mt no-print shifts-fold" id="schichten-bearbeiten" data-remember="schichten-bearbeiten"<%= !event.date_from ? ' open' : '' %>>
<summary class="card-head"><h2>Schichten bearbeiten <span class="hint">Name, Tag, Zeit, Soll pro Funktion, Mannschaften, Alter und Rang</span></h2><span class="btn btn-sm">Öffnen</span></summary>
<form method="post" action="/einsaetze/<%= event.id %>/schichten/speichern" id="shifts-form" data-section>
  <input type="hidden" name="_csrf" value="<%= csrfToken %>">
  <% if (closed) { %><input type="hidden" name="reason" value="" data-reason><% } %>
  <div class="table-wrap">
    <table class="form-table">
      <thead><tr><th>Name</th><th>Datum</th><th>Beginn</th><th>Ende</th><% for (const f of fnCols) { %><th class="fn-col" title="Soll <%= f.name %>"><span class="fn-tag<%= f.is_default ? ' fn-default' : '' %>"><%= f.short %></span></th><% } %><th class="fn-col" title="Summe der Funktionen">Soll</th><th title="Für welche Mannschaften die Schicht gedacht ist. Leer = alle.">Mannschaften</th><th title="Mindestalter am Tag der Schicht. Alle = keine Grenze.">Alter</th><th title="Mindestrang, z. B. ab KS (Kaderschüler). Alle = keine Grenze.">Rang</th><th title="Leer = Antretensort des Einsatzes">Antretensort</th><th class="th-wrap">Interne Bemerkung</th><th></th></tr></thead>
      <tbody>
      <% for (const s of event.shifts) { const k = `__${s.id}`; %>
        <tr data-soll-row>
          <td><input type="text" name="name<%= k %>" value="<%= s.name %>" required aria-label="Name"></td>
          <td><input type="date" name="date<%= k %>" value="<%= (s.starts_at || event.date || '').slice(0, 10) %>" aria-label="Datum"></td>
          <td><input type="time" name="start<%= k %>" value="<%= s.starts_at ? s.starts_at.slice(11, 16) : '' %>" aria-label="Beginn"></td>
          <td><input type="time" name="end<%= k %>" value="<%= s.ends_at ? s.ends_at.slice(11, 16) : '' %>" aria-label="Ende"></td>
          <% for (const f of fnCols) { %><td class="fn-col"><input type="number" min="0" max="9999" name="fn_target_<%= f.id %><%= k %>" value="<%= s.targets[f.id] ?? '' %>" placeholder="–" aria-label="Soll <%= f.short %>" data-soll-part></td><% } %>
          <td class="fn-col"><strong data-soll-sum><%= s.target_count ?? '–' %></strong></td>
          <td><%- include('_team-pick', { key: k, selected: s.teams, label: `Mannschaften für ${s.name}` }) %></td>
          <td><%- include('_age-pick', { key: k, value: s.min_age, label: `Mindestalter für ${s.name}` }) %></td>
          <td><%- include('_rank-pick', { key: k, value: s.min_rank_id, label: `Mindestrang für ${s.name}` }) %></td>
          <td><input type="text" name="start_place<%= k %>" value="<%= s.start_place || '' %>" placeholder="wie Einsatz" aria-label="Antretensort"></td>
          <td><input type="text" name="internal_note<%= k %>" value="<%= s.internal_note || '' %>" aria-label="Interne Bemerkung"></td>
          <td class="nowrap"><% if (multi) { %><button class="btn btn-sm btn-ghost btn-danger" type="submit" form="shift-del-<%= s.id %>" formnovalidate>Löschen</button><% } %></td>
        </tr>
      <% } %>
        <tr class="new-row" data-soll-row data-new-shift>
          <td><input type="text" name="name__neu" placeholder="+ Neue Schicht" aria-label="Name der neuen Schicht"></td>
          <td><input type="date" name="date__neu" value="<%= event.date || event.date_to || '' %>" aria-label="Datum der neuen Schicht"></td>
          <td><input type="time" name="start__neu" aria-label="Beginn der neuen Schicht"></td>
          <td><input type="time" name="end__neu" aria-label="Ende der neuen Schicht"></td>
          <% for (const f of fnCols) { %><td class="fn-col"><input type="number" min="0" max="9999" name="fn_target_<%= f.id %>__neu" placeholder="–" aria-label="Soll <%= f.short %>" data-soll-part></td><% } %>
          <td class="fn-col"><strong data-soll-sum></strong></td>
          <td><%- include('_team-pick', { key: '__neu', selected: [], label: 'Mannschaften für die neue Schicht' }) %></td>
          <td><%- include('_age-pick', { key: '__neu', value: null, label: 'Mindestalter für die neue Schicht' }) %></td>
          <td><%- include('_rank-pick', { key: '__neu', value: null, label: 'Mindestrang für die neue Schicht' }) %></td>
          <td><input type="text" name="start_place__neu" placeholder="wie Einsatz" aria-label="Antretensort der neuen Schicht"></td>
          <td><input type="text" name="internal_note__neu" aria-label="Interne Bemerkung der neuen Schicht"></td>
          <td class="nowrap"><button class="btn btn-sm" type="submit" data-add-shift title="Neue Schicht hinzufügen und alle Änderungen speichern">Hinzufügen</button></td>
        </tr>
      </tbody>
    </table>
  </div>
  <% if (closed) { %><div class="card-body small muted">Abgeschlossen: Änderungen nur durch Admins mit Begründung (wird beim Speichern abgefragt).</div><% } %>
  <div class="section-foot">
    <span class="small muted" data-dirty-hint>Das Soll der Schicht ist die Summe der Funktionen. Mannschaften, Alter und Rang: leer = alle; andere können sich trotzdem anmelden. Mehrere Schichten ändern, dann einmal speichern. Neue Schicht: unterste Zeile ausfüllen.</span>
    <button class="btn btn-primary btn-sm" type="submit">Speichern</button>
  </div>
</form>
</details>
<% if (multi) { for (const s of event.shifts) { %>
  <form id="shift-del-<%= s.id %>" method="post" action="/schichten/<%= s.id %>/loeschen" class="hidden" data-confirm="Schicht «<%= s.name %>» löschen? Zuteilungen gehen verloren."><input type="hidden" name="_csrf" value="<%= csrfToken %>"><% if (closed) { %><input type="hidden" name="reason" value="" data-reason><% } %></form>
<% } } %>
