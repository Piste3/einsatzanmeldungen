<dialog id="attempt" data-shifts="<%= JSON.stringify(typeof shiftChoices !== 'undefined' ? shiftChoices : {}) %>"<% if (typeof event !== 'undefined' && event && !(typeof eventChoice !== 'undefined' && eventChoice)) { %> data-event="<%= event.id %>"<% } %>>
  <form method="post" action="<%= action %>" data-attempt-form>
    <input type="hidden" name="_csrf" value="<%= csrfToken %>">
    <input type="hidden" name="person_id" value="">
    <input type="hidden" name="back" value="<%= back %>">
    <% if (typeof eventChoice !== 'undefined' && eventChoice) { %><input type="hidden" name="event_id" value=""><% } %>
    <div class="card-head"><h2>Kontaktversuch erfassen <span class="hint" data-who></span></h2></div>
    <div class="card-body">
      <div class="dlg-current small" data-current-box hidden><strong>Aktuell:</strong> <span data-current-text></span> <a class="link" data-current-link href="#">Anmeldung öffnen →</a></div>
      <div class="hist small" data-history hidden></div>
      <div class="field"><label>Kanal</label>
        <div class="segmented">
          <input type="radio" name="channel" id="ch-tel" value="telefon" checked><label for="ch-tel">Telefon</label>
          <input type="radio" name="channel" id="ch-wa" value="whatsapp"><label for="ch-wa">WhatsApp</label>
        </div>
      </div>
      <div class="fields fields-2">
        <div class="field"><label for="att-date">Datum</label><input id="att-date" type="date" name="date" value="<%= h.today() %>"></div>
        <div class="field"><label for="att-time">Uhrzeit</label><input id="att-time" type="time" name="time" value="<%= h.localNow().slice(11, 16) %>"></div>
      </div>
      <div class="field"><label for="att-by">Gesendet von</label>
        <select id="att-by" name="sent_by_user_id" data-search><% for (const u of allUsers) { %><option value="<%= u.id %>" <%= u.id === user.id ? 'selected' : '' %>><%= u.display_name %></option><% } %></select>
        <div class="field-hint">vorausgefüllt mit dir – änderbar, falls jemand anderes angerufen oder geschrieben hat</div>
      </div>
      <div class="field"><label for="att-result">Ergebnis</label>
        <select id="att-result" name="result" required>
          <option value="nicht_erreicht" data-ch="telefon">Nicht erreicht</option>
          <option value="whatsapp" data-ch="whatsapp">Nachricht gesendet, Antwort offen</option>
          <option value="zugesagt">Zugesagt – Anmeldung erstellen</option>
          <option value="unsicher">Unsicher – weiss es noch nicht</option>
          <option value="abgesagt">Abgesagt</option>
        </select>
      </div>
      <div class="field" data-shift-field hidden><label>Für welche Schichten?</label>
        <div class="check-list" data-shift-options></div>
        <div class="field-hint">Leer lassen, wenn die Schicht noch offen ist. Zuteilen geht auch später unter «Schichten».</div>
      </div>
      <div class="field"><label for="att-note">Notiz</label><input id="att-note" type="text" name="note" placeholder="optional"></div>
    </div>
    <div class="card-foot"><button class="btn btn-ghost btn-danger mr-auto" type="button" data-reset-person title="Kontaktversuche, Rückmeldung und Schichten für diese Person bei diesem Einsatz löschen">Alles zurücksetzen</button><button class="btn btn-ghost" type="button" data-close-dialog>Abbrechen</button><button class="btn btn-primary" type="submit">Speichern</button></div>
  </form>
</dialog>
