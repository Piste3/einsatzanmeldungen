<!doctype html>
<html lang="de-CH">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <meta name="csrf-token" content="<%= csrfToken %>">
  <title><%= title ? title + ' · ' : '' %>KKB-Einsatzplaner</title>
  <link rel="icon" href="/static/img/logo.svg" type="image/svg+xml">
  <link rel="stylesheet" href="/static/css/app.css?v=<%= v %>">
</head>
<body data-live-topics="<%= (liveTopics || []).join(',') %>"<% if (typeof editKey !== 'undefined' && editKey) { %> data-edit-key="<%= editKey %>"<% } %>>
<div class="app">
  <aside class="sidebar">
    <a class="brand" href="/">
      <span class="logo">KKB</span>
      <span><span class="brand-title">Einsatzplaner</span><br><span class="brand-sub">Kadetten-Korps Basel</span></span>
    </a>
    <%
      const navItems = [
        ['/', 'Cockpit', p => p === '/'],
        ['/einsaetze', 'Einsätze', p => p.startsWith('/einsaetze')],
        ['/rueckmeldungen', 'Rückmeldungen', p => p.startsWith('/rueckmeldungen')],
        ['/klaerungen', 'Klärungen', p => p.startsWith('/klaerungen'), nav.klaerungen],
        ['/personen', 'Personen', p => p.startsWith('/personen')],
      ];
    %>
    <nav class="nav">
      <% for (const [href, label, active, count] of navItems) { %>
        <a href="<%= href %>" class="<%= active(path) ? 'active' : '' %>"><span class="nav-icon"></span><%= label %><% if (count) { %><span class="count" data-nav-count="klaerungen"><%= count %></span><% } %></a>
      <% } %>
      <div class="nav-sep"></div>
      <% if (isAdmin) { %>
        <a href="/formulare" class="<%= path.startsWith('/formulare') ? 'active' : '' %>"><span class="nav-icon"></span>Formulare<% if (nav.formErrors) { %><span class="count red"><%= nav.formErrors %></span><% } %></a>
        <a href="/verwaltung" class="<%= path.startsWith('/verwaltung') ? 'active' : '' %>"><span class="nav-icon"></span>Einstellungen</a>
      <% } else { %>
        <a href="/forms/anmeldung?vorschau=1" target="_blank" rel="noopener"><span class="nav-icon"></span>Formular-Vorschau</a>
      <% } %>
    </nav>
    <div class="sidebar-user">
      <a href="/konto/passwort" class="row" title="Konto / Passwort ändern">
        <span class="avatar"><%= h.initials(user.display_name) %></span>
        <span><span class="name"><%= user.display_name %></span><br><span class="role"><%= h.labels.ROLES[user.role] %></span></span>
      </a>
      <form method="post" action="/logout"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><button type="submit" title="Abmelden">Abmelden</button></form>
    </div>
  </aside>
  <main class="main" id="content">
    <% for (const f of flashes || []) { %><div class="flash flash-<%= f.type %>"><%= f.message %></div><% } %>
    <div class="hint-bar presence" id="presence"><span class="tag tag-yellow">Hinweis</span><span id="presence-text"></span></div>
