<%# Kopfzeile: Brotkrumen, Titel, Live-Anzeige, Suche, Aktionen %>
<div class="topbar">
  <div>
    <% if (typeof crumbs !== 'undefined' && crumbs.length) { %>
      <div class="crumbs"><% crumbs.forEach((c, i) => { %><% if (i) { %> › <% } %><% if (c[1]) { %><a href="<%= c[1] %>"><%= c[0] %></a><% } else { %><%= c[0] %><% } %><% }) %></div>
    <% } %>
    <div class="title-row"><h1><%= heading %></h1><%- typeof badges !== 'undefined' ? badges : '' %></div>
    <% if (typeof subline !== 'undefined' && subline) { %><div class="subline"><%- subline %></div><% } %>
  </div>
  <div class="top-actions">
    <% if ((liveTopics || []).length) { %><span class="live off" id="live-indicator">Live</span><% } %>
    <% if (typeof showSearch === 'undefined' || showSearch) { %>
      <form class="search" action="/suche" method="get" role="search"><input type="search" name="q" placeholder="Suchen" aria-label="Suchen"><input type="hidden" name="go" value="1"></form>
    <% } %>
    <%- typeof actions !== 'undefined' ? actions : '' %>
  </div>
</div>
