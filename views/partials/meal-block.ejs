<%# Ein Block der Verpflegungsliste: Anzahl Essen (eine Spalte oder pro Schicht), Personen mit Einschränkung, externe Abteilungen %>
<%
  const b = block;
  const ext = [...b.extDiets, ...b.extNoInfo];
  const strongLabel = (l) => l !== 'ohne Einschränkung';
%>
<div class="card participants meals mb">
  <div class="card-head"><h2><%= blockTitle %> <span class="hint"><%= b.total %> Essen<%= b.extTotal ? ` · ${h.plural(b.persons, 'Person', 'Personen')} + ${b.extTotal} extern` : '' %></span></h2></div>
  <div class="table-wrap">
    <table class="meal-sum">
      <% if (typeof matrix !== 'undefined' && matrix) { %>
        <thead><tr><th>Essen</th><% for (const c of matrix.cols) { %><th class="right"><%= c.label %><% if (c.when) { %><span class="sub muted"><%= c.when %></span><% } %></th><% } %><th class="right">Ganzer Einsatz</th></tr></thead>
        <tbody>
          <% for (const r of matrix.rows) { %>
            <tr><td><% if (strongLabel(r.label)) { %><strong><%= r.label %></strong><% } else { %><%= r.label %><% } %></td><% for (const n of r.values) { %><td class="right"><%- n ? n : '<span class="muted">–</span>' %></td><% } %><td class="right"><strong><%= r.total %></strong></td></tr>
          <% } %>
          <tr class="total"><td>Total Essen</td><% for (const n of matrix.totals) { %><td class="right"><%= n %></td><% } %><td class="right"><%= matrix.total %></td></tr>
        </tbody>
      <% } else { %>
        <thead><tr><th>Essen</th><th class="right">Anzahl</th></tr></thead>
        <tbody>
          <% for (const [l, n] of b.summary) { %>
            <tr><td><% if (strongLabel(l)) { %><strong><%= l %></strong><% } else { %><%= l %><% } %></td><td class="right"><%= n %></td></tr>
          <% } %>
          <tr class="total"><td>Total Essen</td><td class="right"><%= b.total %></td></tr>
        </tbody>
      <% } %>
    </table>
  </div>
  <% if (typeof matrix !== 'undefined' && matrix && matrix.overlap) { %>
    <div class="card-body small muted">Wer in mehreren Schichten eingeteilt ist, zählt in jeder dieser Schichten. In «Ganzer Einsatz» zählt jede Person einmal.</div>
  <% } %>
  <div class="card-body ext-head"><strong>Personen mit Essenseinschränkungen</strong> <span class="muted small">· <%= b.people.length %></span></div>
  <div class="table-wrap">
    <table>
      <thead><tr><th class="nr"></th><th>Name</th><th>Essenseinschränkung</th><th>Details</th><% if (showShiftCol) { %><th>Schicht</th><% } %></tr></thead>
      <tbody>
        <% if (!b.people.length) { %><tr><td colspan="<%= showShiftCol ? 5 : 4 %>" class="empty">Keine eigenen Personen mit Essenseinschränkungen.</td></tr><% } %>
        <% b.people.forEach((r, i) => { %>
          <tr>
            <td class="nr muted"><%= i + 1 %></td>
            <td><%- h.rank(r.rank_short) %><% if (personLinks) { %><a href="/personen/<%= r.person_id %>"><strong><%= r.first_name %> <%= r.last_name %></strong></a><% } else { %><strong><%= r.first_name %> <%= r.last_name %></strong><% } %></td>
            <td><% if (r.diet.visible) { %><strong><%= r.diet.category || 'andere' %></strong><% } else { %><span class="muted">Hinweis vorhanden</span><% } %></td>
            <td><%= r.diet.text %></td>
            <% if (showShiftCol) { %><td><%= shiftOf(r) %></td><% } %>
          </tr>
        <% }) %>
      </tbody>
    </table>
  </div>
  <% if (ext.length) { %>
    <div class="card-body ext-head"><strong>Externe Abteilungen</strong> <span class="muted small">· <%= h.plural(b.extTotal, 'Person', 'Personen') %>, ohne Namen</span></div>
    <div class="table-wrap">
      <table>
        <thead><tr><th>Abteilung</th><th class="right">Personen</th><th>Essenseinschränkungen</th><% if (showShiftCol) { %><th>Schicht</th><% } %></tr></thead>
        <tbody>
          <% for (const x of ext) { %>
            <tr>
              <td><span class="tag tag-blue tag-ext">extern</span> <strong><%= x.unit_name %></strong></td>
              <td class="right"><strong><%= x.person_count %></strong></td>
              <td><% if (!x.dietList.length) { %><span class="muted">keine Angaben</span><% } %><% x.dietList.forEach((d, i) => { %><%= i ? ', ' : '' %><strong><%= d.count %>× <%= d.label %></strong><%= d.text ? `: ${d.text}` : '' %><% }) %></td>
              <% if (showShiftCol) { %><td><%= extShift(x) %></td><% } %>
            </tr>
          <% } %>
        </tbody>
      </table>
    </div>
  <% } %>
</div>
