<%# Historie einer Person bei einem Einsatz, neueste zuerst (im Kontaktversuch-Fenster) %>
<%
  const SYM = { an: '✓', ab: '✕', unsicher: '?', offen: '' };
  const DSYM = { bestaetigt: '✓', warteliste: h.icon('clock', 'fb-ico'), whatsapp: h.icon('chat', 'fb-ico'), telefon: h.icon('phone', 'fb-ico'), muendlich: h.icon('voice', 'fb-ico'), rueckfrage: '!' };
  const cur = entries.findIndex((e) => e.state);
%>
<div class="hist-head">
  <strong>Verlauf</strong> <span class="muted"><%= entries.length ? `${entries.length} Eintr${entries.length === 1 ? 'ag' : 'äge'}, neueste zuerst` : '' %></span>
  <% if (entries.length > 1) { %><button type="button" class="btn btn-ghost btn-sm btn-danger hist-clear" data-clear-history data-person="<%= personId %>" data-event="<%= eventId %>" title="Alle Einträge ausser dem neuesten löschen – Rückmeldung und Anmeldung bleiben">Verlauf löschen</button><% } %>
</div>
<% if (!entries.length) { %>
  <div class="muted small"><%= cleared ? `Verlauf am ${cleared.atText} von ${cleared.by} gelöscht. Seither nichts Neues.` : 'Noch nichts erfasst: keine Rückmeldung und kein Kontakt.' %></div>
<% } else { %>
<ol class="hist-list">
  <% entries.forEach((e, i) => { %>
  <li class="hist-row<%= i === cur ? ' hist-latest' : '' %>">
    <span class="fb fb-sm <%= e.state ? `fb-${e.state}` : 'fb-none' %><%= e.detail ? ` fb-d-${e.detail}` : '' %>" aria-hidden="true"><%- e.detail ? DSYM[e.detail] : h.escapeHtml(e.state ? SYM[e.state] : '·') %></span>
    <span class="hist-main">
      <span class="hist-text"><%= e.text %><% if (i === cur) { %> <span class="hist-now">aktueller Stand</span><% } %></span>
      <span class="hist-meta"><%= e.by %> · <%= e.atText %><% if (e.enteredBy) { %> · erfasst von <%= e.enteredBy %><% } %></span>
      <% if (e.note) { %><span class="hist-note">«<%= e.note %>»</span><% } %>
    </span>
  </li>
  <% }) %>
</ol>
<% if (cleared) { %><div class="muted small hist-cleared">Ältere Einträge am <%= cleared.atText %> von <%= cleared.by %> gelöscht.</div><% } %>
<% } %>
