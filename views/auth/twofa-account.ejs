<%- include('../partials/head') %>
<%- include('../partials/topbar', { crumbs: [['Konto']], heading: 'Zwei-Faktor-Anmeldung', showSearch: false }) %>
<nav class="tabs"><a href="/konto/passwort">Passwort</a><a href="/konto/2fa" class="active">Zwei-Faktor</a></nav>
<% if (errors.length) { %><div class="flash flash-error"><%= errors.join(' ') %></div><% } %>
<% if (required && !enabled) { %><div class="callout warn mb">Für dein Konto ist die Zwei-Faktor-Anmeldung vorgeschrieben. Bitte richte sie jetzt ein, danach kannst du weiterarbeiten.</div><% } %>
<div class="grid grid-main">
  <div class="stack">
  <% if (codes) { %>
    <div class="card card-highlight">
      <div class="card-head"><h2><%= typeof justEnabled !== 'undefined' && justEnabled ? 'Eingerichtet! Jetzt die Wiederherstellungscodes sichern' : 'Neue Wiederherstellungscodes' %></h2></div>
      <div class="card-body">
        <p class="small">Mit diesen Codes kommst du hinein, falls das Handy verloren geht. <strong>Jeder Code gilt einmal.</strong> Speichere oder drucke sie jetzt, denn sie werden nur dieses eine Mal angezeigt. Ältere Codes sind ab sofort ungültig.</p>
        <div class="recovery-codes"><% for (const c of codes) { %><code><%= c %></code><% } %></div>
        <button class="btn btn-sm mt" type="button" data-print>Drucken</button>
      </div>
    </div>
  <% } %>

  <% if (u.auth_provider !== 'local') { %>
    <div class="card"><div class="card-body">Dein Konto meldet sich über Microsoft an. Die Zwei-Faktor-Anmeldung stellst du dort ein.</div></div>
  <% } else if (!enabled && setup) { %>
    <div class="card">
      <div class="card-head"><h2>Einrichten</h2></div>
      <div class="card-body">
        <ol class="steps small">
          <li>Installiere auf dem Handy eine Authenticator-App, z. B. <strong>Microsoft Authenticator</strong>, <strong>Google Authenticator</strong> oder die Passwort-App auf dem iPhone.</li>
          <li>Scanne in der App diesen QR-Code:</li>
        </ol>
        <div class="qr"><%- setup.qr %></div>
        <p class="small muted">Scannen nicht möglich? Diesen Schlüssel von Hand eingeben: <code class="secret"><%= setup.secret %></code></p>
        <form method="post" action="/konto/2fa/einrichten" class="mt">
          <input type="hidden" name="_csrf" value="<%= csrfToken %>">
          <ol class="steps small" start="3"><li>Gib zur Bestätigung den 6-stelligen Code ein, den die App jetzt anzeigt:</li></ol>
          <div class="row"><input name="code" type="text" inputmode="numeric" autocomplete="one-time-code" maxlength="7" required class="code-input" placeholder="123 456" style="max-width:160px"><button class="btn btn-primary" type="submit">Aktivieren</button></div>
        </form>
      </div>
    </div>
  <% } else if (enabled) { %>
    <div class="card">
      <div class="card-head"><h2>Status</h2><%- h.badge('aktiv', 'green') %></div>
      <div class="card-body small">
        <p>Beim Anmelden wird nach dem Passwort ein Code aus deiner Authenticator-App verlangt<%= rememberLabel ? `, ${rememberLabel}` : '' %>.</p>
        <dl class="kv left mt-s">
          <dt>Eingerichtet</dt><dd><%= h.fmtDateTime(u.totp_enabled_at) %></dd>
          <dt>Wiederherstellungscodes</dt><dd><%= remaining %> übrig<%= remaining <= 2 ? ' – bitte neue erzeugen' : '' %></dd>
          <dt>Gemerkte Geräte</dt><dd><%= devices %></dd>
        </dl>
      </div>
    </div>
    <div class="card">
      <div class="card-head"><h2>Neue Wiederherstellungscodes</h2></div>
      <div class="card-body">
        <form method="post" action="/konto/2fa/codes" class="row">
          <input type="hidden" name="_csrf" value="<%= csrfToken %>">
          <input name="code" type="text" inputmode="numeric" autocomplete="one-time-code" maxlength="7" required class="code-input" placeholder="Code aus der App" style="max-width:180px">
          <button class="btn" type="submit">Neue Codes erzeugen</button>
        </form>
      </div>
    </div>
    <% if (devices) { %>
    <div class="card"><div class="card-body row-between">
      <span class="small">Alle Geräte vergessen, auf denen «nicht mehr fragen» gewählt wurde.</span>
      <form method="post" action="/konto/2fa/geraete"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><button class="btn btn-sm" type="submit">Geräte vergessen</button></form>
    </div></div>
    <% } %>
    <% if (!required) { %>
    <div class="card card-danger">
      <div class="card-head"><h2>Abschalten</h2></div>
      <div class="card-body">
        <form method="post" action="/konto/2fa/aus" class="row" data-confirm="Zwei-Faktor-Anmeldung wirklich abschalten?">
          <input type="hidden" name="_csrf" value="<%= csrfToken %>">
          <input name="password" type="password" autocomplete="current-password" required placeholder="Dein Passwort" style="max-width:220px">
          <button class="btn btn-danger" type="submit">Abschalten</button>
        </form>
      </div>
    </div>
    <% } %>
  <% } %>
  </div>
  <div class="card">
    <div class="card-head"><h2>Was ist das?</h2></div>
    <div class="card-body small">
      <p>Mit der Zwei-Faktor-Anmeldung reicht das Passwort allein nicht mehr. Zusätzlich braucht es einen Code, den nur dein Handy erzeugt. Wer dein Passwort errät oder mitliest, kommt so trotzdem nicht hinein.</p>
      <p class="mt-s">Der Code wechselt alle 30 Sekunden und funktioniert auch ohne Internet auf dem Handy.</p>
    </div>
  </div>
</div>
<%- include('../partials/foot') %>
