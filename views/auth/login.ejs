<!doctype html>
<html lang="de-CH">
<head>
  <meta charset="utf-8"><meta name="viewport" content="width=device-width, initial-scale=1">
  <title>Anmelden · KKB-Einsatzplaner</title>
  <link rel="icon" href="/static/img/logo.svg" type="image/svg+xml">
  <link rel="stylesheet" href="/static/css/app.css?v=<%= v %>">
  <link rel="stylesheet" href="/static/css/ruhig.css?v=<%= v %>">
</head>
<body>
<div class="auth-page">
  <div class="auth-card">
    <div class="brand"><span class="logo">KKB</span><span><span class="brand-title">Einsatzplaner</span><br><span class="brand-sub">Kadetten-Korps Basel</span></span></div>
    <% if (error) { %><div class="flash flash-error"><%= error %></div><% } %>
    <% const local = providers.find((p) => p.id === 'local'); const others = providers.filter((p) => p.type === 'redirect'); %>
    <% for (const p of others) { %>
      <a class="btn btn-dark mb" href="/auth/<%= p.id %>"><%= p.label %></a>
    <% } %>
    <% if (local && others.length) { %><div class="divider">oder</div><% } %>
    <% if (local) { %>
    <form method="post" action="/login">
      <input type="hidden" name="next" value="<%= next %>">
      <div class="field"><label for="username">Benutzername</label><input id="username" name="username" type="text" autocomplete="username" value="<%= username %>" required autofocus></div>
      <div class="field"><label for="password">Passwort</label><input id="password" name="password" type="password" autocomplete="current-password" required></div>
      <button class="btn btn-primary mt-s" type="submit">Anmelden</button>
    </form>
    <p class="small muted mt">Passwort vergessen? Der Admin kann es zurücksetzen.</p>
    <% } %>
  </div>
</div>
</body>
</html>
