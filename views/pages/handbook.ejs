<%- include('../partials/head') %>
<%- include('../partials/topbar', {
  crumbs: [['Handbuch']], heading: title, showSearch: false,
  actions: `${locals.other ? `<a class="btn" href="${locals.other.href}">${locals.other.label}</a>` : ''}<a class="btn btn-primary" href="${locals.pdfHref}" target="_blank" rel="noopener" title="Das gestaltete Handbuch als PDF in einem neuen Tab öffnen – zum Drucken, Speichern oder Weiterschicken">Als PDF</a>`,
}) %>
<div class="subline mb">Stand <%= h.fmtDate(doc.date.toISOString().slice(0, 10)) %><%= doc.commit ? ` · Version ${doc.commit}` : '' %> · wird mit jedem Update automatisch aktualisiert</div>
<div class="handbook">
  <% if (doc.toc.length > 2) { %>
  <nav class="card handbook-toc no-print">
    <div class="card-head"><h2>Inhalt</h2></div>
    <div class="card-body">
      <% for (const t of doc.toc.filter((x) => x.depth === 2)) { %><a href="#<%= t.id %>"><%= t.text %></a><% } %>
    </div>
  </nav>
  <% } %>
  <article class="card handbook-body"><div class="card-body prose"><%- doc.html %></div></article>
</div>
<%- include('../partials/foot') %>
