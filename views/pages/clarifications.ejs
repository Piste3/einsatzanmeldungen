<%- include('../partials/head') %>
<%- include('../partials/topbar', { crumbs: [['Klärungen']], heading: 'Anmeldungen zuordnen' }) %>
<% if (!list.length) { %>
<div class="card empty-state">
  <span class="empty-state-icon"><%- h.icon('check') %></span>
  <h2>Keine offenen Klärungen</h2>
  <p>Alle Anmeldungen sind einer Person zugeordnet. Kommt ein Name, der nicht eindeutig passt, erscheint er hier.</p>
</div>
<% } else { %>
<div class="grid grid-side">
  <div class="card">
    <div class="card-head"><h2>Offen <%- h.badge(list.length, list.length ? 'yellow' : 'gray') %></h2></div>
    <div class="card-body">
      <% for (const r of list) { %>
        <a class="list-item <%= selected && selected.id === r.id ? 'active' : '' %>" href="/klaerungen?id=<%= r.id %>" data-row-id="k<%= r.id %>">
          <strong>«<%= r.entered_name %>»</strong>
          <span class="muted"><%= r.event_name %> · <%= h.fmtRelative(r.registered_at) %></span>
          <div class="mt-s"><%- h.badge(r.match_info || 'keine passende Person', /Personen/.test(r.match_info || '') ? 'yellow' : 'blue') %></div>
        </a>
      <% } %>
    </div>
  </div>
  <% if (selected) { const r = selected; const aliasDefault = !/Personen/.test(r.match_info || ''); const assignForm = (p, primary) => `
      <form method="post" action="/anmeldungen/${r.id}/zuordnen" class="inline">
        <input type="hidden" name="_csrf" value="${csrfToken}"><input type="hidden" name="person_id" value="${p.id}">
        <input type="hidden" name="back" value="/klaerungen"><input type="hidden" name="save_alias" value="${aliasDefault ? 1 : 0}" data-alias-mirror>
        <button class="btn btn-sm ${primary ? 'btn-primary' : ''}" type="submit">Zuordnen</button></form>`; %>
  <div class="card">
    <div class="card-head"><h2>«<%= r.entered_name %>» <span class="hint">angemeldet für <%= r.event_name %><%= r.assigned.length ? ` · ${r.assigned.map((a) => a.name).join(', ')}` : '' %></span></h2></div>
    <div class="card-body">
      <div class="list-item">
        <div class="grid grid-3">
          <div><span class="muted small">Eingegeben</span><br><strong>Vorname: <%= r.entered_first_name %> · Nachname: <%= r.entered_last_name %></strong></div>
          <div><span class="muted small">Quelle</span><br><%= h.labels.SOURCE[r.source] %>, <%= h.fmtRelative(r.registered_at) %></div>
          <div><span class="muted small">Bemerkung</span><br><%= r.remark || '–' %><% if (r.answer === 'nein') { %><br><%- h.badge('Antwort: Nein', 'red') %><% } %></div>
        </div>
      </div>
      <form method="get" action="/klaerungen" class="mt">
        <input type="hidden" name="id" value="<%= r.id %>">
        <label for="q">Person in den Stammdaten suchen</label>
        <input id="q" type="search" name="q" value="<%= q || r.entered_last_name %>" placeholder="Name" autofocus>
      </form>
      <% const people = searchResults || candidates; %>
      <div class="table-wrap mt-s">
        <table>
          <thead><tr><th>Person</th><th>Jahrgang</th><th>Mannschaft</th><th></th></tr></thead>
          <tbody>
          <% if (!people.length) { %><tr><td colspan="4" class="empty"><%= searchResults ? 'Keine Treffer.' : 'Keine Vorschläge – bitte oben suchen.' %></td></tr><% } %>
          <% people.forEach((p, i) => { %>
            <tr class="<%= i === 0 && !searchResults ? 'selected' : '' %>">
              <td><%- h.rank(p.rank_short) %><strong><%= p.first_name %> <%= p.last_name %></strong></td>
              <td><%= h.birthYear(p) || '–' %></td>
              <td><%= p.teams || '–' %></td>
              <td class="right"><%- assignForm(p, i === 0 && !searchResults) %></td>
            </tr>
          <% }) %>
          </tbody>
        </table>
      </div>
      <div class="callout mt">
        <label class="check"><input type="checkbox" <%= aliasDefault ? 'checked' : '' %> data-alias-toggle> <span><strong>«<%= r.entered_name %>» als Namensvariante speichern</strong><br><span class="small">Beim nächsten Mal wird diese Schreibweise automatisch der gewählten Person zugeordnet.</span></span></label>
      </div>
      <div class="row mt">
        <% if (isAdmin) { %>
          <a class="btn btn-sm" href="/personen/neu?first_name=<%= encodeURIComponent(r.entered_first_name || '') %>&last_name=<%= encodeURIComponent(r.entered_last_name || '') %>&from=<%= r.id %>">Neue Person anlegen</a>
        <% } else { %>
          <button class="btn btn-sm" disabled title="Neue Personen legt nur der Admin an">Neue Person anlegen <%- h.badge('nur Admin', 'gray') %></button>
        <% } %>
        <form method="post" action="/klaerungen/<%= r.id %>/ungueltig" class="inline" data-confirm="Als ungültig markieren (Test, Unsinn, doppelt)?"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><button class="btn btn-sm btn-ghost" type="submit">Als ungültig markieren</button></form>
      </div>
    </div>
  </div>
  <% } %>
</div>
<% } %>
<%- include('../partials/foot') %>
