<%- include('../partials/head') %>
<%
  const action = isNew ? '/einsaetze' : `/einsaetze/${e.id}/bearbeiten`;
  const closed = e.status === 'abgeschlossen';
  const qt = questionTemplates.find((q) => q.id === Number(e.question_template_id));
%>
<form method="post" action="<%= action %>" id="event-form">
<input type="hidden" name="_csrf" value="<%= csrfToken %>">
<% if (!isNew) { %><input type="hidden" name="version" value="<%= e.version %>"><% } %>
<%- include('../partials/topbar', {
  crumbs: isNew ? [['Einsätze', '/einsaetze'], ['Neuer Einsatz']] : [['Einsätze', '/einsaetze'], [e.name, `/einsaetze/${e.id}`], ['Bearbeiten']],
  heading: isNew ? (e.name || 'Neuer Einsatz') : e.name, badges: h.eventBadge(e.status || 'entwurf'), showSearch: false,
  actions: (isNew ? '' : `<a class="btn" href="/forms/anmeldung?vorschau=1&einsatz=${e.id}" target="_blank" rel="noopener">Formular-Vorschau</a>`)
    + `<button class="btn" type="submit" name="action" value="save">${isNew ? 'Als Entwurf speichern' : 'Speichern'}</button>`
    + ((isNew || e.status === 'entwurf') ? '<button class="btn btn-primary" type="submit" name="action" value="publish">Veröffentlichen</button>' : ''),
}) %>
<% if (errors.length) { %><div class="flash flash-error"><%= errors.join(' ') %></div><% } %>
<% if (closed) { %>
  <div class="callout warn mb"><strong class="cap">Abgeschlossen</strong>Dieser Einsatz ist schreibgeschützt. Als Admin kannst du ihn mit Begründung ändern.
    <div class="field mt-s"><input type="text" name="reason" required placeholder="Begründung der Änderung"></div></div>
<% } %>

<div class="grid grid-main">
  <div class="stack">
  <div class="card">
    <div class="card-head"><h2>Grunddaten <span class="hint">Nur der Name ist Pflicht – alles andere kann später ergänzt werden.</span></h2></div>
    <div class="card-body">
      <div class="fields fields-2">
        <div class="field"><label for="name">Name des Einsatzes <span class="req">*</span></label><input id="name" name="name" type="text" required value="<%= e.name || '' %>" autofocus></div>
        <div class="field"><label for="date">Datum</label><input id="date" name="date" type="date" value="<%= e.date || '' %>" aria-describedby="date-hint">
          <div class="small muted mt-s" id="date-hint">Leer lassen, wenn die Schichten an verschiedenen Tagen sind. Dann bekommt jede Schicht ihr eigenes Datum.</div></div>
      </div>
      <div class="fields fields-3e">
        <div class="field"><label for="start_time">Beginn (Antreten)</label><input id="start_time" name="start_time" type="time" value="<%= e.start_time || '' %>"></div>
        <div class="field"><label for="end_time">Ende (Abtreten)</label><input id="end_time" name="end_time" type="time" value="<%= e.end_time || '' %>"></div>
        <div class="field"><label for="leader">Einsatzleitung</label>
          <select id="leader" name="leader_person_id" data-search><option value="">–</option>
            <% for (const p of leaders) { %><option value="<%= p.id %>" <%= Number(e.leader_person_id) === p.id ? 'selected' : '' %>><%= p.rank_short ? p.rank_short + ' ' : '' %><%= p.first_name %> <%= p.last_name %></option><% } %>
          </select></div>
      </div>
      <div class="fields fields-2">
        <div class="field"><label for="start_place">Antretensort</label><input id="start_place" name="start_place" type="text" value="<%= e.start_place || '' %>"></div>
        <div class="field"><label for="end_place">Abtretensort</label><input id="end_place" name="end_place" type="text" value="<%= e.end_place || '' %>" placeholder="leer = wie Antretensort"></div>
      </div>
      <div class="field">
        <label for="tenue">Tenue</label>
        <div class="template-chips">
          <% tenueTemplates.forEach((t, i) => { %><button type="button" class="<%= i === 0 ? 'primary' : '' %>" data-fill="tenue" data-text="<%= t.text %>">Vorlage: <%= t.name %></button><% }) %>
        </div>
        <textarea id="tenue" name="tenue" rows="2"><%= e.tenue || '' %></textarea>
      </div>
      <div class="field"><label for="description">Beschreibung (für Mitglieder sichtbar)</label><textarea id="description" name="description" rows="2"><%= e.description || '' %></textarea></div>
      <div class="field"><label for="internal_note">Interne Bemerkung</label><textarea id="internal_note" name="internal_note" rows="2" placeholder="nur für Aufgebotsstelle sichtbar"><%= e.internal_note || '' %></textarea></div>
      <% if (extraDefs.length) { %>
        <div class="fields fields-2">
        <% for (const d of extraDefs) { const v = (e.extra || {})[d.name] || ''; %>
          <div class="field">
            <label for="extra_<%= d.id %>"><%= d.name %><% if (d.required) { %> <span class="req">*</span><% } %></label>
            <% if (d.field_type === 'textarea') { %><textarea id="extra_<%= d.id %>" name="extra_<%= d.id %>" rows="2"><%= v %></textarea>
            <% } else if (d.field_type === 'checkbox') { %><label class="check"><input type="checkbox" id="extra_<%= d.id %>" name="extra_<%= d.id %>" value="1" <%= v ? 'checked' : '' %>> Ja</label>
            <% } else { %><input id="extra_<%= d.id %>" name="extra_<%= d.id %>" type="<%= d.field_type === 'number' ? 'number' : d.field_type === 'date' ? 'date' : 'text' %>" value="<%= v %>"><% } %>
          </div>
        <% } %>
        </div>
      <% } %>
    </div>
  </div>

<%
  // Soll pro Schicht und Funktion: Spalten = Schichten (neu: nur «Ganzer Einsatz»), Zeilen = Funktionen
  const cols = isNew ? [{ id: null, name: 'Ganzer Einsatz', targets: {} }] : e.shifts;
  const keyOf = (c, f) => (c.id ? `fn_target_${c.id}_${f.id}` : `fn_target_${f.id}`);
  const valOf = (c, f) => e[keyOf(c, f)] ?? (c.targets || {})[f.id] ?? '';
  const shownFns = functionList.filter((f) => f.active || f.is_default || cols.some((c) => (c.targets || {})[f.id]));
  const colTotal = (c) => shownFns.reduce((a, f) => a + (Number(valOf(c, f)) > 0 ? Number(valOf(c, f)) : 0), 0);
%>
    <div class="card" id="funktionen">
      <div class="card-head"><h2>Schichten und Soll <span class="hint">wie viele braucht es?</span></h2><% if (!isNew) { %><a class="small" href="/einsaetze/<%= e.id %>/schichten#schichten-bearbeiten">Schichten hinzufügen oder ändern →</a><% } %></div>
      <div class="table-wrap">
        <table class="form-table fn-grid no-cards" data-fn-grid>
          <thead>
            <tr><th>Funktion</th><% for (const c of cols) { %><th class="fn-cell"><%= c.name %><% if (c.starts_at) { %><span class="sub muted"><%= h.fmtShiftWhen(c, h.isMultiDay(e)) %></span><% } %></th><% } %></tr>
          </thead>
          <tbody>
          <% for (const f of shownFns) { %>
            <tr>
              <td class="nowrap"><span class="fn-tag<%= f.is_default ? ' fn-default' : '' %>"><%= f.short %></span> <%= f.name %></td>
              <% cols.forEach((c, i) => { %><td class="fn-cell"><input name="<%= keyOf(c, f) %>" type="number" min="0" max="9999" step="1" inputmode="numeric" value="<%= valOf(c, f) %>" placeholder="–" data-fn-col="<%= i %>" aria-label="<%= f.short %> <%= c.name %>"></td><% }) %>
            </tr>
          <% } %>
          </tbody>
          <tfoot>
            <tr><th>Soll der Schicht <span class="muted">(Personen)</span></th><% cols.forEach((c, i) => { %><th class="fn-cell"><span class="fn-sum" data-fn-total="<%= i %>"><%= colTotal(c) || '–' %></span></th><% }) %></tr>
          </tfoot>
        </table>
      </div>
      <div class="card-body small muted">
        Leer lassen, was es nicht braucht. Das Soll der Schicht ist die Summe. Wer keine Funktion hat, zählt als <%= (functionList.find((f) => f.is_default) || {}).name || 'Einsatzteilnehmer' %>. Die Funktion einer Person wählst du im Reiter «Schichten» oder «Anmeldungen».
        <% if (isNew) { %>Weitere Schichten kannst du nach dem Speichern im Reiter «Schichten» hinzufügen.<% } %>
      </div>
    </div>
  </div>
  <div class="stack">
    <div class="card">
      <div class="card-head"><h2>Anmeldeformular</h2></div>
      <div class="card-body">
        <div class="field"><label for="question_template_id">Anmeldefrage (aus Vorlage)</label>
          <select id="question_template_id" name="question_template_id" data-question-template>
            <option value="">–</option>
            <% for (const q of questionTemplates) { %><option value="<%= q.id %>" data-question="<%= q.question_text %>" data-help="<%= q.help_text || '' %>" <%= Number(e.question_template_id) === q.id ? 'selected' : '' %>><%= q.name %></option><% } %>
          </select></div>
        <div class="field"><label for="question_text">Fragetext</label><input id="question_text" name="question_text" type="text" value="<%= e.question_text || (isNew && questionTemplates[0] ? '' : '') %>" placeholder="<%= e.name ? `Kannst du am ${e.name} teilnehmen?` : 'Kannst du teilnehmen?' %>"></div>
        <div class="field"><label for="help_text">Hilfetext</label><input id="help_text" name="help_text" type="text" value="<%= e.help_text || '' %>" placeholder="optional"></div>
        <p class="small muted">Bei mehreren Schichten entsteht die Schichtauswahl automatisch.</p>
      </div>
    </div>
    <div class="card">
      <div class="card-body">
        <div class="switch">
          <input type="checkbox" disabled <%= e.show_in_form ? 'checked' : '' %> aria-label="Im Formular anzeigen">
          <div><strong>Im Formular anzeigen</strong><div class="small muted">wird beim Veröffentlichen automatisch eingeschaltet<% if (!isNew) { %>; umschalten in der Übersicht des Einsatzes<% } %></div></div>
        </div>
      </div>
    </div>
  </div>
</div>
<div class="form-foot">
  <span class="small muted" data-dirty-hint>Änderungen werden erst mit «Speichern» übernommen.</span>
  <% if (!isNew) { %><a class="btn btn-ghost" href="/einsaetze/<%= e.id %>">Abbrechen</a><% } %>
  <button class="btn<%= (isNew || e.status === 'entwurf') ? '' : ' btn-primary' %>" type="submit" name="action" value="save"><%= isNew ? 'Als Entwurf speichern' : 'Speichern' %></button>
  <% if (isNew || e.status === 'entwurf') { %><button class="btn btn-primary" type="submit" name="action" value="publish">Veröffentlichen</button><% } %>
</div>
</form>
<%- include('../partials/foot') %>
