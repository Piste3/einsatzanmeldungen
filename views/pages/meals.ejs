<%- include('../partials/head') %>
<%
  const e = event;
  const base = `/einsaetze/${e.id}/verpflegungsliste`;
  const leader = e.leader_person_id ? `${e.leader_rank ? `${h.escapeHtml(e.leader_rank)} ` : ''}${h.escapeHtml(e.leader_first + ' ' + e.leader_last)}` : '–';
  const sub = `<strong>${h.escapeHtml(e.name)}</strong><span>${h.fmtEventDate(e, 'wd')}</span><span>Antreten ${h.escapeHtml(e.start_time || '–')}${e.start_place ? ' · ' + h.escapeHtml(e.start_place) : ''}</span><span>Leitung ${leader}</span>`;
  const q = { umfang: filters.umfang !== 'angemeldet' ? filters.umfang : undefined, schicht: filters.schicht || undefined, sort: filters.sort !== 'rang' ? filters.sort : undefined };
  const exportUrl = (format) => h.escapeHtml(h.withQuery(base, q, { format }));
  const tnUrl = h.escapeHtml(h.withQuery(leaderView ? `/einsaetze/${e.id}` : `/einsaetze/${e.id}/teilnehmerliste`, q));
  const hint = all.summary.some(([l]) => l === 'Hinweis vorhanden');
%>
<%- include('../partials/topbar', {
  crumbs: leaderView ? [['Meine Einsätze', '/'], [e.name, `/einsaetze/${e.id}`], ['Verpflegungsliste']] : [['Einsätze', '/einsaetze'], [e.name, `/einsaetze/${e.id}`], ['Verpflegungsliste']],
  heading: `Verpflegungsliste${shift ? ` · ${shift.name}` : perShift ? ' pro Schicht' : ''}`, subline: sub, showSearch: false,
  actions: `<a class="btn btn-primary" href="${exportUrl('pdf')}" target="_blank" rel="noopener">PDF öffnen</a><a class="btn" href="${exportUrl('xlsx')}">Excel</a><a class="btn" href="${exportUrl('csv')}">CSV</a><a class="btn" href="${tnUrl}">Teilnehmerliste</a>`,
}) %>

<%- include('../partials/list-filters', { action: base }) %>

<% if (unresolved && !leaderView) { %>
  <div class="callout warn mb no-print"><%= unresolved === 1 ? '1 Anmeldung ist noch keiner Person zugeordnet und fehlt' : `${unresolved} Anmeldungen sind noch keiner Person zugeordnet und fehlen` %> deshalb in der Liste. → <a class="link" href="/klaerungen">Klärungen</a></div>
<% } %>

<% if (groups) { %>
  <% for (const g of groups) { %>
    <%- include('../partials/meal-block', { block: g, blockTitle: g.title, matrix: null, showShiftCol: false, personLinks: !leaderView }) %>
  <% } %>
<% } else { %>
  <%- include('../partials/meal-block', { block: all, blockTitle: shift ? h.fmtShiftWhen(shift, h.isMultiDay(e)) ? `${shift.name} · ${h.fmtShiftWhen(shift, h.isMultiDay(e))}` : shift.name : 'Ganzer Einsatz', matrix, showShiftCol: showShift, personLinks: !leaderView }) %>
<% } %>
<p class="small muted">Gezählt: <%= scopes[filters.umfang].label %>. Stand <%= h.fmtDateTime(h.nowIso()) %>.<% if (hint) { %> «Hinweis vorhanden»: Nach dem Einsatz sieht die genaue Angabe nur noch ein Admin.<% } %></p>
<%- include('../partials/foot') %>
