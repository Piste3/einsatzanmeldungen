<%- include('../partials/head') %>
<%- include('../partials/topbar', { crumbs: [['Personen', '/personen'], ['Import']], heading: 'Stammdaten importieren', showSearch: false }) %>
<% for (const e of errors) { %><div class="flash flash-error"><%= e %></div><% } %>
<% if (!preview) { %>
  <div class="card">
    <div class="card-head"><h2>1. Datei wählen <span class="hint">ClubDesk-Export als Excel (.xlsx) oder CSV</span></h2></div>
    <form class="card-body" method="post" action="/personen/import?_csrf=<%= encodeURIComponent(csrfToken) %>" enctype="multipart/form-data">
      <div class="field"><input type="file" name="datei" accept=".xlsx,.csv,.txt" required></div>
      <p class="small muted">Die erste Zeile muss die Spaltenüberschriften enthalten (z. B. Vorname, Nachname, Geburtsdatum, Mobil, E-Mail, Rang, Mannschaft). Nach dem Hochladen siehst du eine Vorschau mit Dublettenprüfung und Fehlerliste – es wird noch nichts gespeichert.</p>
      <button class="btn btn-primary" type="submit">Vorschau anzeigen</button>
    </form>
  </div>
<% } else { const r = preview.rows; const ok = r.filter((x) => x.action === 'create').length; const dups = r.filter((x) => x.duplicate).length; const errs = r.filter((x) => x.errors.length).length; %>
  <form method="post" action="/personen/import">
    <input type="hidden" name="_csrf" value="<%= csrfToken %>"><input type="hidden" name="preview_id" value="<%= preview.id %>">
    <div class="card">
      <div class="card-head"><h2>2. Spalten zuordnen</h2><button class="btn btn-sm" type="submit" name="commit" value="0">Vorschau aktualisieren</button></div>
      <div class="card-body">
        <div class="grid grid-4">
          <% for (const [key, f] of Object.entries(fields)) { %>
            <div class="field"><label><%= f.label %></label><select name="map_<%= key %>"><option value="">– nicht importieren –</option><% preview.headers.forEach((hd, i) => { %><option value="<%= i %>" <%= preview.mapping[key] === i ? 'selected' : '' %>><%= hd || `Spalte ${i + 1}` %></option><% }) %></select></div>
          <% } %>
        </div>
      </div>
    </div>
    <div class="card">
      <div class="card-head"><h2>3. Vorschau</h2><span class="row"><%- h.badge(`${ok} neu`, 'green') %><%- h.badge(`${dups} Dubletten`, 'yellow') %><%- h.badge(`${errs} Fehler`, errs ? 'red' : 'gray') %></span></div>
      <% if (preview.newRanks.length || preview.newTeams.length) { %><div class="card-body"><div class="callout">Neu angelegt werden: <%= [...preview.newRanks.map((x) => `Rang «${x}»`), ...preview.newTeams.map((x) => `Mannschaft «${x}»`)].join(', ') %></div></div><% } %>
      <div class="table-wrap">
        <table>
          <thead><tr><th>Zeile</th><th>Name</th><th>Geburtsdatum / Jahrgang</th><th>Mobil</th><th>E-Mail</th><th>Rang</th><th>Mannschaft</th><th>Prüfung</th><th>Aktion</th></tr></thead>
          <tbody>
          <% for (const x of r) { %>
            <tr>
              <td><%= x.line %></td>
              <td><strong><%= x.data.first_name %> <%= x.data.last_name %></strong></td>
              <td><%= x.data.birth_date ? h.fmtDate(x.data.birth_date) : (x.data.birth_year || '–') %></td>
              <td><%= x.data.mobile || '–' %></td>
              <td><%= x.data.email || '–' %></td>
              <td><%= x.rankRaw || '–' %></td>
              <td><%= x.teamNames.join(', ') || '–' %></td>
              <td class="small">
                <% for (const e of x.errors) { %><div><%- h.badge(e, 'red') %></div><% } %>
                <% if (x.duplicate) { %><div><%- h.badge(`Dublette: ${x.duplicate.text}`, 'yellow') %></div><% } %>
                <% for (const w of x.warnings) { %><div class="muted"><%= w %></div><% } %>
                <% if (!x.errors.length && !x.duplicate && !x.warnings.length) { %><%- h.badge('ok', 'green') %><% } %>
              </td>
              <td>
                <% if (x.errors.length) { %><span class="muted">übersprungen</span>
                <% } else { %>
                  <select name="action_<%= x.line %>">
                    <option value="create" <%= x.action === 'create' ? 'selected' : '' %>>anlegen</option>
                    <option value="skip" <%= x.action === 'skip' ? 'selected' : '' %>>überspringen</option>
                    <% if (x.duplicate && x.duplicate.personId) { %><option value="update">leere Felder ergänzen</option><% } %>
                  </select>
                <% } %>
              </td>
            </tr>
          <% } %>
          </tbody>
        </table>
      </div>
      <div class="card-body row"><button class="btn btn-primary" type="submit" name="commit" value="1">Import ausführen</button><a class="btn btn-ghost" href="/personen/import">Andere Datei</a><span class="small muted">Neue Personen legt nur ein berechtigter Benutzer an – nie das System automatisch.</span></div>
    </div>
  </form>
<% } %>
<%- include('../partials/foot') %>
