<%- include('../partials/head') %>
<%
  const hour = Number(h.localNow().slice(11, 13));
  const greet = hour < 11 ? 'Guten Morgen' : hour < 17 ? 'Guten Tag' : 'Guten Abend';
  const firstName = user.display_name.split(' ')[0];
%>
<%- include('../partials/topbar', {
  crumbs: [[h.fmtDateLong(h.today())]], heading: `${greet}, ${firstName}`,
  actions: '<a class="btn btn-primary" href="/einsaetze/neu">+ Neuer Einsatz</a>',
}) %>

<% if (msSecretDays !== null) { %><div class="flash flash-<%= msSecretDays < 0 ? 'error' : 'info' %>"><strong>Microsoft-Schlüssel <%= msSecretDays < 0 ? 'ist abgelaufen' : msSecretDays === 0 ? 'läuft heute ab' : `läuft in ${msSecretDays} Tagen ab` %>.</strong> <%= msSecretDays < 0 ? 'Die Anmeldung mit Microsoft funktioniert nicht mehr.' : 'Danach funktioniert die Anmeldung mit Microsoft nicht mehr.' %> Neuen Schlüssel erstellen: <a class="link" href="/handbuch#20-microsoft-anmeldung">Handbuch, Kapitel 20</a>.</div><% } %>
<%
  const todoShown = todos.slice(0, 6);
  const todoMore = todos.slice(6);
  const nextLine = kpis.next ? `${kpis.next.name} ${h.fmtDaysUntil(kpis.next.date_from < h.today() ? h.today() : kpis.next.date_from)}` : 'kein Einsatz geplant';
%>
<div class="card mb todo-card" data-live-region="kpis">
  <div class="card-head">
    <h2>Zu tun <span class="hint"><%= todos.length ? h.plural(todos.length, 'Punkt', 'Punkte') : 'nichts offen' %></span></h2>
    <span class="small muted todo-next">Nächster Einsatz: <% if (kpis.next) { %><a class="link" href="/einsaetze/<%= kpis.next.id %>"><%= nextLine %></a><% } else { %><%= nextLine %><% } %></span>
  </div>
  <% if (!todos.length) { %><div class="empty">Alles erledigt. <%= kpis.neuSeit ? `${h.plural(kpis.neuSeit, 'Anmeldung', 'Anmeldungen')} in den letzten 24 Stunden.` : '' %></div><% } %>
  <% if (todos.length) { %>
    <div class="todo-grid">
      <% for (const t of todoShown) { %><a class="todo" href="<%= t.href %>"><span class="tag tag-<%= t.tone %>"><%= t.tag %></span><span><%= t.text %></span></a><% } %>
    </div>
    <% if (todoMore.length) { %>
      <details class="todo-more">
        <summary><%= h.plural(todoMore.length, 'weiterer Punkt', 'weitere Punkte') %> anzeigen</summary>
        <div class="todo-grid"><% for (const t of todoMore) { %><a class="todo" href="<%= t.href %>"><span class="tag tag-<%= t.tone %>"><%= t.tag %></span><span><%= t.text %></span></a><% } %></div>
      </details>
    <% } %>
  <% } %>
</div>

<div class="grid grid-main">
  <div class="stack">
    <div class="card" id="unbestaetigt">
      <div class="card-head">
        <h2>Noch nicht bestätigt <span class="hint"><%= unconfirmed.length %> Anmeldung<%= unconfirmed.length === 1 ? '' : 'en' %> für anstehende Einsätze</span></h2>
      </div>
      <div class="table-wrap">
        <table>
          <thead><tr><th>Person</th><th>Schicht</th><th>Eingang</th><th>Status</th><th class="actions-col"></th></tr></thead>
          <tbody>
          <% if (!unconfirmed.length) { %><tr><td colspan="5" class="empty">Alle Anmeldungen sind bestätigt.</td></tr><% } %>
          <% let lastEv = null; for (const r of unconfirmed) { %>
            <% if (r.event_id !== lastEv) { lastEv = r.event_id; const grp = unconfirmed.filter((x) => x.event_id === r.event_id); const neuIds = grp.filter((x) => x.status === 'neu').map((x) => x.id); %>
              <tr class="group-row" data-row-id="ug<%= r.event_id %>-<%= grp.length %>"><td colspan="5">
                <div class="row-between">
                  <span><a href="/einsaetze/<%= r.event_id %>/anmeldungen"><strong><%= r.event_name %></strong></a> <span class="muted">· <%= h.fmtRange(r.event_date, r.event_date_to, 'wd') || 'Datum offen' %><%= r.event_status === 'entwurf' ? ' · Entwurf' : '' %> · <%= grp.length %></span></span>
                  <% if (neuIds.length > 1) { %>
                    <form method="post" action="/einsaetze/<%= r.event_id %>/anmeldungen/sammel" class="inline" data-confirm="<%= neuIds.length %> neue Anmeldungen für «<%= r.event_name %>» bestätigen?">
                      <input type="hidden" name="_csrf" value="<%= csrfToken %>"><input type="hidden" name="back" value="/">
                      <% for (const id of neuIds) { %><input type="hidden" name="ids" value="<%= id %>"><% } %>
                      <button class="btn btn-xs" type="submit" name="status_button" value="bestaetigt">Alle <%= neuIds.length %> neuen bestätigen</button>
                    </form>
                  <% } %>
                </div>
              </td></tr>
            <% } %>
            <tr data-row-id="u<%= r.id %>-<%= r.status %>"<% if (r.remark || r.internal_note) { %> class="has-notes"<% } %>>
              <td><%- h.rank(r.rank_short) %><a class="nowrap" href="/personen/<%= r.person_id %>"><strong><%= r.first_name %> <%= r.last_name %></strong></a></td>
              <td><%= r.shifts || '' %><% if (!r.shifts) { %><span class="muted">–</span><% } %></td>
              <td class="nowrap"><%= h.labels.SOURCE[r.source] %><span class="sub"><%= h.fmtRelative(r.registered_at) %></span></td>
              <td><%- h.regBadge(r.status) %></td>
              <td class="actions-col right nowrap">
                <form method="post" action="/anmeldungen/<%= r.id %>/status" class="inline"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><input type="hidden" name="status" value="bestaetigt"><input type="hidden" name="expected" value="<%= r.status %>"><input type="hidden" name="back" value="/"><button class="btn btn-sm" type="submit">Bestätigen</button></form>
              </td>
            </tr>
            <% if (r.remark || r.internal_note) { %>
            <tr class="note-row" data-row-id="n<%= r.id %>"><td colspan="5"><div class="notes">
              <% if (r.remark) { %><div class="note"><span class="note-k">Bemerkung</span><span><%= r.remark %></span></div><% } %>
              <% if (r.internal_note) { %><div class="note note-intern"><span class="note-k">Interne Bemerkung</span><span><%= r.internal_note %></span></div><% } %>
            </div></td></tr>
            <% } %>
          <% } %>
          </tbody>
        </table>
      </div>
    </div>
    <div class="card">
      <div class="card-head">
        <h2>Anstehende Einsätze <span class="hint">nächste 3 Monate</span></h2>
        <a class="small" href="/einsaetze">Alle Einsätze →</a>
      </div>
      <div class="table-wrap">
        <table>
          <thead><tr><th>Einsatz</th><th>Besetzung (Ist / Soll)</th><th class="center">Neu</th><th class="center">Unsicher</th><th class="center">Offen</th></tr></thead>
          <tbody>
          <% if (!rows.length) { %><tr><td colspan="5" class="empty">Keine anstehenden Einsätze. <a class="link" href="/einsaetze/neu">Neuen Einsatz anlegen</a></td></tr><% } %>
          <% for (const e of rows) { %>
            <tr data-row-id="ev<%= e.id %>">
              <td>
                <a href="/einsaetze/<%= e.id %>"><strong><%= e.name %></strong></a>
                <span class="sub"><%= h.fmtEventDate(e, 'wd') %> · <%= h.plural(e.shifts.length, 'Schicht', 'Schichten') %></span>
                <div class="mt-s"><%- h.eventState(e) %></div>
              </td>
              <td>
                <% if (e.status === 'entwurf') { %><span class="muted small">noch nicht veröffentlicht</span><% } else { %>
                  <% for (const s of e.stats.shifts) { %>
                    <div class="occ">
                      <div class="occ-head"><span><%= s.name %></span><strong><%= s.ist %> / <%= s.soll ?? '–' %></strong></div>
                      <div class="bar <%= s.tone %>"><span style="width:<%= h.pct(s.ist, s.soll) %>%"></span></div>
                    </div>
                  <% } %>
                <% } %>
              </td>
              <td class="center"><%= e.status === 'entwurf' ? '–' : e.stats.neu %></td>
              <td class="center"><% if (e.stats.zuPruefen) { %><%- h.badge(e.stats.zuPruefen, 'yellow') %><% } else { %>–<% } %></td>
              <td class="center"><%= e.status === 'entwurf' ? '–' : e.stats.offen %></td>
            </tr>
          <% } %>
          </tbody>
        </table>
      </div>
    </div>
  </div>

  <div class="stack">
    <div class="card">
      <div class="card-head"><h2>Letzte Aktivität</h2></div>
      <% if (!activity.length) { %><div class="empty">Noch keine Aktivität.</div><% } %>
      <% for (const a of activity.slice(0, 8)) { %>
        <div class="activity" data-row-id="a<%= a.id %>"><time><%= h.fmtRelative(a.created_at) %></time> <%= a.summary %></div>
      <% } %>
      <% if (activity.length > 8) { %>
        <details class="activity-more">
          <summary>Ältere anzeigen</summary>
          <% for (const a of activity.slice(8)) { %><div class="activity" data-row-id="a<%= a.id %>"><time><%= h.fmtRelative(a.created_at) %></time> <%= a.summary %></div><% } %>
        </details>
      <% } %>
    </div>
  </div>
</div>
<%- include('../partials/foot') %>
