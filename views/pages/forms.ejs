<%- include('../partials/head') %>
<%- include('../partials/topbar', {
  crumbs: [['Formulare']], heading: 'Anmeldeformular',
  actions: `<a class="btn" href="/forms/anmeldung?vorschau=1" target="_blank" rel="noopener">Vorschau</a><a class="btn" href="${h.escapeHtml(h.withQuery('/formulare', query, { format: 'xlsx' }))}">Excel</a>`,
}) %>
<div class="grid grid-4 mb">
  <div class="card kpi"><div class="label">Offene Einsätze im Formular</div><div class="value"><%= openEvents.length %></div><div class="sub"><%= openEvents.map((e) => e.name).join(', ') || 'keine' %></div></div>
  <a class="card kpi" href="/formulare"><div class="label">Absendungen gesamt</div><div class="value"><%= Object.values(counts).reduce((a, b) => a + b, 0) %></div><div class="sub"><%= counts.verarbeitet || 0 %> verarbeitet</div></a>
  <a class="card kpi" href="/formulare?status=spam"><div class="label">Spamverdacht</div><div class="value"><%= counts.spam || 0 %></div><div class="sub">nicht verarbeitet</div></a>
  <a class="card kpi" href="/formulare?status=fehler"><div class="label">Fehler</div><div class="value <%= counts.fehler ? 'orange' : '' %>"><%= counts.fehler || 0 %></div><div class="sub">bitte prüfen</div></a>
</div>
<div class="grid grid-main">
  <div class="card">
    <div class="card-head">
      <h2>Formular-Eingang <span class="hint">jede Absendung unverändert gespeichert</span></h2>
      <div class="chips">
        <a class="chip badge-gray <%= !status ? 'active' : '' %>" href="/formulare">Alle</a>
        <% for (const [k, v] of Object.entries(h.labels.SUBMISSION_STATUS)) { %><a class="chip badge-<%= v.tone %> <%= status === k ? 'active' : '' %>" href="/formulare?status=<%= k %>"><%= v.label %> · <%= counts[k] || 0 %></a><% } %>
      </div>
    </div>
    <div class="table-wrap">
      <table>
        <thead><tr><th>Eingang</th><th>Name</th><th>Antworten</th><th>Status</th><th></th></tr></thead>
        <tbody>
        <% if (!list.length) { %><tr><td colspan="5" class="empty">Keine Absendungen.</td></tr><% } %>
        <% for (const s of list) { %>
          <tr data-row-id="f<%= s.id %>-<%= s.status %>">
            <td class="nowrap">#<%= s.id %> · <%= h.fmtRelative(s.received_at) %></td>
            <td><strong><%= s.first_name %> <%= s.last_name %></strong></td>
            <td class="small"><% for (const a of s.data.answers || []) { %><div><%= a.event_name || `Einsatz ${a.event_id}` %>: <%= a.answer === 'nein' ? 'Nein' : (a.shifts.length ? a.shifts.map((x) => x.name).join(', ') : 'Ja') %><%= a.remark ? ` · «${a.remark}»` : '' %></div><% } %></td>
            <td><%- h.badge(h.labels.SUBMISSION_STATUS[s.status].label, h.labels.SUBMISSION_STATUS[s.status].tone) %><% if (s.error || s.spam_reason) { %><span class="sub"><%= s.error || s.spam_reason %></span><% } %></td>
            <td class="right nowrap">
              <% if (s.status !== 'verarbeitet') { %>
                <form method="post" action="/formulare/<%= s.id %>/verarbeiten" class="inline"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><button class="btn btn-xs" type="submit"><%= s.status === 'spam' ? 'Doch verarbeiten' : 'Erneut verarbeiten' %></button></form>
                <% if (s.status !== 'spam') { %><form method="post" action="/formulare/<%= s.id %>/spam" class="inline"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><button class="btn btn-xs btn-ghost" type="submit">Spam</button></form><% } %>
              <% } %>
            </td>
          </tr>
        <% } %>
        </tbody>
      </table>
    </div>
  </div>
  <div class="stack">
    <div class="card">
      <div class="card-head"><h2>Einbettung in ClubDesk</h2></div>
      <div class="card-body small">
        <p>Feste Adresse – ändert sich nie:</p>
        <input type="text" readonly value="<%= formUrl %>" data-select-on-focus>
        <p class="mt-s">Einmalig im ClubDesk-Baustein «Externe Inhalte» einbetten. Falls die Darstellung auf dem Handy nicht passt, genügt ein einfacher Link «Zur Anmeldung».</p>
        <p class="muted">Einbettung erlaubt für: <code><%= frameAncestors %></code> (Umgebungsvariable FORM_FRAME_ANCESTORS)</p>
      </div>
    </div>
    <div class="card">
      <div class="card-head"><h2>Postausgang <span class="hint">Anmeldebestätigungen</span></h2></div>
      <% if (!outbox.length) { %><div class="empty">Noch keine E-Mails.</div><% } %>
      <% for (const m of outbox) { %>
        <div class="activity"><time><%= h.fmtRelative(m.created_at) %></time> <%= m.to_address %> · <%= m.subject %>
          <span class="sub"><%- h.badge({ gesendet: 'gesendet', fehler: 'Fehler', offen: 'offen', nicht_konfiguriert: 'kein SMTP konfiguriert' }[m.status], { gesendet: 'green', fehler: 'red', offen: 'blue', nicht_konfiguriert: 'gray' }[m.status]) %> <%= m.error || '' %></span></div>
      <% } %>
    </div>
  </div>
</div>
<%- include('../partials/foot') %>
