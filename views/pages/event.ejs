<%- include('../partials/head') %>
<%
  const e = event;
  const inFormNow = typeof inForm !== 'undefined' ? inForm : null;
  const badgesHtml = h.eventState(inFormNow === null ? e : { ...e, inForm: inFormNow });
  const leader = e.leader_person_id ? `${e.leader_rank ? `<span class="rank">${h.escapeHtml(e.leader_rank)}</span>` : ''}${h.escapeHtml(e.leader_first + ' ' + e.leader_last)}` : '–';
  const sub = `<strong>${h.fmtEventDate(e, 'wd')}</strong><span>Antreten ${h.escapeHtml(e.start_time || '–')}${e.start_place ? ' · ' + h.escapeHtml(e.start_place) : ''}</span><span>Leitung ${leader}</span>`;
  const exportTabs = { anmeldungen: 1, anfragen: 1, verlauf: 1 };
  const base = `/einsaetze/${e.id}`;
  // Kopf: Teilnehmerliste (Hauptknopf), Bearbeiten, «Mehr ▾» mit allem Weiteren
  const menuSep = '<div class="sep"></div>';
  const menuHead = (t) => `<div class="menu-head">${t}</div>`;
  let calItems;
  if (e.shifts.length > 1) {
    calItems = menuHead('Kalendertermin')
      + `<a href="${base}/kalender?scope=event">Ein Termin für den ganzen Einsatz</a><a href="${base}/kalender?scope=shifts">Ein Termin pro Schicht</a>`
      + e.shifts.map((s) => `<a href="${base}/kalender?scope=shift&shift=${s.id}">Nur ${h.escapeHtml(s.name)}</a>`).join('');
  } else calItems = `<a href="${base}/kalender">Kalendertermin (.ics)</a>`;
  const expItems = exportTabs[tab]
    ? menuSep + menuHead('Diese Ansicht') + `<a href="${h.escapeHtml(h.withQuery(`${base}/${tab}`, query, { format: 'xlsx' }))}">Als Excel (.xlsx)</a><a href="${h.escapeHtml(h.withQuery(`${base}/${tab}`, query, { format: 'csv' }))}">Als CSV</a>`
    : '';
  const multi = e.shifts.length > 1;
  const pdfLink = (path, label) => `<a href="${base}/${path}" target="_blank" rel="noopener">${label}</a>`;
  const tnItems = menuSep + menuHead('Teilnehmerliste')
    + (multi ? pdfLink('teilnehmerliste?format=pdf&amp;schicht=alle', 'Pro Schicht (PDF)') : '')
    + `<a href="${base}/teilnehmerliste?format=xlsx">Als Excel</a><a href="${base}/teilnehmerliste?format=csv">Als CSV</a><a href="${base}/teilnehmerliste">Auswahl anpassen …</a>`;
  const mealItems = menuSep + menuHead('Verpflegungsliste')
    + pdfLink('verpflegungsliste?format=pdf', multi ? 'Ganzer Einsatz (PDF)' : 'Als PDF')
    + (multi ? pdfLink('verpflegungsliste?format=pdf&amp;schicht=alle', 'Pro Schicht (PDF)') : '')
    + `<a href="${base}/verpflegungsliste">Ansehen und auswählen …</a>`;
  const more = `<details class="menu"><summary class="btn">Mehr ▾</summary><div class="menu-list">${calItems}${expItems}${tnItems}${mealItems}${menuSep}<button type="button" data-print>Drucken</button></div></details>`;
  const headActions = `<a class="btn btn-primary" href="${base}/teilnehmerliste?format=pdf" target="_blank" rel="noopener" title="Teilnehmerliste als PDF in einem neuen Tab öffnen">Teilnehmerliste</a><a class="btn" href="${base}/bearbeiten">Bearbeiten</a>${more}`;
  const tabs = [['uebersicht', 'Übersicht', ''], ['anmeldungen', 'Anmeldungen', tabCounts.registrations], ['anfragen', 'Anfragen', tabCounts.inquiries], ['schichten', 'Schichten', ''], ['formular', 'Formular', ''], ['verlauf', 'Verlauf', '']];
%>
<%- include('../partials/topbar', {
  crumbs: [['Einsätze', '/einsaetze'], [e.name]], heading: e.name, badges: badgesHtml, subline: sub, showSearch: false,
  actions: headActions,
}) %>
<% if (e.status === 'abgeschlossen') { %><div class="callout warn mb">Dieser Einsatz ist abgeschlossen. Die Daten sind schreibgeschützt; Änderungen nur noch durch einen Admin mit Begründung.</div><% } %>
<% if (e.status === 'abgesagt') { %><div class="callout warn mb">Dieser Einsatz wurde abgesagt. Alle Daten bleiben erhalten.</div><% } %>
<nav class="tabs">
  <% for (const [key, label, n] of tabs) { %>
    <a href="<%= key === 'uebersicht' ? base : `${base}/${key}` %>" class="<%= tab === key ? 'active' : '' %>"><%= label %><% if (n) { %> <span class="n"><%= n %></span><% } %></a>
  <% } %>
</nav>
<%- include(`../event/${tab}`) %>
<%- include('../partials/foot') %>
