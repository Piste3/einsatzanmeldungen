<%- include('../partials/head') %>
<%- include('../partials/topbar', { crumbs: [['Suche']], heading: q ? `Suche: «${q}»` : 'Suche' }) %>
<form method="get" action="/suche" class="filters"><input type="search" name="q" value="<%= q %>" placeholder="Personen, Einsätze, Anmeldungen …" autofocus style="min-width:320px"><button class="btn btn-sm" type="submit">Suchen</button></form>
<% if (q.length < 2) { %><p class="muted">Mindestens zwei Zeichen eingeben.</p><% } else { %>
<div class="grid grid-3">
  <div class="card"><div class="card-head"><h2>Personen <span class="hint"><%= people.length %></span></h2></div>
    <% for (const p of people) { %><a class="todo" href="/personen/<%= p.id %>"><span><%- h.rank(p.rank_short) %><strong><%= p.first_name %> <%= p.last_name %></strong> <% if (p.status !== 'aktiv') { %><%- h.badge(p.status, 'gray') %><% } %></span></a><% } %>
    <% if (!people.length) { %><div class="empty">Keine Treffer.</div><% } %></div>
  <div class="card"><div class="card-head"><h2>Einsätze <span class="hint"><%= evts.length %></span></h2></div>
    <% for (const e of evts) { %><a class="todo" href="/einsaetze/<%= e.id %>"><span><strong><%= e.name %></strong><span class="cell-sub"><%= h.fmtDateWd(e.date) %> · <%= h.labels.EVENT_STATUS[e.status].label %></span></span></a><% } %>
    <% if (!evts.length) { %><div class="empty">Keine Treffer.</div><% } %></div>
  <div class="card"><div class="card-head"><h2>Anmeldungen <span class="hint"><%= regs.length %></span></h2></div>
    <% for (const r of regs) { %><a class="todo" href="<%= r.person_id ? `/einsaetze/${r.event_id}/anmeldungen` : `/klaerungen?id=${r.id}` %>"><span><strong><%= r.person_id ? `${r.first_name} ${r.last_name}` : `«${r.entered_first_name} ${r.entered_last_name}»` %></strong><span class="cell-sub"><%= r.event_name %> · <%= h.labels.REG_STATUS[r.status].label %></span></span></a><% } %>
    <% if (!regs.length) { %><div class="empty">Keine Treffer.</div><% } %></div>
</div>
<% } %>
<%- include('../partials/foot') %>
