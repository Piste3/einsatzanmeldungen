<%- include('../partials/head') %>
<%- include('../partials/topbar', {
  crumbs: [['Rückmeldungen']], heading: 'Wer hat sich wofür gemeldet?',
  actions: `<button class="btn" type="button" data-print>Drucken</button><a class="btn" href="${h.escapeHtml(h.withQuery('/rueckmeldungen', query, { format: 'xlsx' }))}">Excel</a><a class="btn" href="${h.escapeHtml(h.withQuery('/rueckmeldungen', query, { format: 'csv' }))}">CSV</a>`,
}) %>
<%
  const SYM = { an: '✓', ab: '✕', unsicher: '?', offen: '', andere: '·', schicht_offen: '✓' };
  // eigenes Icon für den genaueren Stand (z. B. Nachricht gesendet, bestätigt)
  const DSYM = { bestaetigt: '✓', warteliste: h.icon('clock', 'fb-ico'), whatsapp: h.icon('chat', 'fb-ico'), telefon: h.icon('phone', 'fb-ico'), muendlich: h.icon('voice', 'fb-ico'), rueckfrage: '!', ueberschneidung: '–', frei: '<span class="fb-ring"></span>' };
  const sym = (c) => (c.detail ? DSYM[c.detail] : h.escapeHtml(SYM[c.state]));
  const stateLabel = (c) => (c.detail ? h.labels.FEEDBACK_DETAIL[c.detail].label : h.labels.FEEDBACK[c.state].label);
  // wer den Stand gesetzt hat und wann (letzter Historie-Eintrag)
  const setBy = (c) => (c.last ? `${c.last.by}, ${c.last.atShort}` : '');
  const cellTitle = (c, col, p) => `${p.first_name} ${p.last_name} · ${col.event.name}${col.shift ? ` · ${col.shift.name}` : ''}: ${stateLabel(c)}${c.last ? `\nZuletzt: ${c.last.text} – ${setBy(c)}${c.last.count > 1 ? ` (${c.last.count} Einträge im Verlauf)` : ''}` : ''}\nKlicken für Verlauf und Kontaktversuch`;
  // aktueller Stand für das Kontaktversuch-Fenster
  const currentText = (c, col) => {
    if (c.state === 'offen' && !c.inq) return '';
    const parts = [stateLabel(c)];
    if (c.reg) parts.push(`Anmeldung: ${h.labels.REG_STATUS[c.reg.status].short} · ${h.labels.SOURCE[c.reg.source]}`);
    if (c.inq) parts.push(`Anfrage: ${(h.labels.INQUIRY_ROW[c.inq.status] || h.labels.INQUIRY_STATUS[c.inq.status]).label}`);
    if (c.last) parts.push(`gesetzt von ${setBy(c)}`);
    return parts.join(' · ');
  };
  // Fenster beim längeren Darüberfahren (data-tip): Schichten des Einsatzes mit Tag und Zeit
  const esc = h.escapeHtml;
  const shiftWhen = (sh, e) => h.fmtShiftWhen(sh, h.isMultiDay(e)) || 'Zeit fehlt';
  const shiftList = (e, { here = null, mine = null } = {}) => `<ul class="tip-shifts">${e.shifts.map((sh) => {
    const isMine = mine && mine.ids.includes(sh.id);
    const clash = mine && mine.clash.includes(sh.id);
    const tag = isMine ? `<em class="tip-tag tip-mine">${mine.kind}</em>` : clash ? '<em class="tip-tag tip-clash">gleiche Zeit</em>' : '<em class="tip-tag"></em>';
    const ist = e.istByShift[sh.id] || 0;
    return `<li class="${here && here.id === sh.id ? 'is-here' : ''}${isMine ? ' is-mine' : ''}${clash ? ' is-clash' : ''}"><span class="tip-sh">${esc(sh.name)}</span><span class="tip-when">${esc(shiftWhen(sh, e))}</span><span class="tip-num">${ist}${sh.target_count ? ` / ${sh.target_count}` : ''}</span>${tag}</li>`;
  }).join('')}</ul>`;
  const headTip = (col) => `<strong>${esc(col.event.name)}</strong><span class="tip-sub">${esc(h.fmtEventDate(col.event, 'short'))}</span>${col.shift ? shiftList(col.event, { here: col.shift }) : ''}`;
  const cellTip = (c, col, p) => {
    let out = `<strong>${esc(`${p.first_name} ${p.last_name}`)}</strong><span class="tip-sub">${esc(col.event.name)}${col.shift ? ` · ${esc(col.shift.name)}` : ''}</span><span class="tip-state">${esc(stateLabel(c))}</span>`;
    if (col.shift) out += shiftList(col.event, { here: col.shift, mine: c.mine });
    if (c.last) out += `<span class="tip-last">Zuletzt: ${esc(c.last.text)} – ${esc(setBy(c))}${c.last.count > 1 ? ` (${c.last.count} Einträge)` : ''}</span>`;
    return `${out}<span class="tip-hint">Klicken für Verlauf und Kontaktversuch</span>`;
  };
  const shiftTime = (sh) => (sh.starts_at && sh.ends_at ? `${sh.starts_at.slice(11, 16)}–${sh.ends_at.slice(11, 16)}` : '');
  // Kopf: bei Schichten an verschiedenen Tagen steht über jeder Schichtspalte ihr Tag, sonst das Einsatzdatum
  const colDate = (col) => (col.shift && col.shift.starts_at && h.isMultiDay(col.event) ? h.fmtRange(col.shift.starts_at.slice(0, 10), null, 'short') : h.fmtEventDate(col.event, 'short'));
  const colExt = (col) => (col.shift ? col.event.externByShift[col.shift.id] || 0 : 0);
  const colIst = (col) => (col.shift ? col.event.istByShift[col.shift.id] || 0 : col.event.ist);
  const colFill = (col) => (col.shift && col.shift.target_count ? Math.min(100, Math.round(((colIst(col) + colExt(col)) / col.shift.target_count) * 100)) : null);
  const extTxt = (n) => (n ? ` + ${n} ext.` : '');
  const colTone = (col) => { const f = colFill(col); return f === null ? 'gray' : f >= 100 ? 'green' : f >= 60 ? 'yellow' : 'red'; };
  const fill = (e) => (e.soll ? Math.min(100, Math.round(((e.ist + (e.extern || 0)) / e.soll) * 100)) : null);
  const tone = (e) => { const f = fill(e); return f === null ? 'gray' : f >= 100 ? 'green' : f >= 60 ? 'yellow' : 'red'; };
%>
<form class="filters fb-filters" method="get" data-autosubmit>
  <input type="hidden" name="view" value="<%= filters.view %>">
  <input type="search" name="q" value="<%= filters.q %>" placeholder="Name suchen">
  <select name="period"><% for (const [k, p] of Object.entries(periods)) { %><option value="<%= k %>" <%= filters.period === k ? 'selected' : '' %>><%= p.label %></option><% } %></select>
  <select name="team"><option value="">Alle Mannschaften</option><% for (const t of teams) { %><option value="<%= t.id %>" <%= Number(filters.team) === t.id ? 'selected' : '' %>><%= t.name %></option><% } %></select>
  <select name="only">
    <option value="" <%= !filters.only ? 'selected' : '' %>>Alle Mitglieder</option>
    <option value="offen" <%= filters.only === 'offen' ? 'selected' : '' %>>Nur mit offenen Einsätzen</option>
    <option value="unsicher" <%= filters.only === 'unsicher' ? 'selected' : '' %>>Nur mit Unsicheren</option>
  </select>
  <% if (filters.view === 'tabelle') { %>
  <select name="sort" aria-label="Sortierung"><option value="rang" <%= filters.sort === 'rang' ? 'selected' : '' %>>Rang: tief → hoch</option><option value="rang_ab" <%= filters.sort === 'rang_ab' ? 'selected' : '' %>>Rang: hoch → tief</option><option value="name" <%= filters.sort === 'name' ? 'selected' : '' %>>nach Name</option><option value="offen" <%= filters.sort === 'offen' ? 'selected' : '' %>>meiste offen zuerst</option></select>
  <% } else { %><input type="hidden" name="sort" value="<%= filters.sort %>"><% } %>
  <label class="check"><input type="checkbox" name="drafts" value="1" <%= filters.drafts === '1' ? 'checked' : '' %>> Entwürfe</label>
  <% if (filters.period !== '3m' || filters.team || filters.only || filters.sort !== 'rang' || filters.drafts || filters.view !== 'tabelle') { %><a class="btn btn-sm btn-ghost" href="/rueckmeldungen?filter=zuruecksetzen" title="Alle Filter auf den Standard zurücksetzen">Zurücksetzen</a><% } %>
</form>
<div class="row-between mb-s">
  <div class="segmented-links">
    <a class="<%= filters.view === 'tabelle' ? 'active' : '' %>" href="<%= h.withQuery('/rueckmeldungen', query, { view: 'tabelle' }) %>">Tabelle</a>
    <a class="<%= filters.view === 'einsatz' ? 'active' : '' %>" href="<%= h.withQuery('/rueckmeldungen', query, { view: 'einsatz' }) %>">Pro Einsatz</a>
  </div>
  <span class="muted small"><%= events.length %> Einsätze · <%= rows.length %><%= rows.length !== allCount ? ` von ${allCount}` : '' %> Mitglieder</span>
</div>
<div class="legend small fb-legend mb" aria-label="Legende">
  <span class="fb-legend-title">Legende</span>
  <span class="fb-legend-item"><span class="fb fb-an">✓</span> An</span>
  <span class="fb-legend-item"><span class="fb fb-an fb-d-bestaetigt">✓</span> Bestätigt</span>
  <span class="fb-legend-item"><span class="fb fb-an fb-d-warteliste"><%- DSYM.warteliste %></span> Warteliste</span>
  <span class="fb-legend-item"><span class="fb fb-ab">✕</span> Ab</span>
  <span class="fb-legend-item"><span class="fb fb-unsicher fb-d-whatsapp"><%- DSYM.whatsapp %></span> Nachricht gesendet</span>
  <span class="fb-legend-item"><span class="fb fb-unsicher fb-d-telefon"><%- DSYM.telefon %></span> Nicht erreicht</span>
  <span class="fb-legend-item"><span class="fb fb-unsicher fb-d-muendlich"><%- DSYM.muendlich %></span> Mündlich gefragt</span>
  <span class="fb-legend-item"><span class="fb fb-unsicher">?</span> Unsicher</span>
  <span class="fb-legend-item"><span class="fb fb-unsicher fb-d-rueckfrage">!</span> Rückfrage</span>
  <span class="fb-legend-item"><span class="fb fb-offen"></span> Offen</span>
  <% if (columns.some((c) => c.shift)) { %>
  <span class="fb-legend-item"><span class="fb fb-schicht_offen">✓</span> An, ohne Schicht</span>
  <span class="fb-legend-item"><span class="fb fb-andere fb-d-ueberschneidung">–</span> Andere Schicht, gleiche Zeit</span>
  <span class="fb-legend-item"><span class="fb fb-andere fb-d-frei"><%- DSYM.frei %></span> Andere Schicht, zeitlich möglich</span>
  <% if (rows.some((r) => r.cells.some((c) => c.state === 'andere' && !c.detail))) { %><span class="fb-legend-item"><span class="fb fb-andere">·</span> Andere Schicht, Zeit fehlt</span><% } %>
  <% } %>
</div>

<% if (!events.length) { %>
  <div class="card"><div class="empty">Keine veröffentlichten Einsätze im gewählten Zeitraum.</div></div>
<% } else if (filters.view === 'tabelle') { %>
<div class="card fb-table-card">
  <div class="table-wrap fb-wrap" data-keep-scroll>
    <table class="matrix fb-matrix">
      <thead>
        <tr>
          <th class="fb-name">Mitglied</th>
          <% for (const col of columns) { const e = col.event; const t = totals[e.id]; %>
            <th class="fb-ev <%= col.shift ? 'fb-shift' : '' %> <%= col.first ? 'fb-first' : '' %>"<% if (col.shift && col.first) { %> style="--fb-span: <%= e.shifts.length %>"<% } %> aria-label="<%= e.name %> · <%= colDate(col) %><%= col.shift ? ` · ${col.shift.name} ${shiftTime(col.shift)}` : '' %>" data-tip="<%= headTip(col) %>">
              <a href="/einsaetze/<%= e.id %><%= col.shift ? '/schichten' : '' %>">
                <span class="dt"><%= h.fmtEventDate(e, 'short') %></span>
                <span class="ev"><%= e.name %></span>
                <% if (col.shift) { const ct = colTotals[col.key]; %>
                  <span class="sh"><%= col.shift.name %><% if (h.isMultiDay(e) && col.shift.starts_at) { %><span class="sh-day"><%= colDate(col) %></span><% } else if (shiftTime(col.shift)) { %><span class="sh-day"><%= shiftTime(col.shift) %></span><% } %></span>
                  <span class="fill fill-<%= colTone(col) %>"><span style="width:<%= colFill(col) ?? 0 %>%"></span></span>
                  <span class="num"><%= colIst(col) %><%= extTxt(colExt(col)) %><%= col.shift.target_count ? ` / ${col.shift.target_count}` : '' %><%= ct.schicht_offen ? ` · ${ct.schicht_offen} ohne Schicht` : '' %></span>
                <% } else { %>
                  <span class="fill fill-<%= tone(e) %>"><span style="width:<%= fill(e) ?? 0 %>%"></span></span>
                  <span class="num"><%= e.ist %><%= extTxt(e.extern) %><%= e.soll ? ` / ${e.soll}` : '' %></span>
                <% } %>
              </a>
            </th>
          <% } %>
        </tr>
      </thead>
      <tbody>
      <% if (!rows.length) { %><tr><td colspan="<%= columns.length + 1 %>" class="empty">Keine Mitglieder für diesen Filter.</td></tr><% } %>
      <% for (const row of rows) { const p = row.person; %>
        <tr data-row-id="p<%= p.id %>-<%= row.cells.map((c) => c.state[0]).join('') %>">
          <td class="fb-name"><%- h.rank(p.rank_short) %><a href="/personen/<%= p.id %>"><strong><%= p.first_name %> <%= p.last_name %></strong></a><% if (p.teams) { %><span class="sub"><%= p.teams %></span><% } %></td>
          <% row.cells.forEach((c, i) => { const col = columns[i]; const e = col.event; %>
            <td class="fb-cell <%= col.first ? 'fb-first' : '' %>">
              <button type="button" class="fb fb-<%= c.state %><%= c.detail ? ` fb-d-${c.detail}` : '' %>" data-open-dialog="attempt" data-person="<%= p.id %>" data-event="<%= c.eventId %>" data-shift="<%= c.shiftId || '' %>" data-who="<%= `${p.first_name} ${p.last_name} · ${e.name}${col.shift ? ` · ${col.shift.name}` : ''}` %>" data-current="<%= currentText(c, col) %>"<% if (c.reg) { %> data-current-link="/einsaetze/<%= c.eventId %>/<%= ['andere', 'schicht_offen'].includes(c.state) ? 'schichten' : `anmeldungen?q=${encodeURIComponent(p.last_name)}` %>"<% } %> aria-label="<%= cellTitle(c, col, p) %>" data-tip="<%= cellTip(c, col, p) %>"><%- sym(c) %></button>
            </td>
          <% }) %>
        </tr>
      <% } %>
      </tbody>
      <tfoot>
        <tr>
          <td class="fb-name">Total (<%= allCount %> Mitglieder)</td>
          <% for (const col of columns) { const t = colTotals[col.key]; %>
            <td class="fb-tot <%= col.first ? 'fb-first' : '' %>" title="<%= t.an %> An<%= col.shift ? ` (${col.shift.name})` : '' %><%= t.schicht_offen ? ` · ${t.schicht_offen} An ohne Schicht` : '' %><%= t.andere ? ` · ${t.andere} andere Schicht` : '' %> · <%= t.ab %> Ab · <%= t.unsicher %> Unsicher · <%= t.offen %> Offen"><span class="g"><%= t.an %></span> <span class="r"><%= t.ab %></span> <span class="y"><%= t.unsicher %></span> <span class="m"><%= t.offen %></span></td>
          <% } %>
        </tr>
      </tfoot>
    </table>
  </div>
</div>
<% } else { %>
<div class="fb-cards" data-keep-scroll>
  <% events.forEach((e, i) => {
    const groups = { an: [], unsicher: [], ab: [], offen: [] };
    for (const row of rows) groups[row.eventCells[i].state].push({ ...row.person, last: row.eventCells[i].last });
    const t = totals[e.id];
    // Bei mehreren Schichten: wer für welche Schicht
    const perShift = e.shifts.map((sh) => ({ sh, list: rows.filter((row) => row.cells.some((c) => c.eventId === e.id && c.shiftId === sh.id && c.counts)).map((row) => row.person) }));
    const noShift = e.shifts.length ? rows.filter((row) => row.cells.some((c) => c.eventId === e.id && c.state === 'schicht_offen')).map((row) => row.person) : [];
    // Warteliste zählt nicht zur Besetzung, steht aber sichtbar unter den Schichten
    const waiting = e.shifts.length ? rows.filter((row) => row.eventCells[i].reg?.status === 'warteliste').map((row) => row.person) : [];
  %>
  <div class="card fb-card">
    <div class="card-head">
      <h2><a href="/einsaetze/<%= e.id %>"><%= e.name %></a> <span class="hint"><%= h.fmtEventDate(e, 'short') %><%= e.status === 'entwurf' ? ' · Entwurf' : '' %></span></h2>
      <span class="num"><strong><%= e.ist %></strong><%= extTxt(e.extern) %><%= e.soll ? ` / ${e.soll}` : '' %> besetzt</span>
    </div>
    <div class="card-body">
      <span class="fill fill-<%= tone(e) %> fill-wide"><span style="width:<%= fill(e) ?? 0 %>%"></span></span>
      <% if (perShift.length) { %>
        <div class="fb-shifts">
          <% for (const { sh, list } of perShift) { %>
            <div class="fb-shift-row"><span class="sh-name"><%= sh.name %> <span class="muted small"><%= h.fmtShiftWhen(sh, h.isMultiDay(e)) %></span></span><span class="num"><strong><%= e.istByShift[sh.id] || 0 %></strong><%= extTxt(e.externByShift[sh.id]) %><%= sh.target_count ? ` / ${sh.target_count}` : '' %></span></div>
            <div class="fb-names"><% for (const p of list) { %><a class="pill" href="/personen/<%= p.id %>"><%= p.first_name %> <%= p.last_name %></a><% } %><% if (!list.length) { %><span class="muted small">noch niemand</span><% } %></div>
          <% } %>
          <% if (noShift.length) { %><div class="fb-shift-row"><span class="sh-name">An, ohne Schicht</span><a class="link small" href="/einsaetze/<%= e.id %>/schichten">zuteilen →</a></div>
            <div class="fb-names"><% for (const p of noShift) { %><a class="pill" href="/personen/<%= p.id %>"><%= p.first_name %> <%= p.last_name %></a><% } %></div><% } %>
          <% if (waiting.length) { %><div class="fb-shift-row"><span class="sh-name">Warteliste <span class="muted small">zählt nicht</span></span></div>
            <div class="fb-names"><% for (const p of waiting) { %><a class="pill" href="/personen/<%= p.id %>"><%= p.first_name %> <%= p.last_name %></a><% } %></div><% } %>
        </div>
      <% } %>
      <% for (const [st, list] of Object.entries(groups)) { if (!list.length || (st === 'an' && perShift.length)) continue; const many = st === 'offen' && list.length > 8; %>
        <details class="fb-group" <%= many ? '' : 'open' %>>
          <summary><span class="fb fb-<%= st %>"><%= SYM[st] %></span> <%= h.labels.FEEDBACK[st].label %> <span class="muted">· <%= list.length %></span></summary>
          <div class="fb-names">
            <% for (const p of list) { %>
              <% if (st === 'offen') { %><button type="button" class="pill" data-open-dialog="attempt" data-person="<%= p.id %>" data-event="<%= e.id %>" data-who="<%= `${p.first_name} ${p.last_name} · ${e.name}` %>" title="<%= p.last ? `Zuletzt: ${p.last.text} – ${setBy(p)} · ` : '' %>Klicken für Verlauf und Kontaktversuch"><%= p.first_name %> <%= p.last_name %></button>
              <% } else { %><a class="pill" href="/personen/<%= p.id %>"<% if (p.last) { %> title="<%= `${p.last.text} – ${setBy(p)}` %>"<% } %>><%= p.first_name %> <%= p.last_name %></a><% } %>
            <% } %>
          </div>
        </details>
      <% } %>
      <% if (!rows.length) { %><div class="muted small">Keine Mitglieder für diesen Filter.</div><% } %>
    </div>
  </div>
  <% }) %>
</div>
<% } %>
<%- include('../partials/attempt-dialog', { action: '/anfragen/versuch', back: h.withQuery('/rueckmeldungen', query), eventChoice: true }) %>
<%- include('../partials/foot') %>
