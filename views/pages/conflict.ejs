<%- include('../partials/head') %>
<%- include('../partials/topbar', { crumbs: [['Gleichzeitige Änderung']], heading: 'Gleichzeitige Änderung', showSearch: false }) %>
<div class="callout warn mb">
  <strong class="cap">Achtung</strong>
  Dieser Datensatz wurde soeben von <strong><%= who %></strong> geändert<%= when ? ` (${h.fmtRelative(when)})` : '' %>.<% if (summary) { %><br><span class="small"><%= summary %></span><% } %>
  <br>Deine Änderung wurde nicht gespeichert, damit nichts still überschrieben wird. Bitte entscheide:
</div>
<div class="card mb">
  <div class="table-wrap">
    <table>
      <thead><tr><th>Feld</th><th>Aktueller Stand (gespeichert)</th><th>Deine Änderung</th></tr></thead>
      <tbody>
      <% if (!rows.length) { %><tr><td colspan="3" class="empty">Keine inhaltlichen Unterschiede in den Feldern.</td></tr><% } %>
      <% for (const r of rows) { %><tr><td><strong><%= r.label %></strong></td><td class="pre"><%= r.theirs || '–' %></td><td class="pre"><%= r.mine || '–' %></td></tr><% } %>
      </tbody>
    </table>
  </div>
</div>
<div class="row">
  <a class="btn" href="<%= editUrl %>">Aktuellen Stand übernehmen und weiterbearbeiten</a>
  <form method="post" action="<%= action %>" class="inline">
    <input type="hidden" name="_csrf" value="<%= csrfToken %>">
    <% for (const [k, v] of Object.entries(mine)) { if (k === '_csrf' || k === 'version') continue; for (const val of [].concat(v)) { %><input type="hidden" name="<%= k %>" value="<%= val %>"><% } } %>
    <input type="hidden" name="version" value="<%= version %>">
    <button class="btn btn-primary" type="submit">Eigene Änderung erneut anwenden</button>
  </form>
  <a class="btn btn-ghost" href="<%= backUrl %>">Verwerfen</a>
</div>
<%- include('../partials/foot') %>
