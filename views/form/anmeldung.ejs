<!doctype html>
<html lang="de-CH">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <meta name="robots" content="noindex">
  <title><%= title %> · <%= verein %></title>
  <link rel="stylesheet" href="/static/css/form.css?v=<%= v %>">
</head>
<body>
<header class="f-header"><span class="logo">KKB</span><div><div class="f-title"><%= title %></div><div class="f-sub"><%= verein %></div></div></header>
<main class="f-main">
  <% if (preview) { %><div class="f-note">Vorschau – Absenden ist hier deaktiviert. <%= form.events.some((e) => e.status === 'entwurf') ? 'Entwürfe sind nur in der Vorschau sichtbar.' : '' %></div><% } %>
  <% if (errors.length) { %><div class="f-error" role="alert"><% for (const err of errors) { %><div><%= err %></div><% } %></div><% } %>
  <% if (!form.events.length) { %>
    <div class="f-card f-empty">Zurzeit sind keine Einsätze zur Anmeldung offen.</div>
  <% } else { %>
  <form method="post" action="/forms/anmeldung" data-member-form novalidate>
    <input type="hidden" name="submission_uid" value="<%= form.uid %>">
    <div class="hp" aria-hidden="true"><label>Website <input type="text" name="website" tabindex="-1" autocomplete="off"></label></div>
    <% if (intro) { %><div class="f-card f-intro"><%= intro %></div><% } %>
    <fieldset class="f-card">
      <legend class="f-q">Wer bist du?</legend>
      <div class="two">
        <label>Vorname<input type="text" name="first_name" value="<%= values.first_name || '' %>" required autocomplete="given-name" maxlength="80"></label>
        <label>Nachname<input type="text" name="last_name" value="<%= values.last_name || '' %>" required autocomplete="family-name" maxlength="80"></label>
      </div>
    </fieldset>
    <% for (const e of form.events) { %>
      <%- include('_event-block', { e, values, disabled: preview }) %>
    <% } %>
    <p class="f-hint">Kreuze nur an, wo du dabei bist – alles andere bleibt einfach leer. Du kannst dich in einem Durchgang für mehrere Einsätze anmelden.</p>
    <button class="f-submit" type="submit" <%= preview ? 'disabled' : '' %>>Anmeldung absenden</button>
  </form>
  <% } %>
</main>
<script src="/static/js/form.js?v=<%= v %>"></script>
</body>
</html>
