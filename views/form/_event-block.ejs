<%
  const multi = e.openShifts.length > 1;
  const ans = values[`answer_${e.id}`];
  const chosen = [].concat(values[`shifts_${e.id}`] || []).map(Number);
  const join = (...p) => p.filter(Boolean).join(' ');
  const antreten = (e.start_time || e.start_place) ? join('Antreten', e.start_time, e.start_place) : '';
  // Leerer Abtretensort = gleich wie Antreten
  const endPlace = e.end_place || e.start_place;
  const abtreten = (e.end_time || endPlace) ? join('Abtreten', e.end_time, endPlace) : '';
  const meta = [['antreten', antreten], ['abtreten', abtreten], ['tenue', e.tenue ? `Tenue ${e.tenue.split('\n')[0]}` : '']].filter(([, t]) => t);
%>
<fieldset class="ev-block<%= (ans || chosen.length) ? ' answered' : '' %>" data-event-block>
  <input type="hidden" name="event_ids" value="<%= e.id %>" <%= disabled ? 'disabled' : '' %>>
  <div class="ev-head">
    <legend class="ev-name"><%= e.name %></legend>
    <span class="date-pill"><%= h.fmtEventDate(e, 'short') %></span>
  </div>
  <% for (const [ico, line] of meta) { %><div class="ev-meta"><%- h.icon(ico, 'ev-icon') %><span><%= line %></span></div><% } %>
  <% if (e.description) { %><div class="ev-desc"><%= e.description %></div><% } %>
  <div class="ev-question"><%= questionFor(e) %></div>
  <% if (e.help_text) { %><div class="ev-help"><%= e.help_text %></div><% } %>
  <% if (multi) { %>
    <% for (const s of e.openShifts) { %>
      <label class="opt"><input type="checkbox" name="shifts_<%= e.id %>" value="<%= s.id %>" <%= chosen.includes(s.id) ? 'checked' : '' %> <%= disabled ? 'disabled' : '' %> data-shift-check> <span><%= s.name %></span> <span class="time"><%= h.fmtShiftWhen(s, h.isMultiDay(e)) %></span><% if (s.teamNames) { %> <span class="only">Nur <%= s.teamNames %></span><% } %></label>
    <% } %>
  <% } else { %>
    <% const only = e.openShifts[0]?.teamNames; if (only) { %><div class="ev-only"><span class="only">Nur <%= only %></span></div><% } %>
    <div class="yesno">
      <input type="checkbox" id="y<%= e.id %>" name="answer_<%= e.id %>" value="ja" <%= ans === 'ja' ? 'checked' : '' %> <%= disabled ? 'disabled' : '' %>><label for="y<%= e.id %>">Ja, ich bin dabei</label>
    </div>
  <% } %>
  <input class="remark" type="text" name="remark_<%= e.id %>" value="<%= values[`remark_${e.id}`] || '' %>" placeholder="Bemerkung (optional)" maxlength="500" <%= disabled ? 'disabled' : '' %>>
  <% if (ans || chosen.length) { %><button type="button" class="reset" data-reset-block>Antwort zurücksetzen</button><% } %>
</fieldset>
