<!doctype html>
<html lang="de-CH">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <meta name="robots" content="noindex">
  <title>Danke · <%= verein %></title>
  <link rel="stylesheet" href="/static/css/form.css?v=<%= v %>">
</head>
<body>
<header class="f-header"><span class="logo">KKB</span><div><div class="f-title">Einsatzanmeldung</div><div class="f-sub"><%= verein %></div></div></header>
<main class="f-main f-thanks">
  <div class="check-circle" aria-hidden="true">✓</div>
  <h1>Danke, <%= firstName %>!</h1>
  <p class="muted">Deine Anmeldung ist eingegangen.</p>
  <div class="f-card f-list">
    <% for (const i of items) { %>
      <div class="f-item">
        <div><strong><%= i.name %></strong><div class="muted small"><%= i.date %> · <%= i.detail %></div></div>
        <% if (i.answer === 'nein') { %><span class="pill gray">Abmeldung erfasst</span><% } else { %><span class="pill">noch nicht bestätigt</span><% } %>
      </div>
    <% } %>
  </div>
  <p class="muted small center">Die Aufgebotsstelle prüft deine Anmeldung. Sobald du eingeteilt bist, erhältst du die Bestätigung mit allen Informationen.</p>
  <a class="f-back" href="/forms/anmeldung">Zurück zum Formular</a>
</main>
</body>
</html>
